---
import CreativeHomeBuyerSeal from "./CreativeHomeBuyerSeal.astro";
import { SITE } from "../lib/siteConfig";
import { getSellerStory } from "../data/sellerStories";

type Props = {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  points?: string[];
  storySlug?: string;
  primaryHref?: string;
  primaryLabel?: string;
  trackingLocation?: string;
};

const {
  eyebrow = "ACE Promise",
  heading = "Creative options when a standard cash offer is not enough",
  intro =
    "ACE Properties KC compares cash, payoff-at-closing, and creative payment options when the seller's situation calls for more than a one-size-fits-all answer.",
  points = [
    "Cash and flexible options compared side by side",
    "Payment pressure, title items, taxes, and repairs reviewed up front",
    "Plain-English terms before you decide",
    "The first conversation is not a contract",
  ],
  storySlug = "river-market-condo-payment-takeover",
  primaryHref = "/get-offer/",
  primaryLabel = "Compare my options",
  trackingLocation = "creative_promise",
} = Astro.props as Props;

const story = getSellerStory(storySlug);
---

<section class="section">
  <div class="rounded-[2rem] border border-border/60 bg-white p-5 shadow-sm lg:p-8">
    <div class="grid gap-5 md:grid-cols-[auto_minmax(0,1fr)] md:items-center">
      <CreativeHomeBuyerSeal compact className="mx-auto sm:mx-0" />
      <div class="space-y-2 text-center sm:text-left">
        <p class="text-sm font-black uppercase tracking-[0.1em] text-secondary">{eyebrow}</p>
        <h2 class="max-w-4xl text-3xl font-black leading-tight text-primary md:text-4xl">{heading}</h2>
        <p class="max-w-3xl text-sm leading-6 text-muted">{intro}</p>
      </div>
    </div>

    <div class="mt-6 grid gap-5 xl:grid-cols-[minmax(0,1fr)_16rem] xl:items-end">
      <div class="grid gap-3 sm:grid-cols-2">
        {points.map((point) => (
          <div class="rounded-[1.25rem] border border-border/60 bg-cream p-4 text-sm font-medium text-primary">
            {point}
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap xl:flex-col">
        <a href={primaryHref} class="btn btn-primary w-full sm:w-auto xl:w-full">{primaryLabel}</a>
        <a
          href={`tel:${SITE.phoneTel}`}
          class="btn btn-ghost w-full sm:w-auto xl:w-full"
          data-phone-link={`${trackingLocation}_call`}
        >
          Call {SITE.phoneDisplay}
        </a>
        {story && (
          <a href={`/seller-stories/${story.slug}/`} class="btn btn-outline w-full sm:w-auto xl:w-full">
            Related story
          </a>
        )}
      </div>
    </div>
  </div>
</section>
