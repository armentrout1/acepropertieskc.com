---
import OfferForm from "./OfferForm.astro";
import { SITE } from "../lib/siteConfig";

type Props = {
  badge?: string;
  title: string;
  body: string;
  points?: string[];
  formId: string;
  formHeading: string;
  formSubheading?: string;
  defaultSituation?: string;
  pageContext?: string;
  trackingLocation?: string;
};

const {
  badge = "Start here",
  title,
  body,
  points = [
    "As-is review with no repair requirement",
    "Cash and flexible options explained in writing",
    "Flexible closing dates across the Kansas City metro",
  ],
  formId,
  formHeading,
  formSubheading = "Start with the address and the best way to reach you.",
  defaultSituation = "as-is cash",
  pageContext = "",
  trackingLocation = formId,
} = Astro.props;
---

<section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
  <div class="rounded-[2rem] bg-primary p-6 text-white shadow-sm md:p-8">
    <p class="badge">{badge}</p>
    <div class="space-y-3">
      <h2 class="text-3xl font-black text-white">{title}</h2>
      <p class="text-white/78">{body}</p>
    </div>
    <ul class="mt-5 grid gap-3 text-sm text-primary sm:grid-cols-2">
      {points.map((point) => (
        <li class="flex items-start gap-3 rounded-[1.25rem] bg-white/92 p-4">
          <span class="mt-1.5 h-2 w-2 rounded-full bg-secondary"></span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`tel:${SITE.phoneTel}`} class="btn bg-white text-primary hover:bg-white/90" data-phone-link={`${trackingLocation}_call`}>
        Call {SITE.phoneDisplay}
      </a>
      <a href={`sms:${SITE.smsTel}`} class="btn border border-white/40 text-white hover:bg-white/10" data-sms-link={`${trackingLocation}_sms`}>
        Text us
      </a>
    </div>
  </div>
  <OfferForm
    compact
    includeCompactNotes
    formId={formId}
    heading={formHeading}
    subheading={formSubheading}
    defaultSituation={defaultSituation}
    pageContext={pageContext || trackingLocation}
  />
</section>
