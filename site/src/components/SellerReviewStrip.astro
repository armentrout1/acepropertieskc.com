---
import { approvedSellerReviews } from "../data/reviews";
import { SITE } from "../lib/siteConfig";

type Props = {
  heading?: string;
  intro?: string;
};

const {
  heading = "What sellers say about ACE",
  intro = "Only approved, real seller reviews appear here.",
} = Astro.props as Props;

const googleLetters = [
  { char: "G", color: "text-[#4285f4]" },
  { char: "o", color: "text-[#ea4335]" },
  { char: "o", color: "text-[#fbbc04]" },
  { char: "g", color: "text-[#4285f4]" },
  { char: "l", color: "text-[#34a853]" },
  { char: "e", color: "text-[#ea4335]" },
];
---

{approvedSellerReviews.length > 0 && (
  <section class="section section-alt space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl space-y-2">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Seller reviews</p>
        <h2 class="text-3xl font-semibold text-primary">{heading}</h2>
        <p class="text-muted">{intro}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={SITE.googleBusinessProfileUrl} class="btn btn-ghost" target="_blank" rel="noopener">
          Read Google reviews
        </a>
        <a href={SITE.googleReviewUrl} class="btn btn-primary" target="_blank" rel="noopener">
          Leave a Google review
        </a>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {approvedSellerReviews.map((review) => (
        <figure class="overflow-hidden rounded-[24px] border border-border bg-white shadow-sm">
          <div class="border-b border-border bg-white px-5 py-4">
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl font-black shadow-sm ring-1 ring-border" aria-hidden="true">
                  <span class="text-[#4285f4]">G</span>
                </span>
                <div>
                  <p class="text-base font-black leading-none tracking-normal" aria-label="Google review">
                    {googleLetters.map((letter) => (
                      <span class={letter.color}>{letter.char}</span>
                    ))}
                    <span class="ml-1 text-primary">review</span>
                  </p>
                  <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-muted">Verified seller feedback</p>
                </div>
              </div>
              <span class="rounded-full bg-[#fef7e0] px-3 py-1 text-sm font-black text-primary">5.0</span>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <span class="text-lg leading-none text-[#fbbc04]" aria-label="5 out of 5 stars">
                &#9733;&#9733;&#9733;&#9733;&#9733;
              </span>
              <span class="text-sm font-semibold text-muted">{review.reviewer}</span>
            </div>
          </div>
          <blockquote class="px-5 pt-5 text-sm leading-6 text-primary">"{review.text}"</blockquote>
          <figcaption class="px-5 pb-5 pt-4">
            <p class="text-sm text-muted">{review.location}</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-secondary">{review.situation}</p>
            {review.sourceUrl && (
              <a href={review.sourceUrl} class="mt-3 inline-flex text-sm font-semibold text-secondary underline" target="_blank" rel="noopener">
                {review.sourceLabel ?? "Review source"}
              </a>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}