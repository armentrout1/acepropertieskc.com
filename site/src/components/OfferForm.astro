---
type Props = {
  heading?: string;
  subheading?: string;
  formId?: string;
  compact?: boolean;
  mini?: boolean;
  addressFirst?: boolean;
  includeCompactNotes?: boolean;
  defaultSituation?: string;
  pageContext?: string;
  buttonLabel?: string;
};

const {
  heading = "Tell us about the property",
  subheading = "We'll review the basics and follow up shortly.",
  formId = "offer-form",
  compact = false,
  mini = false,
  addressFirst = false,
  includeCompactNotes = false,
  defaultSituation = "as-is cash",
  pageContext = "",
  buttonLabel,
} = Astro.props as Props;

const showNotes = !addressFirst && !mini && (!compact || includeCompactNotes);
const resolvedButtonLabel = buttonLabel ?? (addressFirst ? "See My Options" : mini ? "See my options" : "Start my offer conversation");
const sectionPadding = addressFirst ? "p-3 sm:p-4" : mini || compact ? "p-5" : "p-6";
const formSpacing = addressFirst ? "mt-4 space-y-4" : mini || compact ? "mt-5 space-y-4" : "mt-6 space-y-5";
const formElementId = `${formId}-fields`;
---

<section
  id={formId}
  data-offer-anchor
  data-address-first-anchor={addressFirst ? "true" : "false"}
  class:list={["w-full scroll-mt-32 bg-white shadow-sm md:scroll-mt-28", addressFirst ? "rounded-[2rem] border border-white/70 v3-soft-panel" : "rounded-2xl border border-border/70", sectionPadding]}
  aria-labelledby={`${formId}-title`}
>
  <div class:list={["space-y-1", addressFirst && "px-2 pt-2 sm:px-3"]}>
    <p
      id={`${formId}-badge`}
      class="inline-flex rounded-full bg-soft px-3 py-1 text-xs font-semibold uppercase tracking-wide text-secondary"
    >
      Get a no-pressure consultation
    </p>
    <h3 id={`${formId}-title`} class:list={[compact || mini ? "text-xl" : "text-2xl", "font-semibold text-primary"]}>{heading}</h3>
    <p class="text-sm text-muted">{subheading}</p>
  </div>

  <form
    id={formElementId}
    data-form-tracking-id={formId}
    data-offer-form
    data-address-first={addressFirst ? "true" : "false"}
    data-implied-consent={addressFirst ? "true" : "false"}
    method="post"
    action="/api/send-email/"
    class={formSpacing}
    novalidate
  >
    {addressFirst ? (
      <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
        <div class="space-y-1">
          <label for={`${formId}-address`} class="sr-only">
            Property address
          </label>
          <input
            id={`${formId}-address`}
            name="address"
            type="text"
            required
            aria-describedby={`${formId}-error`}
            placeholder="Enter your property address"
            class="v3-form-field"
          />
        </div>
        <button
          type="button"
          data-address-next
          class="btn btn-primary min-h-14 px-7 text-base sm:min-w-44"
        >
          {resolvedButtonLabel}
        </button>
      </div>
    ) : (
      <div class="space-y-1">
        <label for={`${formId}-address`} class="text-sm font-medium text-primary">
          Property address<span class="text-accent">*</span>
        </label>
        <input
          id={`${formId}-address`}
          name="address"
          type="text"
          required
          aria-describedby={`${formId}-error`}
          placeholder="123 Main St, Kansas City"
          class="v3-form-field"
        />
      </div>
    )}

    {addressFirst ? (
      <div data-address-next-panel class="hidden rounded-[1.5rem] border border-border/60 bg-soft/60 p-4">
        <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
          <div class="space-y-1">
            <label for={`${formId}-contact`} class="text-sm font-bold text-primary">
              Where should we send the next step?<span class="text-accent">*</span>
            </label>
            <input
              id={`${formId}-contact`}
              name="contact"
              type="text"
              required
              aria-describedby={`${formId}-error`}
              placeholder="Phone or email"
              class="v3-form-field"
            />
          </div>
          <button
            type="submit"
            class="btn btn-primary min-h-14 px-7 text-base md:min-w-44"
          >
            Send Details
          </button>
        </div>
        <input type="hidden" name="situation" value={defaultSituation} />
        <input type="hidden" name="timeline" value="not sure yet" />
        <input type="hidden" name="contact_preference" value="Any is fine" />
        <input type="hidden" name="consent" value="true" />
        <p class="mt-3 text-xs leading-5 text-muted">
          By submitting, you authorize ACE Properties KC to contact you about this property. Reply STOP to opt out.
        </p>
      </div>
    ) : mini ? (
      <>
        <div class="space-y-1">
          <label for={`${formId}-contact`} class="text-sm font-medium text-primary">
            Phone or email<span class="text-accent">*</span>
          </label>
          <input
            id={`${formId}-contact`}
            name="contact"
            type="text"
            required
            aria-describedby={`${formId}-error`}
            placeholder="Phone or email"
            class="v3-form-field"
          />
        </div>
        <input type="hidden" name="situation" value={defaultSituation} />
        <input type="hidden" name="timeline" value="not sure yet" />
        <input type="hidden" name="contact_preference" value="Any is fine" />
      </>
    ) : (
      <>
        <div class:list={["grid gap-4", compact ? "md:grid-cols-1" : "md:grid-cols-2"]}>
          <div class="space-y-1">
            <label for={`${formId}-situation`} class="text-sm font-medium text-primary">Situation</label>
            <select
              id={`${formId}-situation`}
              name="situation"
              class="v3-form-select"
            >
              <option value="as-is cash" selected={defaultSituation === "as-is cash"}>As-is cash</option>
              <option value="sell fast" selected={defaultSituation === "sell fast"}>Sell house fast</option>
              <option value="inherited" selected={defaultSituation === "inherited"}>Inherited</option>
              <option value="probate" selected={defaultSituation === "probate"}>Probate</option>
              <option value="repairs" selected={defaultSituation === "repairs"}>Needs repairs</option>
              <option value="vacant" selected={defaultSituation === "vacant"}>Vacant house</option>
              <option value="divorce" selected={defaultSituation === "divorce"}>Divorce</option>
              <option value="tenants" selected={defaultSituation === "tenants"}>Tenants in place</option>
              <option value="behind" selected={defaultSituation === "behind"}>Behind on payments</option>
              <option value="payment takeover" selected={defaultSituation === "payment takeover"}>Can you take over my payments?</option>
              <option value="foreclosure" selected={defaultSituation === "foreclosure"}>Facing foreclosure</option>
              <option value="tax lien" selected={defaultSituation === "tax lien"}>Tax lien</option>
              <option value="other" selected={defaultSituation === "other"}>Other</option>
            </select>
          </div>

          <div class="space-y-1">
            <label for={`${formId}-timeline`} class="text-sm font-medium text-primary">Timeline</label>
            <select
              id={`${formId}-timeline`}
              name="timeline"
              class="v3-form-select"
            >
              <option value="asap">ASAP</option>
              <option value="2-4 weeks">2-4 weeks</option>
              <option value="1-3 months">1-3 months</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>
        </div>

        <div class:list={["grid gap-4", compact ? "md:grid-cols-1" : "md:grid-cols-2"]}>
          <div class="space-y-1">
            <label for={`${formId}-name`} class="text-sm font-medium text-primary">Name (optional)</label>
            <input
              id={`${formId}-name`}
              name="name"
              type="text"
              placeholder="Your name"
              class="v3-form-field"
            />
          </div>

          <div class="space-y-1">
            <label for={`${formId}-phone`} class="text-sm font-medium text-primary">Phone</label>
            <input
              id={`${formId}-phone`}
              name="phone"
              type="tel"
              inputmode="tel"
              aria-describedby={`${formId}-error`}
              placeholder="816-728-7548"
              class="v3-form-field"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label for={`${formId}-email`} class="text-sm font-medium text-primary">Email</label>
          <input
            id={`${formId}-email`}
            name="email"
            type="email"
            aria-describedby={`${formId}-error`}
            placeholder="you@example.com"
            class="v3-form-field"
          />
        </div>

        <div class="space-y-1">
          <label for={`${formId}-contact-preference`} class="text-sm font-medium text-primary">Best way to reach you</label>
          <select
            id={`${formId}-contact-preference`}
            name="contact_preference"
            class="v3-form-select"
          >
            <option value="any">Any is fine</option>
            <option value="text">Text me first</option>
            <option value="call">Call me first</option>
            <option value="email">Email me first</option>
          </select>
        </div>
      </>
    )}

    {showNotes && (
      <div class="space-y-1">
        <label for={`${formId}-notes`} class="text-sm font-medium text-primary">Anything we should know?</label>
        <textarea
          id={`${formId}-notes`}
          name="notes"
          rows={compact ? "2" : "4"}
          placeholder="Repairs, tenants, timing, probate, mortgage payoff, payment takeover, or anything else on your mind"
          class="v3-form-textarea"
        ></textarea>
      </div>
    )}

    {!addressFirst && (
      <>
        <input type="hidden" name="consent" value="true" />
        <p class="text-xs leading-5 text-muted">
          By submitting, you authorize ACE Properties KC to contact you about this property. Reply STOP to opt out.
        </p>
      </>
    )}

    <div aria-hidden="true" class="sr-only">
      <label for={`${formId}-website`}>Website</label>
      <input
        id={`${formId}-website`}
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <input type="hidden" name="form_started_at" value="" />
    <input type="hidden" name="page_context" value={pageContext} />
    <input type="hidden" name="landing_page" value="" />
    <input type="hidden" name="referrer" value="" />
    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_medium" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="utm_term" value="" />
    <input type="hidden" name="utm_content" value="" />
    <input type="hidden" name="gclid" value="" />
    <input type="hidden" name="gbraid" value="" />
    <input type="hidden" name="wbraid" value="" />

    <p id={`${formId}-error`} data-error class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600" aria-live="polite" role="status"></p>

    {!addressFirst && (
      <button
        type="submit"
        class="w-full rounded-full bg-secondary px-5 py-4 text-center text-base font-bold text-white transition-colors hover:bg-secondary/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40 focus-visible:ring-offset-2"
      >
        {resolvedButtonLabel}
      </button>
    )}
    <p class="text-center text-xs text-muted">
      Trouble sending?
      <a href="tel:+18167287548" class="font-semibold text-secondary hover:text-primary">Call 816-728-7548</a>,
      <a href="sms:+18167287548" class="font-semibold text-secondary hover:text-primary">text us</a>, or
      <a href="mailto:info@acepropertieskc.com" class="font-semibold text-secondary hover:text-primary">email info@acepropertieskc.com</a>.
    </p>
  </form>
</section>

<script is:inline>
  document.querySelectorAll('form[data-offer-form]').forEach(function(form) {
    if (form.dataset.offerFormBound === 'true') {
      return;
    }
    form.dataset.offerFormBound = 'true';

    const trackingFormId = form.dataset.formTrackingId || form.id;
    const errorBanner = form.querySelector('[data-error]');
    const submitButton = form.querySelector('button[type="submit"]');
    const submitButtonText = submitButton ? submitButton.textContent : '';
    const startField = form.querySelector('input[name="form_started_at"]');
    const addressFirst = form.dataset.addressFirst === 'true';
    const impliedConsent = form.dataset.impliedConsent === 'true';
    const addressNextButton = form.querySelector('[data-address-next]');
    const addressNextPanel = form.querySelector('[data-address-next-panel]');
    const deliveryFallbackMessage = 'The form could not send right now. Please call or text 816-728-7548, or email info@acepropertieskc.com.';
    const sourceFields = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'gclid',
      'gbraid',
      'wbraid'
    ];

    if (startField) {
      startField.value = Date.now().toString();
    }

    const params = new URLSearchParams(window.location.search);
    const landingField = form.querySelector('input[name="landing_page"]');
    const referrerField = form.querySelector('input[name="referrer"]');

    if (landingField) {
      landingField.value = window.location.href;
    }

    if (referrerField) {
      referrerField.value = document.referrer || '';
    }

    sourceFields.forEach((fieldName) => {
      const field = form.querySelector(`input[name="${fieldName}"]`);
      if (field) {
        field.value = params.get(fieldName) || '';
      }
    });

    let formStartedTracked = false;
    const trackFormEvent = (eventName, payload = {}) => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, {
          form_id: trackingFormId,
          page_path: window.location.pathname,
          page_title: document.title,
          ...payload
        });

        const googleAdsSendTo = eventName === 'generate_lead'
          ? window.__aceGoogleAdsConversions?.lead
          : '';

        if (googleAdsSendTo) {
          window.gtag('event', 'conversion', {
            send_to: googleAdsSendTo,
            form_id: trackingFormId,
            page_path: window.location.pathname,
            lead_type: payload.lead_type || 'offer_form'
          });
        }
      }

      if (typeof window.fbq === 'function') {
        const metaPayload = {
          content_name: trackingFormId,
          page_path: window.location.pathname,
          page_title: document.title,
          ...payload
        };

        if (eventName === 'generate_lead') {
          window.fbq('track', 'Lead', metaPayload);
        } else if (eventName === 'form_start') {
          window.fbq('track', 'Contact', {
            contact_method: 'form',
            ...metaPayload
          });
        } else {
          window.fbq('trackCustom', `ace_${eventName}`, metaPayload);
        }
      }
    };

    form.addEventListener('focusin', function() {
      if (formStartedTracked) {
        return;
      }

      formStartedTracked = true;
      trackFormEvent('form_start');
    });

    if (addressFirst && addressNextButton && addressNextPanel) {
      addressNextButton.addEventListener('click', function() {
        const addressInput = form.querySelector('input[name="address"]');
        const address = addressInput ? addressInput.value.trim() : '';

        if (!address) {
          trackFormEvent('form_validation_error', {
            error_count: 1,
            step: 'address_first'
          });

          if (errorBanner) {
            errorBanner.textContent = 'Please provide the property address.';
            errorBanner.classList.remove('hidden');
          }

          if (addressInput) {
            addressInput.setAttribute('aria-invalid', 'true');
            addressInput.focus();
          }
          return;
        }

        if (addressInput) {
          addressInput.removeAttribute('aria-invalid');
        }
        if (errorBanner) {
          errorBanner.classList.add('hidden');
          errorBanner.textContent = '';
        }

        addressNextPanel.classList.remove('hidden');
        addressNextButton.classList.add('hidden');
        form.querySelector('input[name="contact"]')?.focus();
      });
    }

    form.addEventListener('submit', async function(event) {
      event.preventDefault();
      if (addressFirst && addressNextPanel?.classList.contains('hidden')) {
        addressNextButton?.click();
        return;
      }

      const formData = new FormData(form);
      const errors = [];

      const address = (formData.get('address') || '').toString().trim();
      const contact = (formData.get('contact') || '').toString().trim();
      const phone = (formData.get('phone') || '').toString().trim();
      const email = (formData.get('email') || '').toString().trim();
      const addressInput = form.querySelector('input[name="address"]');
      const contactInput = form.querySelector('input[name="contact"]');
      const phoneInput = form.querySelector('input[name="phone"]');
      const emailInput = form.querySelector('input[name="email"]');
      const consentInput = form.querySelector('input[name="consent"]');
      const consentChecked = impliedConsent || (consentInput ? consentInput.getAttribute('value') === 'true' || consentInput.checked : false);
      const invalidFields = [];

      [addressInput, contactInput, phoneInput, emailInput, consentInput].forEach((field) => {
        if (field) {
          field.removeAttribute('aria-invalid');
        }
      });

      if (!address) {
        errors.push('Please provide the property address.');
        if (addressInput) {
          invalidFields.push(addressInput);
        }
      }

      if (!consentChecked) {
        errors.push('Consent is required to continue.');
        if (consentInput) {
          invalidFields.push(consentInput);
        }
      }

      if (!phone && !email && !contact) {
        errors.push('Share at least one way to reach you: phone or email.');
        if (contactInput) {
          invalidFields.push(contactInput);
        } else {
          if (phoneInput) {
            invalidFields.push(phoneInput);
          }
          if (emailInput) {
            invalidFields.push(emailInput);
          }
        }
      }

      if (errors.length > 0) {
        trackFormEvent('form_validation_error', {
          error_count: errors.length
        });

        if (errorBanner) {
          errorBanner.textContent = errors.join(' ');
          errorBanner.classList.remove('hidden');
        }
        invalidFields.forEach((field) => field.setAttribute('aria-invalid', 'true'));
        invalidFields[0]?.focus();
        return;
      }

      if (errorBanner) {
        errorBanner.classList.add('hidden');
        errorBanner.textContent = '';
      }

      const payload = {};
      formData.forEach((value, key) => {
        if (typeof value === 'string') {
          payload[key] = value;
        }
      });

      if (!payload.phone && !payload.email && typeof payload.contact === 'string') {
        if (payload.contact.includes('@')) {
          payload.email = payload.contact;
        } else {
          payload.phone = payload.contact;
        }
      }

      payload.consent = consentChecked;
      if (startField && typeof payload.form_started_at !== 'string') {
        payload.form_started_at = startField.value;
      }

      // Submit form to API
      let submitErrorTracked = false;
      const trackSubmitError = (errorType) => {
        submitErrorTracked = true;
        trackFormEvent('form_submit_error', {
          error_type: errorType
        });
      };

      try {
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Sending...';
        }

        const response = await fetch('/api/send-email/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          // Track successful form submission
          trackFormEvent('generate_lead', {
            lead_type: 'offer_form'
          });
          
          // Success - redirect to thank you page
          window.location.href = '/thank-you/';
        } else {
          let result = null;
          try {
            result = await response.json();
          } catch (parseError) {
            console.error('Form submit failed with a non-JSON response', response.status, parseError);
          }

          console.error('Form submit failed', response.status, result);

          if (result?.error === 'validation_error' && result.fields) {
            trackSubmitError('validation_error');
            throw new Error(Object.values(result.fields).join(' '));
          }

          if (result?.error === 'rate_limited') {
            trackSubmitError('rate_limited');
            throw new Error('Please wait a moment and try submitting again.');
          }

          if (result?.error === 'email_disabled' || result?.error === 'email_failed') {
            trackSubmitError(result.error);
            throw new Error(deliveryFallbackMessage);
          }

          trackSubmitError('unknown_response');
          throw new Error(deliveryFallbackMessage);
        }
      } catch (error) {
        console.error('Form submission error:', error);
        if (!submitErrorTracked) {
          trackSubmitError('submit_exception');
        }
        if (errorBanner) {
          errorBanner.textContent = error instanceof Error ? error.message : 'Failed to send message. Please try again.';
          errorBanner.classList.remove('hidden');
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = submitButtonText;
        }
      }
    });
  });
</script>
