---
import { SITE } from "../lib/siteConfig";

const startLinks = [
  { label: "Home", href: "/" },
  { label: "How It Works", href: "/#how-it-works" },
  { label: "Get an Offer", href: "/get-offer/" },
  { label: "Cash vs Creative Options", href: "/options/" },
  { label: "All Seller Situations", href: "/solutions/" },
];

const proofLinks = [
  { label: "Direct Buyer vs Wholesaler", href: "/direct-buyer-vs-wholesaler/" },
  { label: "Seller Stories", href: "/seller-stories/" },
  { label: "Seller Resources", href: "/resources/" },
  { label: "About ACE", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

const areaLinks = [
  { label: "Kansas City, MO", href: "/areas/kansas-city-mo/" },
  { label: "Overland Park, KS", href: "/areas/overland-park-ks/" },
  { label: "Olathe, KS", href: "/areas/olathe-ks/" },
  { label: "Independence, MO", href: "/areas/independence-mo/" },
  { label: "View All Areas", href: "/areas/" },
];

const situationLinks = [
  { label: "Sell House Fast", href: "/solutions/sell-house-fast/" },
  { label: "Behind on Payments", href: "/solutions/behind-on-payments/" },
  { label: "Inherited House", href: "/solutions/inherited-house/" },
  { label: "Needs Repairs", href: "/solutions/needs-repairs/" },
  { label: "Facing Foreclosure", href: "/solutions/facing-foreclosure/" },
];

const trustChips = [
  "Buying direct since 2016",
  "Cash or creative options",
  "No repairs or clean-out required",
];
---

<footer class="border-t border-primary/20 bg-primary text-sm text-white">
  <div class="container-shell py-12 md:py-16">
    <div class="grid gap-8 rounded-[2rem] border border-white/10 bg-white/10 p-6 shadow-2xl shadow-primary/20 md:p-8 lg:grid-cols-[1fr_0.85fr] lg:items-center">
      <div class="space-y-5">
        <div class="flex flex-wrap gap-2">
          {trustChips.map((chip) => (
            <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.08em] text-white/90">
              {chip}
            </span>
          ))}
        </div>
        <div class="max-w-3xl space-y-3">
          <p class="text-sm font-black uppercase tracking-[0.12em] text-accent">ACE Properties KC</p>
          <h2 class="text-3xl font-black leading-tight text-white md:text-4xl">
            Ready to compare a real offer path?
          </h2>
          <p class="text-base leading-7 text-white/80">
            Share the address, ask your questions, or call us directly. We buy Kansas City houses as-is and explain cash or flexible options before you decide.
          </p>
        </div>
      </div>

      <div class="rounded-[1.5rem] border border-white/10 bg-white p-5 text-primary shadow-xl">
        <div class="flex items-center gap-4">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-soft">
            <img src="/brand/ace-mark.svg" alt={`${SITE.name} mark`} class="h-10 w-10" loading="lazy" decoding="async" />
          </span>
          <div>
            <p class="text-xl font-black">{SITE.name}</p>
            <p class="text-sm font-semibold text-muted">Local Kansas City direct buyer</p>
          </div>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a href="/get-offer/" class="btn btn-primary justify-center text-base">Get My Offer</a>
          <a href={`tel:${SITE.phoneTel}`} class="btn btn-ghost justify-center text-base" data-phone-link="footer_cta">Call {SITE.phoneDisplay}</a>
        </div>
        <a href={`sms:${SITE.smsTel}`} class="mt-3 inline-flex w-full justify-center rounded-full border border-secondary/25 px-4 py-3 text-sm font-black text-secondary transition hover:bg-secondary/5" data-sms-link="footer_cta">
          Text ACE
        </a>
      </div>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <nav class="rounded-[1.5rem] border border-white/10 bg-white/10 p-5" aria-label="Start here">
        <p class="text-base font-black text-white">Start Here</p>
        <div class="mt-4 flex flex-col gap-2">
          {startLinks.map((link) => (
            <a href={link.href} class="rounded-full px-3 py-2 font-bold text-white/75 transition hover:bg-white/10 hover:text-white">
              {link.label}
            </a>
          ))}
        </div>
      </nav>

      <nav class="rounded-[1.5rem] border border-white/10 bg-white/10 p-5" aria-label="Trust and proof">
        <p class="text-base font-black text-white">Trust & Proof</p>
        <div class="mt-4 flex flex-col gap-2">
          {proofLinks.map((link) => (
            <a href={link.href} class="rounded-full px-3 py-2 font-bold text-white/75 transition hover:bg-white/10 hover:text-white">
              {link.label}
            </a>
          ))}
        </div>
      </nav>

      <nav class="rounded-[1.5rem] border border-white/10 bg-white/10 p-5" aria-label="Popular areas">
        <p class="text-base font-black text-white">Popular Areas</p>
        <div class="mt-4 flex flex-col gap-2">
          {areaLinks.map((link) => (
            <a href={link.href} class="rounded-full px-3 py-2 font-bold text-white/75 transition hover:bg-white/10 hover:text-white">
              {link.label}
            </a>
          ))}
        </div>
      </nav>

      <nav class="rounded-[1.5rem] border border-white/10 bg-white/10 p-5" aria-label="Common seller situations">
        <p class="text-base font-black text-white">Common Situations</p>
        <div class="mt-4 flex flex-col gap-2">
          {situationLinks.map((link) => (
            <a href={link.href} class="rounded-full px-3 py-2 font-bold text-white/75 transition hover:bg-white/10 hover:text-white">
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-5 text-xs text-white/60 md:flex-row md:items-center md:justify-between">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <nav class="flex flex-wrap gap-4">
        <a href="/privacy/" class="transition hover:text-white">Privacy</a>
        <a href="/terms/" class="transition hover:text-white">Terms</a>
        <a href="/contact/" class="transition hover:text-white">Contact</a>
      </nav>
    </div>
  </div>
</footer>
