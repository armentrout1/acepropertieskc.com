---
import { SITE } from "../lib/siteConfig";

type Props = {
  eyebrow?: string;
  heading?: string;
  body?: string;
  note?: string;
  phoneLabel?: string;
  smsLabel?: string;
  offerLabel?: string;
  offerHref?: string;
  trackingLocation?: string;
};

const {
  eyebrow = "Want the easy button?",
  heading = "Call ACE and we will help you sort out the next step.",
  body = "Tell us the address and what is going on. We can explain whether a cash offer, payoff-at-closing, clean-out, or payment takeover option makes sense before you commit to anything.",
  note = "No pressure. It starts with a conversation, not a contract.",
  phoneLabel = `Call ACE: ${SITE.phoneDisplay}`,
  smsLabel = "Text the address",
  offerLabel = "Start with the address",
  offerHref = "/get-offer/#get-offer-address-first-form",
  trackingLocation = "call_ace_cta",
} = Astro.props;
---

<section class="rounded-2xl border border-secondary/25 bg-white p-5 shadow-sm sm:p-6">
  <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-center">
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">{eyebrow}</p>
      <h2 class="text-2xl font-semibold text-primary">{heading}</h2>
      <p class="max-w-3xl text-sm leading-6 text-muted sm:text-base">{body}</p>
      <p class="text-sm font-semibold text-primary">{note}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:min-w-60 lg:flex-col">
      <a
        href={`tel:${SITE.phoneTel}`}
        class="btn btn-primary justify-center text-base"
        data-phone-link={`${trackingLocation}_call`}
      >
        {phoneLabel}
      </a>
      <a
        href={`sms:${SITE.smsTel}`}
        class="btn btn-ghost justify-center text-base"
        data-sms-link={`${trackingLocation}_sms`}
      >
        {smsLabel}
      </a>
      <a
        href={offerHref}
        class="btn btn-outline justify-center text-base"
        data-offer-jump
      >
        {offerLabel}
      </a>
    </div>
  </div>
</section>
