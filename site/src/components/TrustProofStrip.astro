---
import CreativeHomeBuyerSeal from "./CreativeHomeBuyerSeal.astro";
import { SITE } from "../lib/siteConfig";

const proofItems = [
  {
    label: "Local KC operator",
    body: "Direct conversations with ACE Properties KC, not a call-center handoff.",
  },
  {
    label: "As-is means as-is",
    body: "Repairs, contents, dated finishes, trees, tenants, and title items can be part of the plan.",
  },
  {
    label: "Cash or creative",
    body: "We can compare a cash sale with payment-takeover or payoff options when the numbers call for it.",
  },
  {
    label: "Conversation first",
    body: "The form starts a review, not a contract or a pressure campaign.",
  },
];
---

<section class="section pt-0">
  <div class="grid gap-5 rounded-3xl border border-border/70 bg-white p-5 shadow-sm lg:grid-cols-[auto_1fr] lg:items-center">
    <div class="flex items-center gap-4">
      <CreativeHomeBuyerSeal compact />
      <div class="space-y-2 lg:max-w-xs">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Built for complicated seller situations</p>
        <h2 class="text-2xl font-semibold text-primary">A flexible local buyer, not a one-option pitch</h2>
        <p class="text-sm text-muted">
          Call or text {SITE.phoneDisplay} when you want a plain-English review before deciding.
        </p>
      </div>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {proofItems.map((item) => (
        <div class="rounded-2xl border border-border/70 bg-soft/60 p-4">
          <p class="text-sm font-semibold text-primary">{item.label}</p>
          <p class="mt-1 text-sm leading-6 text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
