---
import CreativeHomeBuyerSeal from "./CreativeHomeBuyerSeal.astro";
import { SITE } from "../lib/siteConfig";

const proofItems = [
  {
    label: `Buying direct since ${SITE.buyerSince}`,
    body: "Cash purchases, inherited homes, rental-house purchases, and creative structures are part of ACE's real history.",
  },
  {
    label: "Local KC operator",
    body: "Direct conversations with ACE Properties KC, not a call-center handoff.",
  },
  {
    label: "As-is means as-is",
    body: "Repairs, contents, dated finishes, trees, tenants, and title items can be part of the plan.",
  },
  {
    label: "Cash or creative",
    body: "We can compare a cash sale with payment-takeover or payoff options when the numbers call for it.",
  },
  {
    label: "Conversation first",
    body: "The form starts a review, not a contract or a pressure campaign.",
  },
];
---

<section class="section pt-8">
  <div class="grid gap-6 rounded-[2rem] border border-border/60 bg-white p-5 shadow-sm lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1.28fr)] lg:items-center lg:p-7">
    <div class="grid gap-5 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center">
      <CreativeHomeBuyerSeal compact className="mx-auto sm:mx-0" />
      <div class="space-y-2 text-center sm:text-left lg:max-w-xs">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Built for complicated seller situations</p>
        <h2 class="text-2xl font-black text-primary">A flexible local buyer, not a one-option pitch</h2>
        <p class="text-sm text-muted">
          Call or text {SITE.phoneDisplay} when you want a plain-English review before deciding.
        </p>
      </div>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {proofItems.map((item) => (
        <div class="rounded-[1.35rem] border border-border/60 bg-cream p-4">
          <p class="text-sm font-black text-primary">{item.label}</p>
          <p class="mt-1 text-sm leading-6 text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
