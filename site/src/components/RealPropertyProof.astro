---
import { SITE } from "../lib/siteConfig";

type Props = {
  eyebrow?: string;
  heading?: string;
  intro?: string;
};

const {
  eyebrow = "Real local property proof",
  heading = "You do not have to make the house look perfect before calling.",
  intro = "ACE reviews houses with repairs, contents, unfinished projects, code concerns, and tight timelines. The goal is a practical path forward, not judgment.",
} = Astro.props as Props;

const proofPhotos = [
  {
    src: "/images/proof/kansas-city-home-buyer-property-walkthrough.jpg",
    alt: "ACE Properties KC reviewing an as-is Kansas City house interior",
    label: "Local walkthroughs",
    title: "Real people look at the property details.",
    body: "We can review condition, clean-out, repairs, payoff, and timing with a homeowner before they spend money getting a house ready.",
  },
  {
    src: "/images/proof/sell-house-as-is-kansas-city-repairs-ok.jpg",
    alt: "Kansas City house interior repairs before and after as-is sale review",
    label: "Sell as-is",
    title: "Unfinished projects do not have to stop the sale.",
    body: "You can ask for a direct review before replacing flooring, opening walls, finishing punch-list items, or trying to make the house listing-ready.",
  },
  {
    src: "/images/proof/kansas-city-property-problem-before-after.jpg",
    alt: "Kansas City property exterior before and after improvement work",
    label: "Problem properties",
    title: "Deferred maintenance does not stop the conversation.",
    body: "Vacant, dated, tenant-worn, or repair-heavy properties can still be evaluated with a calm as-is plan.",
  },
];
---

<section class="section">
  <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div class="space-y-5">
      <div class="space-y-3">
        <p class="badge">{eyebrow}</p>
        <h2 class="text-3xl font-black leading-tight text-primary md:text-4xl">{heading}</h2>
        <p class="text-muted">{intro}</p>
      </div>
      <div class="rounded-[1.5rem] border border-border/60 bg-white p-5 shadow-sm">
        <p class="text-sm font-black uppercase tracking-[0.08em] text-secondary">Respectful process</p>
        <p class="mt-2 text-sm leading-6 text-muted">
          We avoid showing addresses, private seller details, or anything meant to embarrass a homeowner. The point is simple:
          we have seen real property problems and can talk through them calmly.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn btn-primary">Start with my address</a>
        <a href={`tel:${SITE.phoneTel}`} class="btn btn-ghost" data-phone-link="real_property_proof">Call {SITE.phoneDisplay}</a>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {proofPhotos.map((photo) => (
        <article class="overflow-hidden rounded-[1.5rem] border border-border/60 bg-white shadow-sm">
          <img
            src={photo.src}
            alt={photo.alt}
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="p-5">
            <p class="text-xs font-black uppercase tracking-[0.08em] text-secondary">{photo.label}</p>
            <h3 class="mt-2 text-lg font-black leading-tight text-primary">{photo.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{photo.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
