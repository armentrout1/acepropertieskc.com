---
import "../styles/global.css";
import manropeFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import sourceSansFont from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCtaBar from "../components/MobileCtaBar.astro";
import DesktopCtaBar from "../components/DesktopCtaBar.astro";
import ScrollControls from "../components/ScrollControls.astro";
import ClickTracking from "../components/ClickTracking.astro";
import GoogleTags from "../components/GoogleTags.astro";
import MetaPixel from "../components/MetaPixel.astro";
import Seo from "../components/Seo.astro";
import { SITE } from "../lib/siteConfig";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  robots?: string;
  jsonLd?: object[];
  headerVariant?: "default" | "landing";
};

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonicalPath,
  noindex,
  robots,
  jsonLd,
  headerVariant = "default",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<GoogleTags />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={sourceSansFont} as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<Seo
			title={title}
			description={description}
			canonicalPath={canonicalPath}
			noindex={noindex}
			robots={robots}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="min-h-screen overflow-x-clip bg-cream text-base text-primary">
		<MetaPixel />
		<Header variant={headerVariant} />
		<main class="container-shell flex-1 pb-[calc(6rem+env(safe-area-inset-bottom,0px))] md:pb-0">
			<slot />
		</main>
		<Footer />
		<MobileCtaBar />
		<DesktopCtaBar />
		<ScrollControls />
		<ClickTracking />

		<script is:inline>
			(() => {
				const findOfferTarget = () => {
					const target =
						document.querySelector('[data-offer-anchor][data-address-first-anchor="true"]') ||
						document.querySelector('[data-offer-anchor]');
					const input = target?.querySelector?.('input[name="address"]') || null;

					return { target, input };
				};

				const scrollToOffer = (target, input) => {
					const header = document.querySelector('header');
					const headerHeight = header ? header.getBoundingClientRect().height : 0;
					const top = target.getBoundingClientRect().top + window.scrollY - headerHeight - 14;
					const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

					window.scrollTo({
						top: Math.max(0, top),
						behavior: reducedMotion ? 'auto' : 'smooth',
					});

					if (input) {
						window.setTimeout(() => input.focus({ preventScroll: true }), reducedMotion ? 0 : 350);
					}
				};

				document.querySelectorAll('[data-offer-jump]').forEach((link) => {
					link.addEventListener('click', (event) => {
						const { target, input } = findOfferTarget();

						if (!target) {
							return;
						}

						event.preventDefault();
						history.replaceState(null, '', `${window.location.pathname}${window.location.search}#${target.id}`);
						scrollToOffer(target, input);
					});
				});
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
