---
import Layout from "../layouts/Layout.astro";
import OfferForm from "../components/OfferForm.astro";
import TrustProofStrip from "../components/TrustProofStrip.astro";
import SellerReviewStrip from "../components/SellerReviewStrip.astro";
import CreativeHomeBuyerSeal from "../components/CreativeHomeBuyerSeal.astro";
import { sellerStories } from "../data/sellerStories";
import { SITE } from "../lib/siteConfig";
import { webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../lib/seo";

const heroProofPills = [
  `Buying direct since ${SITE.buyerSince}`,
  "Cash or creative options",
  "No repairs or clean-out",
  "Not a contract",
];

const directBuyerProof = [
  {
    label: "Direct buyer",
    body: "ACE makes offers with the intent to buy, not just shop your contract around.",
  },
  {
    label: "Actually closes",
    body: "If we make an offer, we are prepared to close under the written terms.",
  },
  {
    label: "Flexible structures",
    body: "Cash, payoff-at-closing, inherited houses, rentals, and payment-takeover conversations can all be reviewed.",
  },
];

const afterSubmitSteps = [
  "We review the address and local property context.",
  "We ask a few plain questions about condition, timing, payoffs, and what would actually help.",
  "We explain cash, payoff-at-closing, and creative options when they fit the situation.",
  "You decide with no pressure and no obligation from the first form.",
];

const urgentSellerProblems = [
  {
    title: "Payment or tax pressure",
    body:
      "If you are behind on payments, dealing with back taxes, or running out of time, we can review whether a fast cash sale, payoff-at-closing, or payment takeover conversation fits the numbers.",
    href: "/solutions/behind-on-payments/",
  },
  {
    title: "A house that needs too much work",
    body:
      "You do not need to replace the roof, fix the foundation, update the kitchen, clean everything out, or make the yard perfect before asking for an offer.",
    href: "/solutions/needs-repairs/",
  },
  {
    title: "Equity trapped in a difficult property",
    body:
      "When a normal listing is too slow or expensive, we can compare an as-is offer that accounts for repairs, taxes, payoffs, contents, clean-out, and closing timing.",
    href: "/resources/as-is-sale-net-sheet-template/",
  },
  {
    title: "A mortgage that needs a different path",
    body:
      "When the loan balance or monthly payment is the main issue, we can explain payment takeover options in plain English and encourage advisor review before anyone signs.",
    href: "/options/",
  },
];

const steps = [
  {
    title: "Reach out",
    body: "Share the property basics and what you need. A real person reviews every inquiry the same day."
  },
  {
    title: "Quick walkthrough",
    body: "We coordinate a visit or video walkthrough so you can highlight repairs, tenants, or special considerations."
  },
  {
    title: "Choose an option",
    body: "Pick a straightforward cash price or a payment takeover path when the loan and timeline allow."
  }
];

const quickLinks = [
  {
    title: "Cash or creative options",
    body: "Compare a simple cash sale with payment-takeover or payoff-at-closing paths.",
    href: "/options/",
  },
  {
    title: "Direct buyer vs wholesaler",
    body: "Know whether the buyer is prepared to close or still needs to sell the contract.",
    href: "/direct-buyer-vs-wholesaler/",
  },
  {
    title: "Areas we buy",
    body: "See the Kansas City metro cities and neighborhoods ACE reviews.",
    href: "/areas/",
  },
];

const faqs = [
  {
    question: "Do I need to clean or fix anything first?",
    answer: "No. We evaluate properties as-is, including dated interiors, unfinished projects, or occupied rentals."
  },
  {
    question: "How fast can we close?",
    answer: "Cash offers can close in as little as 10-14 days once title is clear. We prioritize your timeline and can expedite every step."
  },
  {
    question: "What if I still owe on the mortgage?",
    answer: "That's common. We'll verify the payoff with title and compare a cash sale, payoff-at-closing, or payment takeover option when the loan and timeline allow."
  },
  {
    question: "Are there fees or commissions?",
    answer: "No commissions. Standard closing costs are reviewed with you up front before you sign anything."
  },
  {
    question: "What if I'm dealing with a difficult situation?",
    answer: "We handle complex situations daily - probate, relocations, financial pressure, and more. We provide practical options without judgment and clear next steps."
  },
  {
    question: "Can I talk with someone before deciding?",
    answer: "Absolutely. Every conversation starts with questions, not paperwork, so you stay in control."
  }
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
];
---

<Layout
  title="Sell My House Fast Kansas City | Cash & Payment Options"
  description="Need to sell your Kansas City house fast or as-is? Compare a local cash offer, payment takeover options, repairs, payoffs, and timelines with no pressure."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="full-bleed relative overflow-hidden bg-primary text-white">
    <img
      src="/images/kc-home-hero-v3.png"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/88 via-primary/58 to-primary/20"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-cream to-transparent"></div>
    <div class="container-shell relative grid min-h-[calc(100vh-7rem)] gap-8 py-8 md:min-h-[680px] md:gap-10 md:py-16 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
      <div class="flex flex-col gap-5 md:gap-7">
        <div class="order-4 flex flex-wrap gap-3">
          {heroProofPills.map((pill) => (
            <span class="v3-pill">{pill}</span>
          ))}
        </div>

        <div class="order-1 max-w-4xl space-y-3 md:space-y-5">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Local Kansas City direct buyer</p>
          <h1 class="text-4xl font-black leading-[1.04] text-white md:text-6xl lg:text-7xl">
            Sell Your Kansas City House As-Is
          </h1>
          <p class="max-w-3xl text-lg leading-7 text-white/88 md:text-2xl md:leading-9">
            Get a cash offer or creative option from a local buyer who has been buying directly from sellers since {SITE.buyerSince}.
          </p>
        </div>

        <div class="order-2 max-w-4xl">
          <OfferForm
            addressFirst
            formId="homepage-address-first-form"
            heading="Start with the address"
            subheading="We will ask for your contact on the next step, then review cash and creative options."
            defaultSituation="options review"
            pageContext="homepage_v3_address_first"
            buttonLabel="See my options"
          />
        </div>

        <div class="order-3 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={`tel:${SITE.phoneTel}`}
            class="btn bg-white text-primary hover:bg-white/90"
            data-phone-link="homepage_v3_hero"
          >
            Call {SITE.phoneDisplay}
          </a>
          <a
            href={`sms:${SITE.smsTel}`}
            class="btn border border-white/40 text-white hover:bg-white/10"
            data-sms-link="homepage_v3_hero"
          >
            Text ACE
          </a>
        </div>
      </div>

      <aside class="relative">
        <div class="rounded-[2.5rem] border border-white/20 bg-white/12 p-5 shadow-2xl backdrop-blur md:p-7">
          <div class="grid gap-5 sm:grid-cols-[auto_1fr] sm:items-center">
            <CreativeHomeBuyerSeal compact className="mx-auto sm:mx-0" />
            <div class="text-center sm:text-left">
              <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">ACE Promise</p>
              <h2 class="mt-2 text-3xl font-black leading-tight text-white md:text-4xl">We buy direct and intend to close.</h2>
            </div>
          </div>

          <div class="mt-7 grid gap-4">
            {directBuyerProof.map((item) => (
              <div class="rounded-[1.5rem] border border-white/15 bg-white/90 p-5 text-primary shadow-sm">
                <p class="text-base font-black">{item.label}</p>
                <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
              </div>
            ))}
          </div>

          <div class="mt-7 rounded-[1.5rem] bg-primary/80 p-5">
            <p class="text-sm font-bold uppercase tracking-[0.1em] text-accent">Not a wholesaler-first pitch</p>
            <p class="mt-2 text-sm leading-6 text-white/82">
              Some buyers sign a contract and then still have to find another investor to buy it. ACE is built around making offers we are prepared to purchase ourselves.
            </p>
            <a href="/direct-buyer-vs-wholesaler/" class="mt-4 inline-flex text-sm font-black text-white underline underline-offset-4">
              See how direct buyers compare
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <TrustProofStrip />

  <SellerReviewStrip
    heading="A real Google review from a seller ACE helped"
    intro="Trust should come from real people and real situations, especially when a seller is comparing cash and creative options."
  />

  <section class="full-bleed bg-white">
    <div class="container-shell grid gap-8 py-14 md:py-20 lg:grid-cols-[1fr_0.88fr] lg:items-start">
      <div class="space-y-6">
        <div class="max-w-3xl space-y-3">
          <p class="badge">When the house is the problem</p>
          <h2 class="text-3xl font-black text-primary md:text-4xl">Choose the path that solves the real pressure point</h2>
          <p class="text-muted">
            Some sellers need speed. Others need relief from repairs, payments, taxes, or family decisions. Start with the problem and ACE will compare practical options.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {urgentSellerProblems.map((item) => (
            <a href={item.href} class="rounded-[1.5rem] border border-border/60 bg-cream p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-secondary/60">
              <h3 class="text-xl font-black text-primary">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
              <span class="mt-4 inline-flex text-sm font-black text-secondary">Compare this path</span>
            </a>
          ))}
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/get-offer/" class="btn btn-primary">Start with my address</a>
          <a href="/solutions/" class="btn btn-ghost">See seller situations</a>
        </div>
      </div>

      <div class="rounded-[2rem] bg-primary p-6 text-white shadow-sm md:p-8">
        <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">What happens after you submit</p>
        <h3 class="mt-3 text-3xl font-black text-white">A clear review, not a pressure trap.</h3>
        <ol class="mt-6 space-y-3">
          {afterSubmitSteps.map((step, index) => (
            <li class="flex gap-3 rounded-[1.35rem] bg-white/92 p-4 text-primary">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-secondary text-sm font-black text-white">{index + 1}</span>
              <span class="pt-1 text-sm font-medium leading-6">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section-alt space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl space-y-2">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Seller stories</p>
        <h2 class="text-3xl font-semibold text-primary">Real examples of flexible problem solving</h2>
        <p class="text-muted">
          When the property, payment, or family situation is complicated, the right answer may be more nuanced than a standard cash offer.
        </p>
      </div>
      <a href="/seller-stories/" class="btn btn-ghost">View all stories</a>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {sellerStories.slice(0, 3).map((story) => (
        <a href={`/seller-stories/${story.slug}/`} class="card bg-white transition hover:-translate-y-1 hover:border-secondary/60">
          <p class="text-xs font-semibold uppercase tracking-wide text-secondary">{story.eyebrow}</p>
          <h3 class="mt-3 text-xl font-semibold text-primary">{story.title}</h3>
          <p class="mt-2 text-sm font-medium text-muted">{story.location}</p>
          <p class="mt-4 text-sm leading-6 text-muted">{story.summary}</p>
          <span class="mt-5 inline-flex text-sm font-semibold text-secondary">Read the story</span>
        </a>
      ))}
    </div>
  </section>

  <section id="how-it-works" class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">How it works</p>
      <h2 class="text-3xl font-semibold text-primary">Simple conversations, clear next steps</h2>
      <p class="max-w-3xl text-muted">
        We guide each phase so you know what details are needed, who is handling title work, and when you get paid.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="rounded-[1.75rem] border border-border/60 bg-white/90 p-6 shadow-sm" aria-label={`Step ${index + 1}`}>
          <p class="text-xs font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="mt-2 text-xl font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-alt space-y-6">
    <div class="max-w-3xl space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Helpful next reads</p>
      <h2 class="text-3xl font-semibold text-primary">Keep the decision simple</h2>
      <p class="text-muted">Use these pages when you want a little more context before sending the address.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {quickLinks.map((link) => (
        <a href={link.href} class="rounded-[1.5rem] border border-border/60 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-secondary/60">
          <h3 class="text-xl font-black text-primary">{link.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{link.body}</p>
          <span class="mt-4 inline-flex text-sm font-black text-secondary">Open page</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Questions homeowners ask</p>
      <h2 class="text-3xl font-semibold text-primary">FAQ</h2>
    </div>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section id="get-offer" class="section space-y-6">
    <div class="space-y-2 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Get an offer</p>
      <h2 class="text-3xl font-semibold text-primary">Share the property basics</h2>
      <p class="text-muted">No pressure. We'll confirm details and discuss next steps.</p>
    </div>
    <div class="mx-auto max-w-3xl">
      <OfferForm pageContext="homepage" />
    </div>
  </section>
</Layout>
