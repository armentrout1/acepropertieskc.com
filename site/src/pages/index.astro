---
import Layout from "../layouts/Layout.astro";
import OfferConfidencePanel from "../components/OfferConfidencePanel.astro";
import OfferForm from "../components/OfferForm.astro";
import { SITE } from "../lib/siteConfig";
import { webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../lib/seo";

const trustPoints = [
  "Local Kansas City team",
  "Sell as-is, no repairs",
  "Payment takeover reviews when appropriate",
  "No commissions or fees",
  "Your timeline, your choice"
];

const steps = [
  {
    title: "Reach out",
    body: "Share the property basics and what you need. A real person reviews every inquiry the same day."
  },
  {
    title: "Quick walkthrough",
    body: "We coordinate a visit or video walkthrough so you can highlight repairs, tenants, or special considerations."
  },
  {
    title: "Choose an option",
    body: "Pick a straightforward cash price or a payment takeover path when the loan and timeline allow."
  }
];

const solutions = [
  { title: "Sell House Fast", body: "Speed and certainty with as-is cash offers for any situation.", href: "/solutions/sell-house-fast/" },
  { title: "Behind on Payments", body: "Compare lender options, payoff-at-closing, payment takeover, and backup plans.", href: "/solutions/behind-on-payments/" },
  { title: "Facing Foreclosure", body: "Review timing, title, payoffs, housing counseling, and sale options calmly.", href: "/solutions/facing-foreclosure/" },
  { title: "Inherited Home", body: "Coordinate siblings and estates with calm, organized guidance.", href: "/solutions/inherited-house/" },
  { title: "Probate House", body: "Court-ready offers for executors navigating legal processes.", href: "/solutions/probate-house/" },
  { title: "Vacant House", body: "Stop carrying costs and sell empty properties as-is.", href: "/solutions/vacant-house/" },
  { title: "Relocating", body: "Job transfer sales with remote coordination and timing.", href: "/solutions/relocating/" },
  { title: "Major Repairs", body: "Skip contractors. We handle updates so you don't front costs.", href: "/solutions/needs-repairs/" }
];

const faqs = [
  {
    question: "Do I need to clean or fix anything first?",
    answer: "No. We evaluate properties as-is, including dated interiors, unfinished projects, or occupied rentals."
  },
  {
    question: "How fast can we close?",
    answer: "Cash offers can close in as little as 10-14 days once title is clear. We prioritize your timeline and can expedite every step."
  },
  {
    question: "What if I still owe on the mortgage?",
    answer: "That's common. We'll verify the payoff with title and compare a cash sale, payoff-at-closing, or payment takeover option when the loan and timeline allow."
  },
  {
    question: "Are there fees or commissions?",
    answer: "No commissions. Standard closing costs are reviewed with you up front before you sign anything."
  },
  {
    question: "What if I'm dealing with a difficult situation?",
    answer: "We handle complex situations daily - probate, relocations, financial pressure, and more. We provide practical options without judgment and clear next steps."
  },
  {
    question: "Can I talk with someone before deciding?",
    answer: "Absolutely. Every conversation starts with questions, not paperwork, so you stay in control."
  }
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
];
---

<Layout
  title="Sell My House Fast Kansas City | Cash & Payment Options"
  description="Need to sell your Kansas City house fast or as-is? Compare a local cash offer, payment takeover options, repairs, payoffs, and timelines with no pressure."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="section pt-4">
    <div class="rounded-3xl bg-gradient-to-b from-soft to-white/90 px-6 py-10 shadow-sm sm:px-10">
      <div class="space-y-6">
        <span class="badge">Local Kansas City Buyer</span>
        <div class="space-y-4">
          <h1 class="text-4xl font-semibold text-primary md:text-5xl">
          Sell Your Kansas City House Fast or As-Is
          </h1>
          <p class="text-muted">
          Whether you're in <a href="/areas/kansas-city-mo/" class="text-secondary underline">Kansas City</a>, <a href="/areas/overland-park-ks/" class="text-secondary underline">Overland Park</a>, <a href="/areas/olathe-ks/" class="text-secondary underline">Olathe</a>, or anywhere in the metro, we provide local guidance and practical solutions. We work with homeowners facing <a href="/solutions/relocating/" class="text-secondary underline">relocations</a>, <a href="/solutions/inherited-house/" class="text-secondary underline">inherited properties</a>, and situations requiring quick decisions.
          If the mortgage payment is the pressure point, we can also review <a href="/options/" class="text-secondary underline">cash or payment takeover options</a> before you choose a direction.
        </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="#get-offer" class="btn btn-primary text-base">
            Get My Offer
          </a>
          <a
            href={`tel:${SITE.phoneTel}`}
            class="btn btn-ghost text-base"
            data-phone-link="homepage_hero"
          >
            Call {SITE.phoneDisplay}
          </a>
        </div>
        <p class="text-sm font-medium text-muted">
          Serving homeowners across the Kansas City metro with transparent communication and local expertise.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card">
      <div class="grid gap-4 text-sm font-medium text-primary sm:grid-cols-5">
        {trustPoints.map((point) => (
          <div class="flex items-center gap-2" role="listitem">
            <span class="mt-1 inline-flex h-2 w-2 rounded-full bg-secondary"></span>
            <span>{point}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">How it works</p>
      <h2 class="text-3xl font-semibold text-primary">Simple conversations, clear next steps</h2>
      <p class="text-muted">
        We guide you through each phase so you always know what documents are needed, who is handling title work, and when you get paid.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card" aria-label={`Step ${index + 1}`}>
          <p class="text-xs font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="mt-2 text-xl font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Options for real situations</p>
      <h2 class="text-3xl font-semibold text-primary">Solutions we walk through every week</h2>
      <p class="text-muted">Choose the path that fits your timing, financing, and comfort level. We outline pros and trade-offs before you sign.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {solutions.map((solution) => (
        <a href={solution.href} class="card transition hover:-translate-y-1 hover:border-secondary/60">
          <h3 class="text-xl font-semibold text-primary">{solution.title}</h3>
          <p class="mt-2 text-sm text-muted">{solution.body}</p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-secondary">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="space-y-4">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Why homeowners choose options</p>
          <h2 class="text-3xl font-semibold text-primary">Control, transparency, and local expertise</h2>
        <p class="text-muted">
          Whether you need a <a href="/solutions/sell-house-fast/" class="text-secondary underline">fast cash sale</a>, help with a <a href="/solutions/probate-house/" class="text-secondary underline">probate house</a>, or want to sell a <a href="/solutions/vacant-house/" class="text-secondary underline">vacant property</a>, we lay out side-by-side comparisons so the decision is yours.
        </p>
        <p class="text-muted">
          If you are comparing a direct sale against listing, read our <a href="/resources/cash-buyer-vs-real-estate-agent-kansas-city/" class="text-secondary underline">cash buyer vs real estate agent guide</a>.
        </p>
        <ul class="space-y-3 text-sm text-primary">
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            Clear pricing backed by written breakdowns before contracts.
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            Title, escrow, and legal partners who work across Jackson, Johnson, and Clay Counties.
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            Flexible occupancy so you can stay put while packing or coordinating movers.
          </li>
        </ul>
      </div>
      <div class="card bg-white/90">
        <p class="text-lg font-semibold text-primary">What you can expect</p>
        <ul class="mt-4 space-y-3 text-sm text-muted">
          <li>Weekly updates during title work.</li>
          <li>Payment takeover outlines translated into plain English.</li>
          <li>Introductions to attorneys or advisors when you want a second opinion.</li>
        </ul>
        <a href="/resources/sell-house-as-is-kansas-city/" class="btn btn-ghost mt-6 w-full sm:w-auto">
          Read the as-is selling guide
        </a>
        <a href="/options/" class="btn btn-ghost mt-3 w-full sm:w-auto">
          Compare cash or takeover
        </a>
        <a href="#get-offer" class="btn btn-primary mt-3 w-full sm:w-auto">
          See your options
        </a>
      </div>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Featured areas</p>
      <h2 class="text-3xl font-semibold text-primary">Serving Kansas City metro homeowners</h2>
      <p class="text-muted">We buy houses across the Kansas City metro. Explore area-specific insights and market knowledge.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-4">
      <a href="/areas/kansas-city-mo/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Kansas City, MO</h3>
        <p class="mt-2 text-sm text-muted">Midtown, Brookside, and south side properties</p>
      </a>
      <a href="/areas/overland-park-ks/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Overland Park, KS</h3>
        <p class="mt-2 text-sm text-muted">Johnson County's largest city</p>
      </a>
      <a href="/areas/olathe-ks/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Olathe, KS</h3>
        <p class="mt-2 text-sm text-muted">Family neighborhoods and relocations</p>
      </a>
      <a href="/areas/independence-mo/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Independence, MO</h3>
        <p class="mt-2 text-sm text-muted">Historic properties and estates</p>
      </a>
      <a href="/areas/lees-summit-mo/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Lee's Summit, MO</h3>
        <p class="mt-2 text-sm text-muted">Growing Jackson County suburb</p>
      </a>
      <a href="/areas/shawnee-ks/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Shawnee, KS</h3>
        <p class="mt-2 text-sm text-muted">Established Johnson County community</p>
      </a>
      <a href="/areas/lenexa-ks/" class="card transition hover:-translate-y-1 hover:border-secondary/60">
        <h3 class="text-lg font-semibold text-primary">Lenexa, KS</h3>
        <p class="mt-2 text-sm text-muted">Planned communities and growth</p>
      </a>
      <a href="/areas/" class="card transition hover:-translate-y-1 hover:border-secondary/60 bg-soft">
        <h3 class="text-lg font-semibold text-primary">See all areas</h3>
        <p class="mt-2 text-sm text-muted">View complete service area</p>
      </a>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Questions homeowners ask</p>
      <h2 class="text-3xl font-semibold text-primary">FAQ</h2>
    </div>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <OfferConfidencePanel
    heading="Get clarity before you decide what to do with the house"
    intro="If you are comparing a direct sale, listing, payment takeover, or simply need a backup plan, these guides explain the next step before you submit the form."
  />

  <section id="get-offer" class="section space-y-6">
    <div class="space-y-2 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Get an offer</p>
      <h2 class="text-3xl font-semibold text-primary">Share the property basics</h2>
      <p class="text-muted">No pressure. We'll confirm details and discuss next steps.</p>
    </div>
    <div class="card p-4 sm:p-6">
      <OfferForm />
    </div>
  </section>
</Layout>
