---
import Layout from "../layouts/Layout.astro";
import OfferForm from "../components/OfferForm.astro";
import CreativePromisePanel from "../components/CreativePromisePanel.astro";
import SellerReviewStrip from "../components/SellerReviewStrip.astro";
import { getSellerStory } from "../data/sellerStories";
import { paidLandingPages, type PaidLandingPage } from "../data/paidLandingPages";
import { buildBreadcrumbList, buildFaqPageJsonLd, localBusinessJsonLd, serviceJsonLd, webSiteJsonLd } from "../lib/seo";
import { SITE } from "../lib/siteConfig";

export function getStaticPaths() {
  return paidLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: PaidLandingPage };
const canonicalPath = `/${page.slug}/`;
const formId = `${page.slug}-landing-form`;
const story = getSellerStory(page.storySlug);
const nextSteps = [
  "Start with the property address so we can review the right local context.",
  "Share phone or email on the next step so a real person can follow up.",
  "Compare cash, payoff, as-is, and creative options when they apply.",
  "Decide only after you understand the numbers, timing, and trade-offs.",
];
const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: page.headline,
    description: page.description,
    path: canonicalPath,
  }),
  buildFaqPageJsonLd(page.faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: page.headline, item: canonicalPath },
  ]),
];
---

<Layout
  title={page.title}
  description={page.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  headerVariant="landing"
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell grid gap-8 py-14 md:py-20 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">{page.eyebrow}</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
          <span class="v3-pill">Address-first review</span>
        </div>
        <div class="space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Kansas City seller options</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">{page.headline}</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">{page.lead}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          {page.proofPoints.map((point) => (
            <span class="rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-bold text-white">{point}</span>
          ))}
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`tel:${SITE.phoneTel}`} class="btn bg-white text-primary hover:bg-white/90" data-phone-link={`${page.slug}_hero_call`}>
            Call {SITE.phoneDisplay}
          </a>
          <a href={`sms:${SITE.smsTel}`} class="btn border border-white/40 text-white hover:bg-white/10" data-sms-link={`${page.slug}_hero_sms`}>
            Text us
          </a>
          <a href="/contact/" class="btn border border-white/40 text-white hover:bg-white/10">Ask first</a>
        </div>
      </div>

      <OfferForm
        addressFirst
        formId={formId}
        heading={page.formHeading}
        subheading={page.formSubheading}
        defaultSituation={page.defaultSituation}
        pageContext={`paid_landing_${page.slug}`}
        buttonLabel={page.buttonLabel}
      />
    </div>
  </section>

  <CreativePromisePanel
    eyebrow="Local ACE Promise"
    heading="Start with options, not pressure"
    intro="Paid ads should take sellers to the same honest conversation: cash when certainty matters, creative options when payment or payoff is the real problem, and plain numbers before commitment."
    storySlug={page.storySlug}
    primaryHref={`#${formId}`}
    primaryLabel={page.buttonLabel}
    trackingLocation={`${page.slug}_creative_promise`}
  />

  <section class="section section-alt">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Seller situation</p>
        <h2 class="text-3xl font-semibold text-primary">{page.situationHeading}</h2>
        <p class="text-muted">{page.situationBody}</p>
        {story && (
          <a href={`/seller-stories/${story.slug}/`} class="btn btn-ghost">
            Read related seller story
          </a>
        )}
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {page.situationBullets.map((item) => (
          <div class="rounded-[1.5rem] border border-border/70 bg-white px-5 py-4 shadow-sm">
            <p class="text-sm text-primary">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Compare before deciding</p>
      <h2 class="text-3xl font-semibold text-primary">{page.comparisonHeading}</h2>
      <p class="text-muted">{page.comparisonIntro}</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {page.comparisonItems.map((item) => (
        <article class="card">
          <h3 class="text-xl font-semibold text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="full-bleed bg-white">
    <div class="container-shell grid gap-6 py-14 md:grid-cols-[0.9fr_1.1fr] md:py-20">
      <article class="rounded-[2rem] bg-primary p-6 text-white shadow-sm md:p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent">What happens next</p>
        <h2 class="mt-3 text-3xl font-black text-white">The form starts a private review</h2>
        <p class="mt-3 text-sm leading-6 text-white/80">
          Send the address and one way to reach you. ACE can review property condition, title questions, timing, payoff pressure, and whether a cash or flexible structure fits before asking you to make a decision.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={`#${formId}`} class="btn bg-white text-primary hover:bg-white/90">Start with the address</a>
          <a href={page.relatedGuide.href} class="btn border border-white/40 text-white hover:bg-white/10">{page.relatedGuide.label}</a>
        </div>
      </article>
      <article class="rounded-[2rem] border border-border/70 bg-cream p-6 shadow-sm md:p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">No fake pressure</p>
        <h2 class="mt-3 text-3xl font-black text-primary">You can compare, ask questions, and pause</h2>
        <ol class="mt-5 space-y-3">
          {nextSteps.map((step, index) => (
            <li class="flex gap-3 rounded-[1.35rem] bg-white p-4 text-primary shadow-sm">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-secondary text-sm font-black text-white">{index + 1}</span>
              <span class="pt-1 text-sm leading-6">{step}</span>
            </li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  <SellerReviewStrip />

  <section class="section space-y-4">
    <h2 class="text-3xl font-semibold text-primary">{page.eyebrow} FAQ</h2>
    <div class="space-y-3">
      {page.faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
