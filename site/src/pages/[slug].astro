---
import Layout from "../layouts/Layout.astro";
import OfferForm from "../components/OfferForm.astro";
import CreativePromisePanel from "../components/CreativePromisePanel.astro";
import SellerReviewStrip from "../components/SellerReviewStrip.astro";
import { getSellerStory } from "../data/sellerStories";
import { paidLandingPages, type PaidLandingPage } from "../data/paidLandingPages";
import { buildBreadcrumbList, buildFaqPageJsonLd, localBusinessJsonLd, serviceJsonLd, webSiteJsonLd } from "../lib/seo";
import { SITE } from "../lib/siteConfig";

export function getStaticPaths() {
  return paidLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: PaidLandingPage };
const canonicalPath = `/${page.slug}/`;
const formId = `${page.slug}-landing-form`;
const story = getSellerStory(page.storySlug);
const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: page.headline,
    description: page.description,
    path: canonicalPath,
  }),
  buildFaqPageJsonLd(page.faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: page.headline, item: canonicalPath },
  ]),
];
---

<Layout
  title={page.title}
  description={page.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  headerVariant="landing"
>
  <section class="section grid gap-8 pt-4 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
    <div class="space-y-6">
      <p class="badge">{page.eyebrow}</p>
      <div class="space-y-4">
        <h1 class="text-4xl font-semibold text-primary md:text-5xl">{page.headline}</h1>
        <p class="text-lg leading-8 text-muted">{page.lead}</p>
      </div>
      <div class="grid gap-3 text-sm text-primary sm:grid-cols-2">
        {page.proofPoints.map((point) => (
          <div class="rounded-md border border-border bg-soft/70 p-3">{point}</div>
        ))}
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={`tel:${SITE.phoneTel}`} class="btn btn-secondary text-base" data-phone-link={`${page.slug}_hero_call`}>
          Call {SITE.phoneDisplay}
        </a>
        <a href={`sms:${SITE.smsTel}`} class="btn btn-ghost text-base" data-sms-link={`${page.slug}_hero_sms`}>
          Text us
        </a>
        <a href="/contact/" class="btn btn-outline text-base">Ask first</a>
      </div>
    </div>

    <OfferForm
      mini
      formId={formId}
      heading={page.formHeading}
      subheading={page.formSubheading}
      defaultSituation={page.defaultSituation}
      pageContext={`paid_landing_${page.slug}`}
      buttonLabel={page.buttonLabel}
    />
  </section>

  <CreativePromisePanel
    eyebrow="Local ACE Promise"
    heading="Start with options, not pressure"
    intro="Paid ads should take sellers to the same honest conversation: cash when certainty matters, creative options when payment or payoff is the real problem, and plain numbers before commitment."
    storySlug={page.storySlug}
    primaryHref={`#${formId}`}
    primaryLabel={page.buttonLabel}
    trackingLocation={`${page.slug}_creative_promise`}
  />

  <section class="section section-alt">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Seller situation</p>
        <h2 class="text-3xl font-semibold text-primary">{page.situationHeading}</h2>
        <p class="text-muted">{page.situationBody}</p>
        {story && (
          <a href={`/seller-stories/${story.slug}/`} class="btn btn-ghost">
            Read related seller story
          </a>
        )}
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {page.situationBullets.map((item) => (
          <div class="card bg-white">
            <p class="text-sm text-primary">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Compare before deciding</p>
      <h2 class="text-3xl font-semibold text-primary">{page.comparisonHeading}</h2>
      <p class="text-muted">{page.comparisonIntro}</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {page.comparisonItems.map((item) => (
        <article class="card">
          <h3 class="text-xl font-semibold text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section grid gap-6 md:grid-cols-2">
    <article class="card">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">What happens next</p>
      <h2 class="mt-3 text-2xl font-semibold text-primary">The form starts a private review</h2>
      <p class="mt-3 text-muted">
        Send the address and one way to reach you. ACE can review property condition, title questions, timing, payoff pressure, and whether a cash or flexible structure fits before asking you to make a decision.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={`#${formId}`} class="btn btn-primary">Start with the address</a>
        <a href={page.relatedGuide.href} class="btn btn-outline">{page.relatedGuide.label}</a>
      </div>
    </article>
    <article class="card bg-primary text-white">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent">No fake pressure</p>
      <h2 class="mt-3 text-2xl font-semibold text-white">You can compare, ask questions, and pause</h2>
      <p class="mt-3 text-sm leading-6 text-white/80">
        A landing page should make it easier to reach out, not harder to think. The first conversation is not a contract, and seller details stay private unless you choose to move forward.
      </p>
    </article>
  </section>

  <SellerReviewStrip />

  <section class="section space-y-4">
    <h2 class="text-3xl font-semibold text-primary">{page.eyebrow} FAQ</h2>
    <div class="space-y-3">
      {page.faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
