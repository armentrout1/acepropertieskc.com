---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../lib/siteConfig";
---

<Layout title="Thank You | ACE Properties KC" description="Thanks for reaching out to ACE Properties KC. Aaron will review your property details and follow up using the contact information you provided." canonicalPath="/thank-you/" robots="noindex, follow">
  <section class="space-y-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-secondary">We received your info</p>
    <h1 class="text-4xl font-semibold text-primary">Thanks for reaching out</h1>
    <p class="mx-auto max-w-2xl text-muted">
      {SITE.contactName} at ACE Properties KC will review your property details and follow up using the contact information you provided. Want to talk sooner? Call or text {SITE.phoneDisplay}.
    </p>
  </section>

  <section class="mt-10 grid gap-6 rounded-3xl border border-border/70 bg-white p-6 md:grid-cols-2">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">What happens next</h2>
      <ul class="space-y-2 text-sm text-primary">
        <li>{SITE.contactName} will follow up about the property, using your preferred contact method when provided.</li>
        <li>We ask about condition, timing, and your questions. If a walkthrough would help, we arrange one with you.</li>
        <li>You review written options and choose how to move forward.</li>
      </ul>
    </div>
    <div class="rounded-2xl bg-soft/60 p-5 text-left">
      <p class="text-base font-semibold text-primary">Need to update anything?</p>
      <p class="mt-2 text-sm text-muted">Call, text, or email if you need to correct a detail, share a preferred callback time, or discuss an urgent deadline.</p>
      <div class="mt-4 space-y-2 text-sm">
        <a href={`tel:${SITE.phoneTel}`} class="inline-flex items-center rounded-full bg-secondary px-5 py-2 text-white" data-phone-link="thank_you_page">Call {SITE.phoneDisplay}</a>
        <a href={`sms:${SITE.smsTel}`} class="block text-secondary hover:underline" data-sms-link="thank_you_page">Text {SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`} class="block text-secondary hover:underline" data-email-link="thank_you_page">{SITE.email}</a>
      </div>
    </div>
  </section>

  <section class="mt-10 flex flex-wrap justify-center gap-4">
    <a href="/" class="inline-flex items-center rounded-full bg-secondary px-6 py-3 text-base font-semibold text-white hover:bg-secondary/90">Back to homepage</a>
    <a href={`tel:${SITE.phoneTel}`} class="inline-flex items-center rounded-full border border-primary/20 px-6 py-3 text-base font-semibold text-primary hover:border-primary" data-phone-link="thank_you_page_cta">Call us</a>
  </section>
</Layout>

<script is:inline>
  // Track lead confirmation on page load
  if (typeof window.gtag === 'function') {
    window.gtag('event', 'lead_confirmation', {
      confirmation_type: 'thank_you_page',
      page_path: window.location.pathname,
      page_title: document.title
    });
  }
</script>
