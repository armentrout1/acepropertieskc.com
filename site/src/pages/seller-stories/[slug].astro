---
import Layout from "../../layouts/Layout.astro";
import OfferForm from "../../components/OfferForm.astro";
import { sellerStories, type SellerStory } from "../../data/sellerStories";
import { articleJsonLd, buildBreadcrumbList, localBusinessJsonLd, webSiteJsonLd } from "../../lib/seo";
import { SITE } from "../../lib/siteConfig";

export function getStaticPaths() {
  return sellerStories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props as { story: SellerStory };
const canonicalPath = `/seller-stories/${story.slug}/`;
const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  articleJsonLd({
    title: story.title,
    description: story.seoDescription,
    path: canonicalPath,
    datePublished: "2026-06-20",
  }),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Seller Stories", item: "/seller-stories/" },
    { name: story.title, item: canonicalPath },
  ]),
];
---

<Layout
  title={story.seoTitle}
  description={story.seoDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell grid gap-8 py-14 md:py-20 lg:grid-cols-[1fr_0.86fr] lg:items-center">
      <article class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">{story.eyebrow}</span>
          <span class="v3-pill">{story.location}</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Seller story</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">{story.title}</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">{story.summary}</p>
          <p class="max-w-2xl text-sm leading-6 text-white/70">
            Details are kept privacy-safe unless a seller gives permission to publish more.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {story.tags.map((tag) => (
            <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-bold text-white">{tag}</span>
          ))}
        </div>
      </article>
      <OfferForm
        addressFirst
        formId={`${story.slug}-address-first-form`}
        heading="Does this sound familiar?"
        subheading="Start with the property address. We will help you compare the closest practical options."
        defaultSituation={story.tags[0] ?? "story follow-up"}
        pageContext={`seller_story_${story.slug}`}
      />
    </div>
  </section>

  <section class="section">
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-[1.75rem] border border-border/70 bg-white/90 p-6 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Problem type</p>
        <h2 class="mt-3 text-2xl font-semibold text-primary">{story.eyebrow}</h2>
      </article>
      <article class="rounded-[1.75rem] border border-border/70 bg-white/90 p-6 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Area</p>
        <h2 class="mt-3 text-2xl font-semibold text-primary">{story.location}</h2>
      </article>
      <article class="rounded-[1.75rem] border border-border/70 bg-white/90 p-6 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">ACE focus</p>
        <h2 class="mt-3 text-2xl font-semibold text-primary">Clear options first</h2>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <article class="card bg-white">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">The challenge</p>
        <h2 class="mt-3 text-2xl font-semibold text-primary">Why a normal sale did not fully fit</h2>
        <p class="mt-3 text-muted">{story.challenge}</p>
      </article>
      <article class="card bg-white">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">The ACE approach</p>
        <h2 class="mt-3 text-2xl font-semibold text-primary">Options reviewed before choosing a path</h2>
        <ul class="mt-4 space-y-3 text-sm text-primary">
          {story.approach.map((item) => (
            <li class="flex items-start gap-3 rounded-2xl border border-border/70 bg-soft/60 px-4 py-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-secondary"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section grid gap-6 md:grid-cols-2">
    <article class="card">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Outcome</p>
      <h2 class="mt-3 text-2xl font-semibold text-primary">What changed for the seller</h2>
      <p class="mt-3 text-muted">{story.outcome}</p>
    </article>
    <article class="card">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Privacy note</p>
      <h2 class="mt-3 text-2xl font-semibold text-primary">Real experience, careful details</h2>
      <p class="mt-3 text-muted">{story.privacyNote}</p>
    </article>
  </section>

  <section class="section space-y-6">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Helpful next reads</p>
      <h2 class="text-3xl font-semibold text-primary">Learn before you decide</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {story.relatedLinks.map((link) => (
        <a href={link.href} class="card transition hover:-translate-y-1 hover:border-secondary/60 hover:shadow-lg">
          <span class="text-sm font-semibold text-secondary">{link.label}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
