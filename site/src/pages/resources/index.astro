    category: "Vacant house",
  },
  {
    title: "How Cash Home Buyers Determine an Offer",
    description:
      "A transparent look at comparable sales, repair scope, holding costs, risk, and how to compare an offer against listing.",
    href: "/resources/how-cash-home-buyers-determine-offer-kansas-city/",
