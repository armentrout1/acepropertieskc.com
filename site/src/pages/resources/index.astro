const allResources = [...longTailResourceCards, ...resources];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Resources", item: "/resources/" },
  ]),
];
---

<Layout
  title="Kansas City Home Seller Resources | ACE Properties KC"
  description="Helpful Kansas City home selling guides for as-is sales, inherited houses, repairs, tenants, late payments, payment takeover, and cash offer decisions."
  canonicalPath="/resources/"
  jsonLd={jsonLd}
>
  <section class="section space-y-5">
    <p class="badge">Seller resources</p>
    <h1 class="text-4xl font-semibold text-primary">Kansas City Home Seller Resources</h1>
    <p class="max-w-3xl text-muted">
      Clear, local guides for homeowners deciding whether to list, sell as-is, request a cash offer, or compare payment takeover options. These resources are written for real situations: repairs, inherited houses, tenants, late payments, relocation, and family timelines.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/get-offer/" class="btn btn-primary text-base">Get an offer</a>
      <a href="/solutions/" class="btn btn-ghost text-base">Compare situations</a>
    </div>
  </section>

  <section class="section">
    <div class="grid gap-6 md:grid-cols-2">
      {allResources.map((resource) => (
        <a href={resource.href} class="card h-full transition hover:-translate-y-1 hover:border-secondary/60">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">{resource.category}</p>
          <h2 class="mt-2 text-2xl font-semibold text-primary">{resource.title}</h2>
          <p class="mt-3 text-sm text-muted">{resource.description}</p>
          <span class="mt-5 inline-flex text-sm font-semibold text-secondary">Read guide</span>
        </a>
      ))}
    </div>
  </section>

  <LocalDecisionMap
    variant="general"
    heading="Turn a guide into a local Kansas City next step"
    intro="After you read a guide, narrow the decision by city, county, title timing, and seller situation. These links connect resources to the local pages that matter most."
  />

  <section class="section section-alt">
    <div class="mx-auto max-w-3xl space-y-4 text-center">
      <h2 class="text-3xl font-semibold text-primary">Need an answer before the next guide is published?</h2>
      <p class="text-muted">
        Send the address and what you are trying to solve. We will walk through the practical options and tell you when listing may be better than selling directly.
      </p>
      <a href="/get-offer/" class="btn btn-primary text-base">Start the offer conversation</a>
    </div>
  </section>
</Layout>
