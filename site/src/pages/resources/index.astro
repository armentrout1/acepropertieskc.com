    category: "County process",
  },
  {
    title: "Kansas City Inherited House Checklist",
    description:
      "A scannable checklist for heirs covering authority, documents, belongings, condition, costs, and sale decisions.",
    href: "/resources/kansas-city-inherited-house-checklist/",
    category: "Checklist",
