---
import Layout from "../../../layouts/Layout.astro";
import OfferForm from "../../../components/OfferForm.astro";
import { buildBreadcrumbList, faqJsonLd, localBusinessJsonLd, webSiteJsonLd } from "../../../lib/seo";

const zipLinks = [
  { label: "64113", href: "/areas/64113/", note: "Brookside and Crestwood, older high-equity homes, estates, privacy" },
  { label: "64114", href: "/areas/64114/", note: "Waldo and Ward Parkway, dated homes, downsizing, inherited houses" },
  { label: "64145", href: "/areas/64145/", note: "South KC, higher equity, estate and relocation timelines" },
  { label: "66204", href: "/areas/66204/", note: "Central Overland Park, older Johnson County homes" },
  { label: "66205", href: "/areas/66205/", note: "Mission, Fairway, Westwood, Prairie Village edge" },
  { label: "66206", href: "/areas/66206/", note: "Prairie Village and Leawood equity with dated-condition opportunities" },
  { label: "66212", href: "/areas/66212/", note: "Central Overland Park, inherited and dated homes" },
];

const faqs = [
  {
    question: "What makes this different from the as-is ZIP guide?",
    answer:
      "This guide is about fewer but stronger opportunities. These sellers may have equity and good locations, but still need help with repairs, inheritance, privacy, timing, or a quiet comparison before listing.",
  },
  {
    question: "Should sellers in these ZIPs always sell directly?",
    answer:
      "No. Many quality-area homes should be compared against the MLS. ACE can help sellers compare repair costs, commissions, carrying costs, certainty, and net proceeds.",
  },
  {
    question: "What seller situations fit these areas best?",
    answer:
      "Inherited homes, dated houses, downsizing, trust-owned property, private sales, flexible possession, and owners who want certainty without months of prep.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Resources", item: "/resources/" },
    { name: "Higher-equity home sale options", item: "/resources/kansas-city-higher-equity-home-sale-options/" },
  ]),
];
---

<Layout
  title="Kansas City Higher-Equity Home Sale Options | ACE Properties KC"
  description="Kansas City higher-equity ZIP guide for inherited homes, dated houses, repairs, privacy, and flexible sale timelines."
  canonicalPath="/resources/kansas-city-higher-equity-home-sale-options/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.82fr] lg:items-start">
    <div class="space-y-5">
      <p class="badge">Higher-equity home sale guide</p>
      <h1 class="text-4xl font-black leading-tight text-primary md:text-5xl">Kansas City ZIPs Where a Private Sale May Still Make Sense</h1>
      <p class="text-lg leading-8 text-muted">
        This guide is for higher-equity sellers: fewer sellers, but better locations, stronger upside, and situations where a direct buyer can help with privacy, estate timing, dated condition, clean-out, repairs, or flexible possession.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn btn-primary text-base">Compare my net</a>
        <a href="/resources/kansas-city-as-is-seller-zip-codes/" class="btn btn-ghost text-base">See as-is ZIP guide</a>
      </div>
    </div>
    <OfferForm
      compact
      formId="higher-equity-zip-guide-form"
      heading="Review a high-equity property"
      subheading="Send the address and whether privacy, repairs, inheritance, or timing is the main issue."
    />
  </section>

  <section class="section section-alt space-y-6">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Higher-equity ZIPs</p>
      <h2 class="text-3xl font-black text-primary">Where one good lead can matter more</h2>
      <p class="text-muted">
        These pages should rank for sellers who are not necessarily distressed, but who still need a practical as-is option because listing prep, estate decisions, privacy, or possession timing is the real friction.
      </p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {zipLinks.map((zip) => (
        <a href={zip.href} class="rounded-[1.25rem] border border-border bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-secondary/60 hover:shadow-lg">
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Higher-equity ZIP</p>
          <h2 class="mt-2 text-3xl font-black text-primary">{zip.label}</h2>
          <p class="mt-2 text-sm leading-6 text-muted">{zip.note}</p>
          <span class="mt-4 inline-flex text-sm font-bold text-secondary">Open area page</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section grid gap-6 lg:grid-cols-3">
    <article class="card">
      <p class="text-sm font-black uppercase tracking-[0.1em] text-secondary">Best search intent</p>
      <h2 class="mt-2 text-2xl font-black text-primary">Equity plus friction</h2>
      <p class="mt-3 text-muted">Inherited houses, dated homes, trust sales, downsizing, quiet sale requests, and owners comparing a cash buyer to the MLS.</p>
    </article>
    <article class="card">
      <p class="text-sm font-black uppercase tracking-[0.1em] text-secondary">Best offer angle</p>
      <h2 class="mt-2 text-2xl font-black text-primary">Net sheet, not lowball</h2>
      <p class="mt-3 text-muted">These sellers need a credible comparison: repair costs, commissions, holding costs, seller concessions, certainty, and timing.</p>
    </article>
    <article class="card">
      <p class="text-sm font-black uppercase tracking-[0.1em] text-secondary">Best trust angle</p>
      <h2 class="mt-2 text-2xl font-black text-primary">Tell them listing may win</h2>
      <p class="mt-3 text-muted">A quality seller trusts ACE faster when we plainly say the MLS may be better if the home is updated and time is flexible.</p>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-black text-primary">Higher-equity ZIP FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

