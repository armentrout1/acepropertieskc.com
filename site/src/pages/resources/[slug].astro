---
import Layout from "../../layouts/Layout.astro";
import CallAceCta from "../../components/CallAceCta.astro";
import CreativePromisePanel from "../../components/CreativePromisePanel.astro";
import HighIntentOfferBlock from "../../components/HighIntentOfferBlock.astro";
import LocalDecisionMap from "../../components/LocalDecisionMap.astro";
import type { LongTailResourcePage } from "../../data/longTailResources";
import { longTailResourcePages } from "../../data/longTailResources";
import {
  articleJsonLd,
  buildBreadcrumbList,
  buildFaqPageJsonLd,
  localBusinessJsonLd,
  webSiteJsonLd,
} from "../../lib/seo";

export function getStaticPaths() {
  return longTailResourcePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: LongTailResourcePage };
const canonicalPath = `/resources/${page.slug}/`;
const formId = `${page.slug}-form`;

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  articleJsonLd({
    title: page.headline,
    description: page.description,
    path: canonicalPath,
    datePublished: "2026-06-20",
  }),
  buildFaqPageJsonLd(page.faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Resources", item: "/resources/" },
    { name: page.headline, item: canonicalPath },
  ]),
];
---

<Layout
  title={page.title}
  description={page.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <article class="section space-y-10">
    <header class="space-y-5">
      <p class="badge">{page.badge}</p>
      <h1 class="text-4xl font-semibold text-primary md:text-5xl">{page.headline}</h1>
      <p class="max-w-3xl text-lg leading-8 text-muted">{page.intro}</p>
      <div class="flex flex-wrap gap-3">
        <a href={page.primaryCta.href} class="btn btn-primary text-base">{page.primaryCta.label}</a>
        {page.secondaryCta && (
          <a href={page.secondaryCta.href} class="btn btn-ghost text-base">{page.secondaryCta.label}</a>
        )}
      </div>
    </header>

    <section class="card bg-soft/70">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Quick answer</p>
      <h2 class="mt-2 text-2xl font-semibold text-primary">{page.quickAnswer.title}</h2>
      <p class="mt-3 text-muted">{page.quickAnswer.body}</p>
      <ul class="mt-5 grid gap-3 text-sm text-primary md:grid-cols-2">
        {page.quickAnswer.bullets.map((item) => (
          <li class="flex items-start gap-3 rounded-md border border-border bg-white p-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <CallAceCta
      heading="Want ACE to make this easier?"
      body="If this sounds like your property situation, call or text the address. We can review the timeline, title questions, repairs, clean-out, payoff pressure, and whether a cash or flexible option makes sense."
      phoneLabel="Call ACE now"
      smsLabel="Text the property address"
      offerLabel={page.primaryCta.label}
      offerHref={page.primaryCta.href}
      trackingLocation={`${page.slug}_easy_button`}
    />

    {page.storySlug && (
      <CreativePromisePanel
        eyebrow="Creative ACE Promise"
        heading="Compare the clean path and the creative path before deciding"
        intro="ACE uses creative options only when they solve a real seller problem. Cash, listing, payoff, and payment structures should all be compared in plain English."
        storySlug={page.storySlug}
        primaryLabel={page.primaryCta.label}
        primaryHref={`#${formId}`}
        trackingLocation={`${page.slug}_creative_promise`}
      />
    )}

    <section class="grid gap-6 md:grid-cols-3">
      {page.sections.map((section) => (
        <article class="card space-y-3">
          {section.eyebrow && (
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">{section.eyebrow}</p>
          )}
          <h2 class="text-2xl font-semibold text-primary">{section.title}</h2>
          <p class="text-sm leading-6 text-muted">{section.body}</p>
          {section.bullets && (
            <ul class="space-y-2 text-sm text-primary">
              {section.bullets.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-secondary"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </section>

    {page.comparison && (
      <section class="space-y-4">
        <div class="space-y-2">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Compare paths</p>
          <h2 class="text-3xl font-semibold text-primary">{page.comparison.heading}</h2>
          <p class="max-w-3xl text-muted">{page.comparison.intro}</p>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {page.comparison.items.map((item) => (
            <article class="card">
              <h3 class="text-xl font-semibold text-primary">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.checklist && (
      <section class="card bg-soft/70">
        <h2 class="text-2xl font-semibold text-primary">{page.checklist.heading}</h2>
        <ul class="mt-5 grid gap-3 text-sm text-primary md:grid-cols-2">
          {page.checklist.items.map((item) => (
            <li class="flex items-start gap-3 rounded-md border border-border bg-white p-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <HighIntentOfferBlock
      badge={page.offerBlock.badge}
      title={page.offerBlock.title}
      body={page.offerBlock.body}
      points={page.offerBlock.points}
      formId={formId}
      formHeading={page.offerBlock.formHeading}
      formSubheading="Start with the address and one way to reach you."
      defaultSituation={page.offerBlock.defaultSituation}
      pageContext={`resource:${page.slug}`}
      trackingLocation={page.slug}
    />

    <LocalDecisionMap
      variant={page.decisionVariant}
      heading="Connect this guide to the right Kansas City next step"
      intro="Use local area, county, and situation pages to compare timeline, title, repairs, payment pressure, and whether a direct or creative option fits."
    />

    <section class="space-y-4">
      <h2 class="text-3xl font-semibold text-primary">{page.headline} FAQ</h2>
      <div class="space-y-3">
        {page.faqs.map((faq) => (
          <details class="card">
            <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
            <p class="mt-2 text-sm leading-6 text-muted">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </article>
</Layout>
