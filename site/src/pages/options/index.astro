---
import Layout from "../../layouts/Layout.astro";
import CreativePromisePanel from "../../components/CreativePromisePanel.astro";
import OfferForm from "../../components/OfferForm.astro";
import { SITE } from "../../lib/siteConfig";
import { webSiteJsonLd, localBusinessJsonLd, buildFaqPageJsonLd } from "../../lib/seo";

const fitItems = [
  "You are behind or worried you may fall behind on mortgage payments",
  "The mortgage balance makes a normal cash sale hard to structure",
  "You want to move without bringing money to closing if the numbers allow",
  "You want a written comparison to review with family, partners, or advisors",
];

const safeguardItems = [
  "Payment expectations are written out before anything is signed",
  "Title, insurance, taxes, arrears, and lender deadlines are reviewed up front",
  "You can ask how payments will be verified each month",
  "We encourage attorney, CPA, lender, or housing counselor review before signing",
];

const optionCards = [
  {
    label: "Cash offer",
    title: "Fast as-is purchase",
    body:
      "Best when speed, simplicity, and certainty matter more than testing the retail market. ACE reviews repairs, clean-out, title, payoff, and timeline before putting numbers in front of you.",
    points: ["No repairs first", "No showings", "Clear closing timeline"],
  },
  {
    label: "Creative option",
    title: "Payment-takeover review",
    body:
      "Best when the existing mortgage, payoff, or monthly payment is the real pressure point. We can review whether a subject-to style structure may fit and explain the trade-offs plainly.",
    points: ["Loan pressure reviewed", "Terms in writing", "Advisor review encouraged"],
  },
  {
    label: "Direct buyer",
    title: "Prepared to close",
    body:
      "Best when you want to know who is actually buying. ACE has been buying houses directly from sellers since 2016 and is not built around making you wait for another investor to appear.",
    points: ["Direct buyer", "Since 2016", "No assignment-first pitch"],
  },
];

const pressureReliefItems = [
  {
    title: "Catch-up items",
    body:
      "Back payments, taxes, HOA balances, insurance, utilities, or other title items can often be reviewed with the closing team and paid through closing when the numbers allow.",
  },
  {
    title: "Credit-risk timing",
    body:
      "A sale or takeover review may help avoid additional damage from more missed payments or a completed foreclosure, but it does not erase past late marks and should be reviewed carefully.",
  },
  {
    title: "Equity protection",
    body:
      "When repairs, commissions, and delay would eat up the remaining equity, we compare whether an as-is path preserves more certainty than waiting.",
  },
  {
    title: "Leave the hard stuff",
    body:
      "Furniture, debris, repairs, clean-out, inspections, roof work, yard cleanup, and code follow-up can be included in the as-is conversation instead of becoming your next project.",
  },
];

const faqs = [
  {
    question: "What does a payment takeover option mean?",
    answer:
      "In some situations, ACE Properties KC may be able to buy the house while the existing loan stays in place and we step in to make the monthly payments. This is often called a subject-to structure and must be reviewed carefully.",
  },
  {
    question: "Can this help protect my credit?",
    answer:
      "It may help reduce further credit damage if it prevents additional missed payments or a completed foreclosure, but it does not erase late marks that already happened. Sellers should review credit, legal, and loan questions with qualified advisors.",
  },
  {
    question: "Is payment takeover right for every seller?",
    answer:
      "No. Loan terms, arrears, equity, deadlines, insurance, taxes, and seller risk all matter. We compare it with a cash offer and payoff-at-closing so you can decide what fits.",
  },
];

const jsonLd = [webSiteJsonLd(), localBusinessJsonLd(), buildFaqPageJsonLd(faqs)];
---

<Layout
  title="Cash or Payment Takeover Options | ACE Properties KC"
  description="Compare cash offers and payment takeover options for your Kansas City house, including subject-to structures for sellers behind on mortgage payments."
  canonicalPath="/options/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell grid gap-10 py-14 md:py-20 lg:grid-cols-[1fr_0.92fr] lg:items-center">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Cash offer</span>
          <span class="v3-pill">Payment takeover review</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="max-w-4xl space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Cash plus creative options</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">
            Compare a Cash Offer With Creative Payment Options
          </h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            If the monthly payment, payoff, repairs, or timing are the hard part, a straight cash offer is not always the only path to review.
          </p>
          <p class="max-w-3xl text-base leading-7 text-white/72">
            ACE can compare an as-is cash purchase with payment-takeover or payoff-at-closing structures when the numbers and risk make sense.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`tel:${SITE.phoneTel}`} class="btn bg-white text-primary hover:bg-white/90" data-phone-link="options_hero">
            Call {SITE.phoneDisplay}
          </a>
          <a href="/direct-buyer-vs-wholesaler/" class="btn border border-white/40 text-white hover:bg-white/10">
            Why direct buyer matters
          </a>
        </div>
      </div>
      <OfferForm
        addressFirst
        formId="options-address-first-form"
        heading="Start with the address"
        subheading="We will ask for your contact on the next step and then compare cash and creative paths."
        defaultSituation="payment takeover"
        pageContext="options_v3_address_first"
      />
    </div>
  </section>

  <CreativePromisePanel
    eyebrow="Cash plus creative options"
    heading="Compare the cleanest way out before choosing"
    intro="A direct cash offer may be the right answer. If the mortgage, payoff, timing, or repair burden makes that hard, ACE can also review creative payment structures and explain the trade-offs before you sign."
    primaryLabel="Start my options review"
    trackingLocation="options_creative_promise"
  />

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Choose the path that fits the problem</p>
      <h2 class="text-3xl font-black text-primary">A good offer should make the next step easier to understand</h2>
      <p class="text-muted">
        Some sellers need a clean cash sale. Others need to protect timing, payment history, or remaining equity. ACE lays out the differences before asking you to commit.
      </p>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {optionCards.map((item) => (
        <article class="rounded-[1.75rem] border border-border/60 bg-white p-6 shadow-sm">
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">{item.label}</p>
          <h3 class="mt-3 text-2xl font-black text-primary">{item.title}</h3>
          <p class="mt-3 text-sm leading-6 text-muted">{item.body}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {item.points.map((point) => (
              <li class="rounded-full bg-soft px-3 py-1.5 text-xs font-bold text-primary">{point}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="max-w-4xl text-xs leading-5 text-muted">
      Disclosure: Payment takeover and subject-to agreements can affect credit, taxes, insurance, and mortgage terms. Please consult your attorney, lender, CPA, or housing counselor before signing.
    </p>
  </section>

  <section class="section section-alt space-y-6">
    <div class="max-w-3xl space-y-3">
      <p class="badge">What we compare</p>
      <h2 class="text-3xl font-black text-primary">The right path depends on the pressure point</h2>
      <p class="text-muted">
        We look at the deadline, payoff, repairs, taxes, remaining equity, and what you need to happen next.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {pressureReliefItems.map((item) => (
        <article class="rounded-[1.5rem] border border-border/60 bg-white p-5 shadow-sm">
          <h3 class="text-xl font-black text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section grid gap-6 lg:grid-cols-2">
    <article class="rounded-[2rem] border border-border/60 bg-white p-6 shadow-sm md:p-8">
      <p class="badge">When creative may fit</p>
      <h2 class="mt-4 text-3xl font-black text-primary">Payment takeover is a tool, not a magic answer</h2>
      <p class="mt-3 text-muted">
        We only want this conversation when it fits the loan, timeline, seller risk, and property numbers.
      </p>
      <ul class="mt-5 grid gap-3">
        {fitItems.map((item) => (
          <li class="rounded-[1.15rem] bg-cream p-4 text-sm font-bold leading-6 text-primary">{item}</li>
        ))}
      </ul>
    </article>
    <article class="rounded-[2rem] border border-border/60 bg-primary p-6 text-white shadow-sm md:p-8">
      <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Guardrails</p>
      <h2 class="mt-4 text-3xl font-black text-white">The terms should be clear before you decide</h2>
      <ul class="mt-5 grid gap-3">
        {safeguardItems.map((item) => (
          <li class="rounded-[1.15rem] bg-white/92 p-4 text-sm font-bold leading-6 text-primary">{item}</li>
        ))}
      </ul>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Payment takeover FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
    <div class="flex flex-wrap gap-4 pt-4">
      <a href="/get-offer/" class="btn btn-primary text-base">Start with the offer form</a>
      <a href="/resources/sell-house-as-is-kansas-city/" class="btn btn-ghost text-base">Read the as-is guide</a>
      <a href="/contact/" class="btn btn-outline text-base">Talk with us directly</a>
    </div>
  </section>
</Layout>
