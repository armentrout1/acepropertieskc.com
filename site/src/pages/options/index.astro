---
import Layout from "../../layouts/Layout.astro";
import CallAceCta from "../../components/CallAceCta.astro";
import OfferForm from "../../components/OfferForm.astro";
import RealPropertyProof from "../../components/RealPropertyProof.astro";
import SellerReviewStrip from "../../components/SellerReviewStrip.astro";
import { SITE } from "../../lib/siteConfig";
import { webSiteJsonLd, localBusinessJsonLd, buildFaqPageJsonLd } from "../../lib/seo";

const optionPaths = [
  {
    number: "Option 1",
    label: "Cash offer",
    title: "Sell the house as-is for cash",
    bestFor:
      "You want the cleanest sale possible: no repairs, no showings, no appraiser repair list, and a clear closing date.",
    whatAceCanDo: [
      "Review the house in its current condition",
      "Make a written as-is cash offer",
      "Work through title, payoff, taxes, and closing timing",
      "Let you compare the net number against listing with an agent",
    ],
    askBefore:
      "Ask what costs are included, who pays closing costs, what happens if title finds a problem, and how fast closing can realistically happen.",
    keywords: "Can I sell my house fast for cash? Can I sell as-is without repairs?",
  },
  {
    number: "Option 2",
    label: "Payment takeover",
    title: "See if ACE can take over the monthly payment",
    bestFor:
      "The monthly mortgage payment is the real problem, the payoff is tight, or a normal cash offer would not solve enough.",
    whatAceCanDo: [
      "Review the loan balance, payment amount, arrears, taxes, and insurance",
      "Explain whether a subject-to style structure may fit",
      "Put payment expectations and verification details in writing",
      "Encourage attorney, CPA, lender, or housing counselor review before signing",
    ],
    askBefore:
      "Ask how payments are verified, who handles insurance and taxes, what happens if something goes wrong, and what risk remains tied to the existing loan.",
    keywords: "Can someone take over my mortgage payment? What if I am behind?",
  },
  {
    number: "Option 3",
    label: "Payoffs handled",
    title: "Use closing to deal with back taxes, arrears, or liens",
    bestFor:
      "You have equity, but back payments, tax balances, HOA items, utility balances, code bills, or title issues are making the sale stressful.",
    whatAceCanDo: [
      "Review known payoff items before giving you a number",
      "Coordinate with a title company on taxes, liens, and mortgage payoff",
      "Show how those items affect your estimated net proceeds",
      "Move quickly when title can confirm the file is clear enough to close",
    ],
    askBefore:
      "Ask what must be paid before or at closing, what title still needs, and whether there is enough equity to leave you with money after payoffs.",
    keywords: "Can back taxes, liens, or arrears be handled at closing?",
  },
  {
    number: "Option 4",
    label: "Leave repairs behind",
    title: "Sell with repairs, clean-out, or belongings still there",
    bestFor:
      "The house needs work, rooms are full, a tenant left damage, the yard is behind, or you do not want to spend weekends getting it ready.",
    whatAceCanDo: [
      "Review repairs, clean-out, contents, yard work, and unfinished projects as part of the offer",
      "Buy without requiring you to replace the roof, paint, clean, or stage the house",
      "Set expectations for walkthrough access and closing timeline",
      "Help compare whether fixing things first is actually worth it",
    ],
    askBefore:
      "Ask what can stay, what should be removed, whether photos are enough to start, and how clean-out affects the offer.",
    keywords: "Can I sell with repairs, belongings, or clean-out still needed?",
  },
];

const comparisonRows = [
  {
    factor: "Fastest clean sale",
    cash: "Usually strongest",
    takeover: "Possible, but documentation matters",
    payoff: "Depends on title and payoff statements",
    asIs: "Strong when access and title are ready",
  },
  {
    factor: "Repairs or clean-out",
    cash: "Included in the offer math",
    takeover: "Reviewed with the payment plan",
    payoff: "Can reduce net proceeds",
    asIs: "Designed for this situation",
  },
  {
    factor: "Behind on payments",
    cash: "Can work if payoff fits",
    takeover: "Worth comparing carefully",
    payoff: "Often part of the closing plan",
    asIs: "Can still work with enough time",
  },
  {
    factor: "Seller risk to review",
    cash: "Usually lowest after closing",
    takeover: "Highest; must be clear in writing",
    payoff: "Title and net number must be clear",
    asIs: "Condition assumptions should be written",
  },
];

const processSteps = [
  {
    title: "Send the address",
    body: "Start with the property address and what you are trying to solve. Photos, payment details, or deadline notices can help, but they are not required for the first conversation.",
  },
  {
    title: "We compare paths",
    body: "ACE reviews the house, payoff, timing, repairs, and seller priorities so you can see whether cash, payment takeover, payoff-at-closing, or an as-is clean-out option makes sense.",
  },
  {
    title: "You get plain next steps",
    body: "If there is a fit, the terms should be written clearly enough to review with family, title, a lender, an attorney, a CPA, or a housing counselor before you decide.",
  },
];

const faqs = [
  {
    question: "What are my options if I need to sell a Kansas City house fast?",
    answer:
      "The main options to compare are a direct cash offer, a payment takeover review, a payoff-at-closing sale, or an as-is sale where repairs and clean-out are included in the offer. The best fit depends on payoff, equity, condition, deadlines, and seller risk.",
  },
  {
    question: "What does it mean for ACE to take over payments?",
    answer:
      "In some situations, ACE Properties KC may be able to buy the house while the existing loan stays in place and we step in to make the monthly payments. This is often called a subject-to structure. It needs careful written terms and advisor review because the seller may remain tied to the loan.",
  },
  {
    question: "Can selling help if I am behind on payments or worried about foreclosure?",
    answer:
      "It may help if there is enough time to review title, payoff, arrears, and closing options. A sale or payment takeover review may reduce additional missed-payment pressure, but it does not erase late payments that already happened and it is not legal or financial advice.",
  },
  {
    question: "Do I need to clean out or repair the house first?",
    answer:
      "No. You can ask ACE to review the house as-is. Furniture, belongings, old finishes, repairs, yard work, roof issues, tenant damage, or unfinished projects can be discussed before you spend money preparing the property.",
  },
  {
    question: "Is the first conversation a contract?",
    answer:
      "No. The first conversation is an options review. You can ask questions, compare the paths, and decide whether any offer or structure is worth reviewing further.",
  },
];

const jsonLd = [webSiteJsonLd(), localBusinessJsonLd(), buildFaqPageJsonLd(faqs)];
---

<Layout
  title="KC Home Selling Options | Cash, As-Is, Payment Takeover"
  description="Compare ways to sell your Kansas City house: cash offer, payment takeover, payoff-at-closing, or as-is sale with repairs and clean-out included."
  canonicalPath="/options/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell grid gap-8 py-12 md:py-16 lg:grid-cols-[1fr_0.88fr] lg:items-center">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Cash offer</span>
          <span class="v3-pill">Payment takeover</span>
          <span class="v3-pill">Sell as-is</span>
        </div>
        <div class="max-w-4xl space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Kansas City house selling options</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">
            Compare Ways to Sell Your Kansas City House
          </h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            If a normal listing feels too slow, expensive, or uncertain, compare the practical options: cash offer, payment takeover review, payoff-at-closing, or selling as-is with repairs and clean-out included.
          </p>
          <p class="max-w-3xl text-base leading-7 text-white/72">
            ACE Properties KC buys houses directly. The goal is simple: understand what you need solved first, then show the path that fits the property and your timeline.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#compare-options" class="btn bg-white text-primary hover:bg-white/90">Compare options</a>
          <a href={`tel:${SITE.phoneTel}`} class="btn border border-white/40 text-white hover:bg-white/10" data-phone-link="options_hero">
            Call {SITE.phoneDisplay}
          </a>
        </div>
      </div>
      <OfferForm
        addressFirst
        formId="options-address-first-form"
        heading="Start with the address"
        subheading="We will ask for phone or email on the next step, then compare the selling options that may fit."
        defaultSituation="payment takeover"
        pageContext="options_decision_page"
        buttonLabel="See my options"
      />
    </div>
  </section>

  <section id="compare-options" class="section scroll-mt-32 space-y-7">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Choose the path you want to understand</p>
      <h2 class="text-3xl font-black leading-tight text-primary md:text-4xl">
        These are the four options most Kansas City sellers ask us to compare
      </h2>
      <p class="text-muted">
        Tap any option to see when it fits, what ACE can do, and what questions you should ask before deciding. Nothing here is a contract. It is a plain-English starting point.
      </p>
    </div>

    <div class="grid gap-4">
      {optionPaths.map((option, index) => (
        <details class="group rounded-[1.5rem] border border-border/70 bg-white p-5 shadow-sm open:border-secondary/35 open:shadow-md" open={index === 0}>
          <summary class="flex cursor-pointer list-none flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-secondary px-3 py-1 text-xs font-black uppercase tracking-[0.08em] text-white">
                  {option.number}
                </span>
                <span class="text-xs font-black uppercase tracking-[0.08em] text-secondary">{option.label}</span>
              </div>
              <h3 class="text-2xl font-black text-primary">{option.title}</h3>
              <p class="max-w-3xl text-sm leading-6 text-muted">{option.bestFor}</p>
            </div>
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-border bg-soft text-xl font-black text-primary transition group-open:rotate-45">
              +
            </span>
          </summary>

          <div class="mt-5 grid gap-4 border-t border-border/70 pt-5 lg:grid-cols-[1.05fr_1fr_0.95fr]">
            <div class="rounded-[1.25rem] bg-soft p-4">
              <p class="text-xs font-black uppercase tracking-[0.08em] text-secondary">What ACE can review</p>
              <ul class="mt-3 grid gap-2 text-sm leading-6 text-primary">
                {option.whatAceCanDo.map((point) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-secondary"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-[1.25rem] border border-border/60 bg-white p-4">
              <p class="text-xs font-black uppercase tracking-[0.08em] text-secondary">Ask before deciding</p>
              <p class="mt-3 text-sm leading-6 text-muted">{option.askBefore}</p>
            </div>
            <div class="rounded-[1.25rem] bg-primary p-4 text-white">
              <p class="text-xs font-black uppercase tracking-[0.08em] text-accent">Questions this option answers</p>
              <p class="mt-3 text-sm leading-6 text-white/82">{option.keywords}</p>
              <a href="#options-address-first-form" class="mt-4 inline-flex text-sm font-black text-accent underline" data-offer-jump>
                Ask about this option
              </a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="section section-alt space-y-6">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Side-by-side comparison</p>
      <h2 class="text-3xl font-black text-primary">The better option depends on what needs to be solved first</h2>
      <p class="text-muted">
        This is the quick version. The actual answer depends on title, loan payoff, taxes, repairs, seller timeline, and how much risk you are comfortable with.
      </p>
    </div>

    <div class="overflow-hidden rounded-[1.5rem] border border-border/70 bg-white shadow-sm">
      <div class="hidden grid-cols-[1fr_repeat(4,minmax(0,1fr))] border-b border-border bg-primary text-sm font-black uppercase tracking-[0.06em] text-white lg:grid">
        <div class="p-4">What matters</div>
        <div class="p-4">Cash offer</div>
        <div class="p-4">Payment takeover</div>
        <div class="p-4">Payoffs handled</div>
        <div class="p-4">Sell as-is</div>
      </div>
      <div class="divide-y divide-border/70">
        {comparisonRows.map((row) => (
          <div class="grid gap-3 p-4 text-sm lg:grid-cols-[1fr_repeat(4,minmax(0,1fr))] lg:gap-0 lg:p-0">
            <div class="font-black text-primary lg:p-4">{row.factor}</div>
            <div class="rounded-xl bg-soft p-3 text-muted lg:rounded-none lg:bg-transparent lg:p-4">{row.cash}</div>
            <div class="rounded-xl bg-soft p-3 text-muted lg:rounded-none lg:bg-transparent lg:p-4">{row.takeover}</div>
            <div class="rounded-xl bg-soft p-3 text-muted lg:rounded-none lg:bg-transparent lg:p-4">{row.payoff}</div>
            <div class="rounded-xl bg-soft p-3 text-muted lg:rounded-none lg:bg-transparent lg:p-4">{row.asIs}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">Simple process</p>
      <h2 class="text-3xl font-black leading-tight text-primary">How the options review works</h2>
      <p class="text-muted">
        We do not need the house to be perfect, cleaned out, or listed-ready. We need enough information to compare the choices honestly.
      </p>
      <CallAceCta
        eyebrow="Want the easy button?"
        heading="Call ACE and ask which option fits."
        body="Tell us the address and what is going on. We can explain whether cash, payment takeover, payoff-at-closing, or an as-is sale is worth reviewing."
        trackingLocation="options_easy_button"
      />
    </div>

    <div class="grid gap-4">
      {processSteps.map((step, index) => (
        <article class="rounded-[1.5rem] border border-border/70 bg-white p-5 shadow-sm">
          <p class="text-xs font-black uppercase tracking-[0.08em] text-secondary">Step {index + 1}</p>
          <h3 class="mt-2 text-2xl font-black text-primary">{step.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{step.body}</p>
        </article>
      ))}
      <p class="rounded-[1.25rem] border border-secondary/20 bg-soft p-4 text-xs leading-5 text-muted">
        Disclosure: ACE Properties KC is not a law firm, lender, credit repair company, or financial advisor. Payment takeover and subject-to agreements can involve loan, tax, insurance, and credit risk. Review any agreement with qualified advisors before signing.
      </p>
    </div>
  </section>

  <SellerReviewStrip
    heading="A real Google review from a seller ACE helped"
    intro="Trust matters when a seller is comparing cash and creative options. This approved review is linked back to Google so visitors can verify the source."
  />

  <RealPropertyProof
    eyebrow="Real local property proof"
    heading="These options are for real houses with real complications."
    intro="Repairs, belongings, unfinished work, tight payoffs, vacant-house risk, and timing problems can all be reviewed before a seller spends money preparing the house."
  />

  <section class="section space-y-4">
    <div class="max-w-3xl space-y-3">
      <p class="badge">FAQ</p>
      <h2 class="text-3xl font-black text-primary">Questions sellers ask before choosing an option</h2>
    </div>
    <div class="grid gap-3">
      {faqs.map((faq) => (
        <details class="rounded-[1.25rem] border border-border/70 bg-white p-5 shadow-sm">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-3 text-sm leading-6 text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
    <div class="flex flex-wrap gap-4 pt-4">
      <a href="#options-address-first-form" class="btn btn-primary text-base" data-offer-jump>Start with my address</a>
      <a href="/resources/subject-to-real-estate-kansas-city/" class="btn btn-ghost text-base">Read payment takeover guide</a>
      <a href="/resources/sell-house-as-is-kansas-city/" class="btn btn-outline text-base">Read as-is guide</a>
    </div>
  </section>
</Layout>