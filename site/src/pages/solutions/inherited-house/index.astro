---
import Layout from "../../../layouts/Layout.astro";
import CreativePromisePanel from "../../../components/CreativePromisePanel.astro";
import HighIntentOfferBlock from "../../../components/HighIntentOfferBlock.astro";
import LocalDecisionMap from "../../../components/LocalDecisionMap.astro";
import { SITE } from "../../../lib/siteConfig";
import { webSiteJsonLd, localBusinessJsonLd, buildFaqPageJsonLd, buildBreadcrumbList, serviceJsonLd } from "../../../lib/seo";

const checklist = [
  "Confirm every heir, trustee, or personal representative who needs to authorize the sale.",
  "Gather the death certificate, letters testamentary, or small-estate affidavits that the title company will request.",
  "Document the property condition with photos so out-of-town family members can weigh in without flying back to Kansas City.",
  "List out any mortgages, taxes, HOA dues, or utilities that must be settled at closing.",
  "Decide whether personal belongings stay with the house or need a clean-out crew (we can coordinate either).",
];

const steps = [
  {
    title: "Share the story",
    body:
      "We talk through how the property was inherited, who needs to sign, and what timeline the family prefers. Expect calm questions, not pressure." ,
  },
  {
    title: "Walkthrough + paperwork",
    body:
      "We schedule a respectful walkthrough (or video), note repairs, photograph contents if helpful, and coordinate with your attorney or probate court so documents stay aligned.",
  },
  {
    title: "Choose the path",
    body:
      "You receive a written comparison of a straightforward cash offer and any flexible option that could preserve income. Every option includes timelines, net sheets, and next steps.",
  },
];

const faqs = [
  {
    question: "Can you buy before probate is fully complete?",
    answer:
      "Often, yes. Many Johnson and Jackson County title companies allow us to sign a contract contingent on final probate orders. We coordinate with your attorney to match the court's timeline.",
  },
  {
    question: "What if siblings disagree on the price?",
    answer:
      "Transparency helps. We provide written valuations, contractor bids, and side-by-side options so every heir sees the same information before approving the sale.",
  },
  {
    question: "Do you remove belongings?",
    answer:
      "If the family wants to keep certain items, we tag them during the walkthrough. Anything left can be donated or disposed of after closing; we handle the coordination and cost when agreed to in writing.",
  },
  {
    question: "How are taxes and liens handled?",
    answer:
      "Title pulls a full payoff report covering mortgages, tax balances, and HOA dues. Those amounts are paid from closing proceeds so heirs receive a clean distribution.",
  },
  {
    question: "Can we compare holding the property as a rental instead?",
    answer:
      "Absolutely. We will outline what keeping it as a rental entails and link you to our <a href=\"/options/\" class=\"text-secondary underline\">options page</a> so you can make an informed decision.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: "Sell an Inherited House in Kansas City",
    description:
      "As-is cash and flexible offer support for inherited Kansas City houses, heir coordination, clean-out, repairs, title, and probate timing.",
    path: "/solutions/inherited-house/",
  }),
  buildFaqPageJsonLd(faqs.map((faq) => ({ question: faq.question.replace(/<[^>]+>/g, ""), answer: faq.answer.replace(/<[^>]+>/g, "") }))),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions/" },
    { name: "Sell an Inherited House in Kansas City", item: "/solutions/inherited-house/" },
  ]),
];
---

<Layout
  title="Sell an Inherited House in Kansas City | ACE"
  description="Inherited a Kansas City house? Compare as-is cash and flexible options, coordinate heirs, and get clear next steps without repairs or pressure."
  canonicalPath="/solutions/inherited-house/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell py-14 md:py-20">
      <div class="max-w-5xl space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Inherited house</span>
          <span class="v3-pill">No clean-out required</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Estate and inheritance support</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">Sell an Inherited House in Kansas City Without Remodeling It First</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            Estates come with paperwork, family emotions, contents, repairs, taxes, and title questions. ACE can review the house as-is and help the family compare a direct cash purchase with other practical paths.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#inherited-house-offer-form" class="btn bg-white text-primary hover:bg-white/90">Start inherited-house review</a>
          <a href="/seller-stories/inherited-original-condition-house/" class="btn border border-white/40 text-white hover:bg-white/10">Read a related story</a>
        </div>
      </div>
    </div>
  </section>

  <HighIntentOfferBlock
    badge="Inherited-house review"
    title="Need the family to see clear numbers?"
    body="Send the address and who needs to be involved. We can outline a simple as-is offer, likely title documents, and the decision points before everyone chooses a path."
    points={[
      "Written summary for heirs or advisors",
      "No clean-out required before the first conversation",
      "Flexible timing around probate or estate needs",
      "Cash and flexible options explained side by side",
    ]}
    formId="inherited-house-offer-form"
    formHeading="Start an inherited-house review"
    formSubheading="Share the address and preferred contact method."
    trackingLocation="inherited_house"
  />

  <CreativePromisePanel
    eyebrow="Inherited property options"
    heading="As-is does not have to mean unclear"
    intro="Families can compare a clean cash sale, a delayed closing, clean-out help, and other practical paths without turning the house into a remodel project first."
    storySlug="inherited-original-condition-house"
    primaryLabel="Compare inherited options"
    primaryHref="#inherited-house-offer-form"
    trackingLocation="inherited_house_creative_promise"
  />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">What to expect from us</h2>
      <p class="text-muted">
        You will have one point of contact, same-day updates for designated heirs, and written summaries that out-of-state family members can review without guessing.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Focus on the Kansas City metro</h2>
      <p class="text-muted">
        We buy across <a href="/areas/kansas-city-mo/" class="text-secondary underline">Kansas City</a>, <a href="/areas/overland-park-ks/" class="text-secondary underline">Overland Park</a>, <a href="/areas/independence-mo/" class="text-secondary underline">Independence</a>, <a href="/areas/lees-summit-mo/" class="text-secondary underline">Lee's Summit</a>, and nearby cities, so local title work and closing customs are already familiar.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">Inheritance checklist</h2>
      <p class="text-muted">Use this list to keep communication clear. We can assist with each item if needed.</p>
      <ul class="mt-4 space-y-3 text-sm text-primary">
        {checklist.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">How it works</h2>
      <p class="text-muted">
        Each family moves at a different pace. Some need immediate relief from taxes and maintenance, while others want to coordinate keepsakes before listing or selling. Our process keeps everyone informed without rushing.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <article class="card">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Documents & timeline basics</h2>
      <p class="text-muted">
        Title may need a death certificate, probate orders, HOA statements, payoff letters, and court timing. We create a shared checklist, coordinate with your attorney when authorized, and keep closing flexible when family needs more time.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Internal referrals and resources</h2>
      <p class="text-muted">
        If the family decides to keep the property, we can still share practical referrals. If selling is the better path, compare cash and flexible approaches on the <a href="/options/" class="text-secondary underline">options page</a> or read the <a href="/resources/selling-inherited-house-kansas-city/" class="text-secondary underline">inherited house guide</a>. When belongings are the main blocker, the <a href="/resources/sell-house-full-of-stuff-kansas-city/" class="text-secondary underline">house full of stuff guide</a> explains what can stay.
      </p>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Inherited home FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted" set:html={faq.answer}></p>
        </details>
      ))}
    </div>
  </section>

  <LocalDecisionMap
    variant="estate"
    heading="Connect an inherited house to the right local KC estate path"
    intro="Inherited property decisions depend on county title work, probate status, repairs, clean-out, and where family members are located. Use these local pages before choosing a sale path."
  />

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with the team</a>
    <a href="/areas/" class="btn btn-outline text-base">See areas we buy</a>
  </section>
</Layout>
