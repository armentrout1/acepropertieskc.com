---
import Layout from "../../layouts/Layout.astro";
import LocalDecisionMap from "../../components/LocalDecisionMap.astro";
import OfferForm from "../../components/OfferForm.astro";
import { SITE } from "../../lib/siteConfig";
import { webSiteJsonLd, localBusinessJsonLd } from "../../lib/seo";

const solutions = [
  {
    title: "Sell House Fast",
    body: "Speed and certainty with as-is cash offers.",
    href: "/solutions/sell-house-fast/",
  },
  {
    title: "Inherited House",
    body: "Coordinate siblings, estates, and timelines with calm updates.",
    href: "/solutions/inherited-house/",
  },
  {
    title: "Probate House",
    body: "Court-ready offers for executors navigating probate process.",
    href: "/solutions/probate-house/",
  },
  {
    title: "Vacant House",
    body: "Stop carrying costs and sell empty properties as-is.",
    href: "/solutions/vacant-house/",
  },
  {
    title: "Relocating",
    body: "Sell fast for job transfers with remote coordination.",
    href: "/solutions/relocating/",
  },
  {
    title: "Needs Repairs",
    body: "Skip contractors and let us take on major updates.",
    href: "/solutions/needs-repairs/",
  },
  {
    title: "Divorce",
    body: "Neutral timelines and written agreements for both parties.",
    href: "/solutions/divorce/",
  },
  {
    title: "Tax Lien",
    body: "Compare payoff-at-closing, payment takeover review, or backup sale options before auction clocks run out.",
    href: "/solutions/tax-lien/",
  },
  {
    title: "Pre-Foreclosure",
    body: "Review timelines before auction dates with cash, payoff, or payment takeover options.",
    href: "/solutions/pre-foreclosure/",
  },
  {
    title: "Facing Foreclosure",
    body: "Options and guidance if foreclosure has started or is approaching.",
    href: "/solutions/facing-foreclosure/",
  },
  {
    title: "Late Payments",
    body: "Get clarity on catching up arrears or selling before the loan defaults.",
    href: "/solutions/late-payments/",
  },
  {
    title: "Tenant-Occupied",
    body: "Respect renters while planning a smooth transition.",
    href: "/solutions/tenant-occupied/",
  },
  {
    title: "Behind on Payments",
    body: "Compare lender options, payoff-at-closing, payment takeover, and backup offers before deadlines.",
    href: "/solutions/behind-on-payments/",
  },
];

const principles = [
  {
    title: "Local perspective",
    body:
      "We buy across the Kansas City metro, so we already know the neighborhood nuances, HOA expectations, and title companies best suited for each scenario.",
  },
  {
    title: "Options, not pressure",
    body:
      "Every call includes side-by-side looks at a straightforward cash sale and payment takeover approaches when they may fit. You pick what aligns with your plans.",
  },
  {
    title: "Clear paperwork",
    body:
      "You see timelines, net proceeds, and required documents before signing. We encourage you to loop in advisors for added confidence.",
  },
];

const jsonLd = [webSiteJsonLd(), localBusinessJsonLd()];
---

<Layout
  title="Sell Your House Fast Kansas City - All Situations"
  description="Solutions for probate, inheritance, divorce, foreclosure, repairs, and relocations. Cash offers for any situation in Kansas City metro."
  canonicalPath="/solutions/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell grid gap-10 py-14 md:py-20 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">As-is houses</span>
          <span class="v3-pill">Inherited properties</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="max-w-4xl space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Ways ACE can help</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">Solutions for Selling an As-Is Kansas City House</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            Every homeowner has a different mix of deadlines, repairs, payments, family decisions, and title questions. Start with the situation, then compare a direct cash offer or creative option.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/options/" class="btn bg-white text-primary hover:bg-white/90">Compare cash and creative options</a>
          <a href={`tel:${SITE.phoneTel}`} class="btn border border-white/40 text-white hover:bg-white/10" data-phone-link="solutions_hero">Call {SITE.phoneDisplay}</a>
        </div>
      </div>
      <OfferForm
        addressFirst
        formId="solutions-address-first-form"
        heading="Start with the address"
        subheading="We will ask for contact on the next step, then point you to the right situation path."
        defaultSituation="options review"
        pageContext="solutions_v3_address_first"
      />
    </div>
  </section>

  <section class="section">
    <div class="grid gap-6 md:grid-cols-3">
      {solutions.map((solution) => (
        <a
          href={solution.href}
          class={`rounded-[1.6rem] border border-border/60 bg-white p-6 shadow-sm transition-all ${solution.placeholder ? "opacity-70" : "hover:-translate-y-1 hover:shadow-lg"}`}
        >
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">{solution.placeholder ? "Preview" : "Explore"}</p>
          <h2 class="mt-3 text-2xl font-black text-primary">{solution.title}</h2>
          <p class="mt-2 text-sm leading-6 text-muted">{solution.body}</p>
          {solution.placeholder && (
            <span class="mt-4 inline-flex text-xs uppercase tracking-wide text-primary/70">Full guide coming soon</span>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-6 md:grid-cols-3">
      {principles.map((item) => (
        <article class="card bg-white/90" aria-label={`Principle: ${item.title}`}>
          <h3 class="text-xl font-semibold text-primary">{item.title}</h3>
          <p class="mt-2 text-sm text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Cash vs Payment Takeover Options</h2>
      <p class="text-muted">
        Some sellers want a clean break with a confirmed cash closing in two to three weeks. Others need to know whether someone can step in and take over the monthly payment through a payment takeover structure. Visit our <a href="/options/" class="text-secondary underline">cash or payment takeover options page</a> for deeper comparisons and disclosures about each approach.
      </p>
      <p class="text-muted">
        If you are behind on mortgage payments or trying to avoid foreclosure, start with the <a href="/resources/behind-on-mortgage-options-kansas-city/" class="text-secondary underline">Kansas City mortgage options guide</a> before choosing a sale path.
      </p>
      <p class="text-muted">
        Not sure which path to pick? We will draft both so you can review numbers with family, attorneys, or advisors before saying yes.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Need a different scenario?</h2>
      <p class="text-muted">
        Even if your situation is not listed yet - tenant buyouts, relocation timelines, or commercial conversions - start a conversation. If we are not the right fit, we can refer you to someone who is.
      </p>
      <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    </article>
  </section>

  <LocalDecisionMap
    variant="general"
    heading="Match the situation to your local Kansas City page"
    intro="Start with the seller problem, then narrow by city, county, and timeline. This helps you compare the practical next step before requesting an offer."
  />

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Ready when you are</h2>
    <p class="text-muted">
      Walk through the guides above, explore <a href="/areas/" class="text-secondary underline">areas we buy</a> including <a href="/areas/lees-summit-mo/" class="text-secondary underline">Lee's Summit</a>, <a href="/areas/shawnee-ks/" class="text-secondary underline">Shawnee</a>, and <a href="/areas/lenexa-ks/" class="text-secondary underline">Lenexa</a>, or head straight to the offer form. We respond the same day and make sure you understand every step.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/get-offer/" class="btn btn-primary text-base">Share property details</a>
      <a href="/contact/" class="btn btn-ghost text-base">Talk with the team</a>
    </div>
  </section>
</Layout>
