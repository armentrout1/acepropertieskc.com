            class="card block h-full transition hover:-translate-y-0.5 hover:border-secondary/60 hover:shadow-md"
          >
            <h3 class="text-lg font-semibold text-primary">{route.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{route.body}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-secondary">
              Review this path &rarr;
