---
import Layout from "../../layouts/Layout.astro";
import HighIntentOfferBlock from "../../components/HighIntentOfferBlock.astro";
import { webSiteJsonLd, localBusinessJsonLd, buildFaqPageJsonLd, buildBreadcrumbList, serviceJsonLd } from "../../lib/seo";

const speedReasons = [
  "Sudden job changes or unexpected opportunities",
  "Inherited properties requiring quick decisions",
  "Financial situations requiring fast liquidity",
  "Landlord fatigue from tenant management",
  "Downsizing or life transitions needing simplicity",
];

const situations = [
  "Avoiding costly repairs and renovation projects",
  "Eliminating showings, open houses, and buyer negotiations",
  "Bypassing traditional listing delays and uncertainties",
  "Coordinating with other life changes or relocations",
  "Simplifying complex family or financial situations",
];

const steps = [
  {
    title: "Quick property assessment",
    body: "We evaluate your property and discuss your timeline needs. No repairs required; we work with the house exactly as it stands.",
  },
  {
    title: "Fast cash offer",
    body: "You receive a written cash offer within days. We outline all numbers clearly so you can make informed decisions quickly.",
  },
  {
    title: "Flexible closing timeline",
    body: "Choose closing dates that work for your situation, from as little as two weeks to several months if you need more time.",
  },
];

const fastSaleCityLinks = [
  {
    label: "Kansas City, MO",
    href: "/areas/kansas-city-mo/",
    body: "Fast as-is sale options for Midtown, Brookside, Waldo, south KC, and nearby neighborhoods.",
  },
  {
    label: "Olathe, KS",
    href: "/areas/olathe-ks/",
    body: "Olathe cash-offer reviews for relocation, repairs, inherited homes, and school-year timelines.",
  },
  {
    label: "Overland Park, KS",
    href: "/areas/overland-park-ks/",
    body: "Johnson County closing help for HOA items, repair decisions, and flexible possession needs.",
  },
  {
    label: "Shawnee, KS",
    href: "/areas/shawnee-ks/",
    body: "Direct-sale options for Shawnee houses needing updates, estate coordination, or a quick close.",
  },
  {
    label: "Independence, MO",
    href: "/areas/independence-mo/",
    body: "Jackson County help for inherited homes, code issues, repairs, and urgent timelines.",
  },
  {
    label: "Lee's Summit, MO",
    href: "/areas/lees-summit-mo/",
    body: "Cash and creative sale options for growing families, vacant homes, and move-driven timelines.",
  },
];

const searchIntentPoints = [
  "Sell my house fast in Kansas City without repairs",
  "Get a cash offer instead of listing with showings",
  "Compare a direct sale against agent commissions and holding costs",
  "Close around relocation, probate, tenants, late payments, or a vacant house",
];

const comparisonRows = [
  {
    path: "Direct cash sale",
    bestFor: "Speed, repairs, privacy, tenants, vacant houses, inherited homes, or uncertain timing",
    tradeoff: "The offer may be lower than a polished retail listing, but it removes repairs, showings, commissions, and financing risk.",
  },
  {
    path: "Traditional listing",
    bestFor: "Updated homes, flexible timelines, easy showings, and sellers who can wait for the strongest retail buyer",
    tradeoff: "You may need repairs, cleaning, buyer inspections, concessions, appraisal timing, and months of carrying costs.",
  },
  {
    path: "Creative option",
    bestFor: "Sellers who want to compare cash with terms that may protect equity or solve a payment/timing issue",
    tradeoff: "The paperwork and risk profile need to be reviewed carefully with your own advisors before signing.",
  },
];

const relatedGuides = [
  {
    title: "Kansas City fast-sale guide",
    href: "/resources/sell-house-fast-kansas-city-guide/",
    body: "The practical timeline, documents, title checks, and seller decisions that affect a fast closing.",
  },
  {
    title: "Cash buyers closing in two weeks",
    href: "/resources/cash-home-buyers-close-in-two-weeks-kansas-city/",
    body: "When a two-week closing is realistic and what can slow title, payoffs, or occupancy.",
  },
  {
    title: "Johnson County cash buyers",
    href: "/resources/johnson-county-cash-home-buyers/",
    body: "Olathe, Overland Park, Shawnee, and Lenexa details for HOA, title, repairs, and timing.",
  },
  {
    title: "Vacant house carrying costs",
    href: "/resources/vacant-house-carrying-cost-calculator/",
    body: "Estimate how utilities, insurance, taxes, repairs, and time can affect your net.",
  },
];

const faqs = [
  {
    question: "Can I sell my house fast in Kansas City without repairs?",
    answer:
      "Yes. We review Kansas City metro houses as-is, including dated interiors, roof issues, foundation concerns, clean-out needs, tenants, and other items that can slow down a traditional listing.",
  },
  {
    question: "Do you make fast cash offers in Olathe, Overland Park, Shawnee, and Independence?",
    answer:
      "Yes. We review homes across the Kansas City metro, including Olathe, Overland Park, Shawnee, Independence, Kansas City, KS, Lee's Summit, Lenexa, and nearby communities.",
  },
  {
    question: "What's the fastest closing timeline possible?",
    answer: "Cash offers can close in as little as 10-14 days when title work is clear. We prioritize your timeline and can expedite every step of the process.",
  },
  {
    question: "Do I need to make any repairs first?",
    answer: "No. We buy houses as-is in any condition. You can avoid contractors, inspections, and repair costs entirely. Visit our <a href=\"/solutions/vacant-house/\" class=\"text-secondary underline\">vacant property guide</a> for common issues we handle.",
  },
  {
    question: "Do you charge commissions or fees?",
    answer: "No. We cover standard closing costs and don't charge commissions. The cash offer amount is what you receive at closing, minus any required mortgage payoffs.",
  },
  {
    question: "Will you buy a house with tenants?",
    answer: "Yes. We can coordinate with existing tenants or handle lease termination. Many landlords choose this option to avoid ongoing management responsibilities.",
  },
  {
    question: "What if I'm behind on payments or have liens?",
    answer: "We work with title companies to resolve mortgages, tax liens, and other debts at closing. These are paid from proceeds, and we can coordinate with creditors when needed.",
  },
  {
    question: "Is this better than listing with an agent?",
    answer: "For speed and certainty, yes. Traditional listings take months and require repairs, showings, and negotiations. Cash offers provide guaranteed closing dates and as-is terms.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: "Sell My House Fast in Kansas City",
    description:
      "As-is cash and creative home buying options for Kansas City metro sellers who need speed, certainty, and no repair requirements.",
    path: "/solutions/sell-house-fast/",
  }),
  buildFaqPageJsonLd(faqs.map((faq) => ({ question: faq.question.replace(/<[^>]+>/g, ""), answer: faq.answer.replace(/<[^>]+>/g, "") }))),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions/" },
    { name: "Sell Your House Fast in Kansas City", item: "/solutions/sell-house-fast/" },
  ]),
];
---

<Layout
  title="Sell My House Fast Kansas City | Cash Home Buyers"
  description="Need to sell your Kansas City house fast? Compare a no-pressure as-is cash offer with no repairs, showings, commissions, or listing delays."
  canonicalPath="/solutions/sell-house-fast/"
  jsonLd={jsonLd}
>
  <section class="section space-y-4">
    <p class="badge">Speed & Certainty Solutions</p>
    <h1 class="text-4xl font-semibold text-primary">Sell My House Fast in Kansas City</h1>
    <p class="text-muted">
      If you need to sell a house fast in Kansas City, the real question is not just how quickly someone can make an offer. It is whether the buyer can explain title timing, repairs, closing costs, occupancy, and your net clearly enough for you to make a good decision. Whether you are in <a href="/areas/kansas-city-mo/" class="text-secondary underline">Kansas City</a>, <a href="/areas/olathe-ks/" class="text-secondary underline">Olathe</a>, <a href="/areas/overland-park-ks/" class="text-secondary underline">Overland Park</a>, <a href="/areas/shawnee-ks/" class="text-secondary underline">Shawnee</a>, or anywhere in the metro, we provide cash and creative options so you can compare an as-is sale against listing without repairs, showings, or pressure.
    </p>
  </section>

  <HighIntentOfferBlock
    badge="Fast offer path"
    title="Need a fast number without listing first?"
    body="Send the address and your timeline. We will review whether a quick cash close is realistic, explain the tradeoffs, and give you the next step before you commit to anything."
    points={[
      "No showings, open houses, or MLS prep",
      "As-is sale path for urgent timelines",
      "Cash and creative options compared clearly",
      "Closing date built around your move",
    ]}
    formId="sell-house-fast-offer-form"
    formHeading="Request a fast-sale offer"
    trackingLocation="sell_house_fast"
  />

  <section class="section space-y-5">
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Compare before you decide</p>
      <h2 class="text-3xl font-semibold text-primary">The fastest option is not always the best option</h2>
      <p class="max-w-3xl text-muted">
        A strong cash buyer should help you compare the direct-sale path against the open market. These are the three lanes we walk through with Kansas City sellers before they choose what fits.
      </p>
    </div>
    <div class="grid gap-4 lg:grid-cols-3">
      {comparisonRows.map((row) => (
        <article class="card h-full space-y-3">
          <h3 class="text-xl font-semibold text-primary">{row.path}</h3>
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Best for</p>
          <p class="text-sm text-primary">{row.bestFor}</p>
          <p class="text-sm text-muted">{row.tradeoff}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-[0.85fr_1.15fr]">
    <article class="card space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Fast-sale goals</p>
      <h2 class="text-2xl font-semibold text-primary">Common Kansas City seller goals we can help with</h2>
      <ul class="space-y-3 text-sm text-primary">
        {searchIntentPoints.map((point) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </article>
    <article class="card space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Metro coverage</p>
      <h2 class="text-2xl font-semibold text-primary">Fast house buyers across KC, Missouri and Kansas</h2>
      <p class="text-muted">
        These local pages give homeowners a clearer path based on where the house sits, what county title work applies, and what kind of closing timeline is realistic.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        {fastSaleCityLinks.map((city) => (
          <a href={city.href} class="rounded-md border border-border bg-soft/60 p-3 transition hover:border-secondary/60 hover:bg-white">
            <span class="text-sm font-semibold text-primary">Sell fast in {city.label}</span>
            <span class="mt-1 block text-xs text-muted">{city.body}</span>
          </a>
        ))}
      </div>
    </article>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Why homeowners choose fast sales</h2>
      <p class="text-muted">
        Most homeowners who need speed are dealing with life changes: relocations, inherited properties, or situations requiring quick decisions. We eliminate traditional selling barriers so you can move forward with certainty.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Speed without sacrificing value</h2>
      <p class="text-muted">
        Fast doesn't mean low offers. We provide fair cash offers based on current market conditions, eliminating months of holding costs, commissions, and repair expenses that eat into traditional sale profits.
      </p>
    </article>
  </section>

  <section class="section section-alt">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">Why some sellers need speed and certainty</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold text-primary mb-2">Common Speed Triggers</h3>
          <ul class="space-y-2 text-sm text-muted">
            {speedReasons.map((reason) => (
              <li>• {reason}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-primary mb-2">Fast Sale Benefits</h3>
          <ul class="space-y-2 text-sm text-muted">
            <li>• Guaranteed closing dates</li>
            <li>• No repairs or renovations</li>
            <li>• Skip showings and open houses</li>
            <li>• Avoid listing uncertainties</li>
            <li>• Simplified moving logistics</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">Common fast-sale situations</h2>
      <ul class="mt-4 space-y-3 text-sm text-primary">
        {situations.map((situation) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{situation}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">How we help homeowners sell fast</h2>
      <p class="text-muted">
        From first call to closing, we focus on speed and simplicity. We evaluate properties as-is, provide clear cash offers, and coordinate closing dates that work with your timeline requirements.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Kansas City fast-sale market</h2>
      <p class="text-muted">
        Kansas City's real estate market moves quickly, but traditional listings still take months. We understand local market conditions across Missouri and Kansas, from <a href="/areas/kansas-city-mo/" class="text-secondary underline">Kansas City proper</a> to <a href="/areas/overland-park-ks/" class="text-secondary underline">Overland Park</a>, <a href="/areas/olathe-ks/" class="text-secondary underline">Olathe</a>, and surrounding suburbs.
      </p>
      <p class="text-muted">
        Whether you're selling in <a href="/areas/independence-mo/" class="text-secondary underline">Independence</a>, <a href="/areas/lees-summit-mo/" class="text-secondary underline">Lee's Summit</a>, or other metro areas due to relocation, inheritance, or simply wanting a straightforward sale, we provide offers that reflect current market values while eliminating traditional selling delays.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Find your specific solution</h2>
      <p class="text-muted">
        Is your fast sale related to a job transfer? Visit our <a href="/solutions/relocating/" class="text-secondary underline">job transfer guide</a> for employer coordination, or check our <a href="/solutions/vacant-house/" class="text-secondary underline">vacant property solutions</a> if your house will sit empty.
      </p>
      <p class="text-muted">
        Need more detail before asking for an offer? Read the <a href="/resources/sell-house-fast-kansas-city-guide/" class="text-secondary underline">Kansas City fast-sale guide</a> or the <a href="/resources/cash-home-buyers-close-in-two-weeks-kansas-city/" class="text-secondary underline">two-week cash closing guide</a>.
      </p>
      <p class="text-muted">
        Selling in Olathe, Overland Park, Shawnee, or Lenexa? The <a href="/resources/johnson-county-cash-home-buyers/" class="text-secondary underline">Johnson County cash home buyers guide</a> explains county-specific HOA, title, and timing questions.
      </p>
      <p class="text-muted">
        Dealing with estate or court requirements? Explore our <a href="/solutions/probate-house/" class="text-secondary underline">probate court process</a> for legal coordination, or review <a href="/areas/" class="text-secondary underline">Kansas City area market insights</a> for location-specific considerations.
      </p>
      <p class="text-muted">
        Ready for a fast, certain sale? <a href="/contact/" class="text-secondary underline">Contact us</a> for a cash offer and closing timeline that eliminates traditional selling delays.
      </p>
    </article>
  </section>

  <section class="section space-y-5">
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Fast-sale resources</p>
      <h2 class="text-2xl font-semibold text-primary">Helpful guides before you request an offer</h2>
      <p class="max-w-3xl text-muted">
        These support pages answer the questions sellers usually have right before they ask for a cash offer: timing, title, repairs, vacant-house costs, and whether listing might still be better.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {relatedGuides.map((guide) => (
        <a href={guide.href} class="card h-full transition hover:-translate-y-1 hover:border-secondary/60">
          <h3 class="text-xl font-semibold text-primary">{guide.title}</h3>
          <p class="mt-2 text-sm text-muted">{guide.body}</p>
          <span class="mt-4 inline-flex text-sm font-semibold text-secondary">Read guide</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Sell House Fast FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted" set:html={faq.answer}></p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Get fast cash offer</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with our team</a>
    <a href="/solutions/" class="btn btn-outline text-base">See all solutions</a>
  </section>
</Layout>
