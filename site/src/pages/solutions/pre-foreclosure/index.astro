---
import Layout from "../../../layouts/Layout.astro";
import HighIntentOfferBlock from "../../../components/HighIntentOfferBlock.astro";
import LocalDecisionMap from "../../../components/LocalDecisionMap.astro";
import { SITE } from "../../../lib/siteConfig";
import {
  webSiteJsonLd,
  localBusinessJsonLd,
  buildFaqPageJsonLd,
  buildBreadcrumbList,
  serviceJsonLd,
} from "../../../lib/seo";

const steps = [
  {
    title: "Listen & outline deadlines",
    body:
      "We start with the notice you received, lender communications, and the exact timeline before a sale date is set.",
  },
  {
    title: "Compare offers & payoffs",
    body:
      "Cash sale, payoff-at-closing, or payment takeover arrangements may be options depending on equity, arrears, and approvals.",
  },
  {
    title: "Coordinate closing details",
    body:
      "We work with the title company, your lender, and any advisors you involve so each requirement is documented.",
  },
];

const considerations = [
  "Bring the latest mortgage statements and any reinstatement quotes so payoff numbers stay accurate.",
  "Share HOA, tax, or utility liens that also need attention at closing.",
  "Let us know if you prefer private walkthroughs, virtual tours, or after-hours meetings.",
  "Ask an attorney or housing counselor to review paperwork if you want additional assurance.",
];

const options = [
  {
    title: "Cash offer with payoff at closing",
    body:
      "We purchase the property as-is and use closing proceeds to pay the arrears and remaining loan balance. Typical timelines run 14 to 21 days after clear title.",
  },
  {
    title: "Payment takeover review",
    body:
      "If the loan and your situation allow, we may take over payments and fund arrears while the existing loan stays in place temporarily. This path depends on careful documentation, deadlines, and advisor review.",
  },
  {
    title: "Timeline coordination",
    body:
      "Some sellers keep listing options open while we provide a written backup offer. That way you know the numbers if a listing or refinance does not materialize before deadlines.",
  },
];

const faqs = [
  {
    question: "What is pre-foreclosure?",
    answer: "It is the window after missed payments when the lender issues default notices but before a sale date is completed, giving you time to act.",
  },
  {
    question: "Do I still have options if I got a notice?",
    answer: "Yes. Notices outline deadlines, but you can still explore cash sales, payoff-at-closing, or other agreements before the auction.",
  },
  {
    question: "Can you coordinate with my lender?",
    answer: "With your written permission we share payoff requests, timelines, and closing updates directly with the lender and title company.",
  },
  {
    question: "What if I'm trying a loan modification?",
    answer: "We can prepare a backup offer so you have a documented plan if the modification is denied or takes longer than expected.",
  },
  {
    question: "How fast can a sale close?",
    answer: "Cash purchases often close within two to three weeks once title is ready, and we can write faster timelines when everyone is aligned.",
  },
  {
    question: "What should I bring to the first call?",
    answer: "Have your latest statement, any reinstatement quotes, notice dates, and contact info for advisors you want looped in.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: "Kansas City Pre-Foreclosure Options",
    description:
      "Private cash and payment takeover options for Kansas City homeowners in pre-foreclosure, including payoff-at-closing, backup offer, and title timeline reviews.",
    path: "/solutions/pre-foreclosure/",
  }),
  buildFaqPageJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions/" },
    { name: "Kansas City Pre-Foreclosure Options", item: "/solutions/pre-foreclosure/" },
  ]),
];

---

<Layout
  title="Kansas City Pre-Foreclosure Options | ACE"
  description="Facing pre-foreclosure in Kansas City? Compare as-is cash sale, payoff-at-closing, payment takeover, and timeline options before deadlines tighten."
  canonicalPath="/solutions/pre-foreclosure/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell py-14 md:py-20">
      <div class="max-w-5xl space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Private deadline review</span>
          <span class="v3-pill">Payoff-at-closing</span>
          <span class="v3-pill">Cash or payment options</span>
        </div>
        <div class="space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Pre-foreclosure guidance</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">Navigate Pre-Foreclosure With a Clear Backup Plan</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            Notices can feel urgent, but there may still be time to compare lender help, payoff-at-closing, cash sale, or a payment-takeover review before deadlines tighten.
          </p>
          <p class="max-w-3xl text-sm leading-6 text-white/70">
            ACE does not provide legal advice or guarantee outcomes. We explain sale paths plainly so you can review them with your lender, counselor, attorney, or family.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#pre-foreclosure-offer-form" class="btn bg-white text-primary hover:bg-white/90">Review my deadline</a>
          <a href="/resources/behind-on-mortgage-options-kansas-city/" class="btn border border-white/40 text-white hover:bg-white/10">Read mortgage options guide</a>
        </div>
      </div>
    </div>
  </section>

  <HighIntentOfferBlock
    badge="Private timeline review"
    title="Have a deadline from the lender?"
    body="Share the address and latest notice date if you have it. We can discuss payoff-at-closing timelines, cash sale options, payment takeover possibilities, and whether more documentation is needed."
    points={[
      "Private conversation around lender deadlines",
      "Payoff-at-closing and cash sale paths compared",
      "Payment takeover reviewed if the existing loan can stay in place",
      "Written next steps for title or advisor review",
    ]}
    formId="pre-foreclosure-offer-form"
    formHeading="Review pre-foreclosure options"
    formSubheading="Start privately with the property address and contact info."
    trackingLocation="pre_foreclosure"
  />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">What we cover on the first call</h2>
      <p class="text-muted">
        We review lender letters, auction dates, and any payment plans you have attempted. From there we share timelines for cash purchases, payoff-at-closing, or payment takeover approaches and let you loop in family or advisors before moving forward.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Options tailored to your comfort level</h2>
      <p class="text-muted">
        Some sellers want the fastest sale possible while others need breathing room to relocate. We map out multiple paths, document each step, and never pressure you into a choice you are not ready to make.
      </p>
    </article>
  </section>

  <section class="section section-alt space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Common scenarios we discuss</h2>
      <p class="text-muted">Every option routes through a licensed title company so payoffs, arrears, and releases are handled properly.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {options.map((option) => (
        <article class="card bg-white/90" aria-label={option.title}>
          <h3 class="text-lg font-semibold text-primary">{option.title}</h3>
          <p class="mt-2 text-sm text-muted">{option.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">How the process fits your timeline</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <article class="card">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </article>
      ))}
    </div>
    <p class="text-xs text-muted">
      Confirm payoff amounts and deadlines directly with your lender or counsel. Our role is to present sale options and logistics clearly.
    </p>
  </section>

  <section class="section">
    <div class="card space-y-4">
      <h2 class="text-2xl font-semibold text-primary">What to gather</h2>
      <p class="text-muted">Sharing these documents early helps the title company and lenders keep the file moving.</p>
      <ul class="space-y-3 text-sm text-primary">
        {considerations.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Pre-foreclosure FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <LocalDecisionMap
    variant="payment"
    heading="Match pre-foreclosure timing to your local KC path"
    intro="County notices, payoff timing, title issues, and city-specific repairs all affect what can happen before deadlines tighten. Start with the closest local page and county guide."
  />

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Talk through next steps today</h2>
    <p class="text-muted">
      The sooner we review your timeline, the more options you can keep open. We respond the same day, summarize everything in writing, and leave the final call in your hands.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
      <a href={`tel:${SITE.phoneTel}`} class="btn btn-secondary text-base">Call {SITE.phoneDisplay}</a>
      <a href="/contact/" class="btn btn-ghost text-base">Talk with the team</a>
      <a href="/solutions/" class="btn btn-outline text-base">See other solutions</a>
    </div>
  </section>
</Layout>
