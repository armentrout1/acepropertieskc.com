---
import Layout from "../../../layouts/Layout.astro";
import CreativePromisePanel from "../../../components/CreativePromisePanel.astro";
import HighIntentOfferBlock from "../../../components/HighIntentOfferBlock.astro";
import LocalDecisionMap from "../../../components/LocalDecisionMap.astro";
import SellerReviewStrip from "../../../components/SellerReviewStrip.astro";
import { SITE } from "../../../lib/siteConfig";
import {
  webSiteJsonLd,
  localBusinessJsonLd,
  buildFaqPageJsonLd,
  buildBreadcrumbList,
  serviceJsonLd,
} from "../../../lib/seo";

const checklist = [
  "Mortgage servicer name and the best phone or portal to reach them",
  "Rough arrears amount, including any late fees you have been told about",
  "Copies of the most recent notices or letters you received",
  "Key dates you are watching: payment due, inspection, court or auction",
  "Whether anyone else (co-borrower, advisor) should be looped in",
];

const steps = [
  {
    title: "Clarify the status",
    body:
      "We review lender letters, grace periods, and what happens next if payments are not caught up.",
  },
  {
    title: "Compare realistic paths",
    body:
      "We outline cash offers, payoff-at-closing scenarios, and payment takeover possibilities so you can weigh each one.",
  },
  {
    title: "Coordinate closing logistics",
    body:
      "We align with the title company, your lender, and any advisors you involve so deadlines stay visible.",
  },
];

const faqs = [
  {
    question: "Can you still help if I have only missed one payment?",
    answer:
      "Yes. Early conversations give us more room to negotiate with the lender or plan closing dates before fees compound.",
  },
  {
    question: "Do I need to know the exact reinstatement amount?",
    answer:
      "A recent statement or payoff quote helps, but we can also request updated figures through the title company once you authorize it.",
  },
  {
    question: "What if another option, like a refinance, is already in motion?",
    answer:
      "We can prepare a written backup offer so you have a fallback if the refinance or loan modification stalls.",
  },
  {
    question: "Will you talk with my lender for me?",
    answer:
      "We coordinate with lenders after you sign the necessary permissions, but we still encourage you to stay in direct contact with them too.",
  },
  {
    question: "Can I stay in the house for a bit after closing?",
    answer:
      "If timelines require it, we can discuss short post-closing occupancies so you have a calm move-out plan.",
  },
  {
    question: "Is there any cost to review my situation?",
    answer:
      "No. Conversations, walkthroughs, and written offers are free. You only pay standard closing costs if you choose to sell to us.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: "Sell a House Behind on Payments in Kansas City",
    description:
      "Private cash and payment takeover options for Kansas City homeowners behind on mortgage payments, including payoff-at-closing, backup offers, and careful takeover reviews.",
    path: "/solutions/behind-on-payments/",
  }),
  buildFaqPageJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions/" },
    { name: "Sell a House Behind on Payments in Kansas City", item: "/solutions/behind-on-payments/" },
  ]),
];
---

<Layout
  title="Sell a House Behind on Payments in Kansas City | ACE"
  description="Behind on mortgage payments in Kansas City? Compare cash sale, payoff-at-closing, payment takeover, and backup options before fees or deadlines grow."
  canonicalPath="/solutions/behind-on-payments/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell py-14 md:py-20">
      <div class="max-w-5xl space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Past-due mortgage support</span>
          <span class="v3-pill">Payoff and arrears review</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-accent">Private payment review</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">Sell a House Behind on Payments in Kansas City</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            Falling behind feels heavy, but the next step does not have to be chaotic. ACE can compare a cash sale, payoff-at-closing path, payment-takeover review, or backup offer before fees and deadlines keep growing.
          </p>
          <p class="max-w-3xl text-sm leading-6 text-white/70">
            We are local to the Kansas City metro and keep lender, title, arrears, and timeline questions visible from the first conversation.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#behind-on-payments-offer-form" class="btn bg-white text-primary hover:bg-white/90">Review payment options</a>
          <a href="/resources/behind-on-mortgage-options-kansas-city/" class="btn border border-white/40 text-white hover:bg-white/10">Read the guide</a>
        </div>
      </div>
    </div>
  </section>

  <HighIntentOfferBlock
    badge="Payment deadline review"
    title="Need to see your options before the next deadline?"
    body="Share the address, rough payment status, and any important dates. We can compare a cash sale, payoff-at-closing path, payment takeover option, or backup offer so you know what is realistic."
    points={[
      "Mortgage payoff and arrears handled through title",
      "Payment takeover reviewed if the existing loan can stay in place",
      "Written option summary for co-borrowers or advisors",
      "No repairs or public listing required to start",
    ]}
    formId="behind-on-payments-offer-form"
    formHeading="Review payment-related options"
    formSubheading="Start privately with the address and best contact method."
    trackingLocation="behind_on_payments"
  />

  <CreativePromisePanel
    eyebrow="Payment-pressure options"
    heading="Do not choose blind when the mortgage is the pressure point"
    intro="When payments are late or deadlines are close, the right answer may be a cash sale, payoff-at-closing, a written backup plan, or a payment takeover review. ACE walks through the options and the risk before any commitment."
    storySlug="out-of-state-creative-solution"
    primaryLabel="Review payment options"
    primaryHref="#behind-on-payments-offer-form"
    trackingLocation="behind_payments_creative_promise"
  />

  <SellerReviewStrip
    heading="Proof that a flexible payment solution can matter"
    intro="When a mortgage, payoff, or timeline is the problem, a real seller review can help explain why ACE compares more than one path."
  />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">What to expect on the first call</h2>
      <p class="text-muted">
        We review the notices you have received, note how many payments are outstanding, and ask about any upcoming lender checkpoints. You set the tone, whether quiet catch-up plan or urgent exit, and we outline who else should be looped in so updates stay aligned.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Options we can walk through</h2>
      <p class="text-muted">
        Every path is optional. We can compare quick cash offers, payoff-at-closing scenarios, payment takeover arrangements that keep the loan in place temporarily, or written backup offers that give you breathing room while you pursue a refinance or listing.
      </p>
      <p class="text-muted">
        If you are still sorting through the big picture, start with the <a href="/resources/behind-on-mortgage-options-kansas-city/" class="text-secondary underline">behind on mortgage options guide</a> and the <a href="/options/" class="text-secondary underline">cash or payment takeover options page</a> before deciding whether to sell.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">What helps us help you fast</h2>
      <p class="text-muted">Bring what you can; estimates are fine. The more we know, the faster we can coordinate with title and the lender.</p>
      <ul class="mt-4 space-y-3 text-sm text-primary">
        {checklist.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">How the process plays out</h2>
      <p class="text-muted">
        Our process is meant to keep you informed without adding noise. Steps stay flexible if lenders or courts adjust the schedule.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <article class="card">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Documents & timeline basics</h2>
      <p class="text-muted">
        Title companies usually request your latest mortgage statement, any reinstatement quotes, HOA or tax letters, and proof of insurance. Having them handy shortens review time. Once title is clear, cash closings often land within two to three weeks.
      </p>
      <p class="text-muted">
        Read the deeper guide on <a href="/resources/sell-house-behind-on-payments-kansas-city/" class="text-secondary underline">selling when you are behind on payments</a> if you are still comparing lender options and sale timelines.
      </p>
      <p class="text-muted">
        If payment takeover is part of the conversation, review the <a href="/resources/subject-to-real-estate-kansas-city/" class="text-secondary underline">subject-to payment takeover guide</a> and involve your own legal or financial advisor before signing anything.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Keeping communication steady</h2>
      <p class="text-muted">
        We summarize each conversation in writing so you, co-borrowers, or advisors can reference the same plan. If new notices arrive, send them our way; we adjust timelines immediately and confirm next steps in plain language.
      </p>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Behind-on-payments FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <LocalDecisionMap
    variant="payment"
    heading="Match payment pressure to the right local KC next step"
    intro="Mortgage pressure moves differently by county, city, title status, and payoff timing. Use these local pages to compare the right path before choosing an offer."
  />

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with the team</a>
    <a href="/solutions/" class="btn btn-outline text-base">See other solutions</a>
  </section>
</Layout>
