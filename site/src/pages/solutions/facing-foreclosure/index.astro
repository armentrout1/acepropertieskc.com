---
import Layout from "../../../layouts/Layout.astro";
import { SITE } from "../../../lib/siteConfig";
import {
  webSiteJsonLd,
  localBusinessJsonLd,
  buildFaqPageJsonLd,
  buildBreadcrumbList,
  serviceJsonLd,
} from "../../../lib/seo";

const faqs = [
  {
    q: "Is foreclosure guaranteed once it starts?",
    a: "Not always. Lenders follow set timelines, but sales can pause if arrears are cured or a sale closes before the auction.",
  },
  {
    q: "Can I still sell if I’m in foreclosure?",
    a: "Yes. We work through licensed title companies to pay arrears and liens from sale proceeds before the lender finalizes the process.",
  },
  {
    q: "What if I already have a sale date?",
    a: "Share the date and lender contact. We can coordinate to see if there is time for a closing or a written backup plan.",
  },
  {
    q: "Can you work with my lender or attorney?",
    a: "With written authorization we provide updates, payoff requests, and closing statements directly to lenders or legal counsel.",
  },
  {
    q: "How quickly can we close?",
    a: "Cash deals frequently close within 7–14 days once title is clear, and we adjust timelines if the lender needs proof sooner.",
  },
  {
    q: "What should I have ready before we talk?",
    a: "Bring the latest mortgage statement, any default notices, payoff quotes, and contact info for advisors you want involved.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  serviceJsonLd({
    name: "Facing Foreclosure Options in Kansas City",
    description:
      "Private cash and creative sale options for Kansas City homeowners facing foreclosure, including payoff-at-closing, title coordination, and advisor-reviewed next steps.",
    path: "/solutions/facing-foreclosure/",
  }),
  buildFaqPageJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions/" },
    { name: "Facing Foreclosure? Sell Your House Fast in Kansas City", item: "/solutions/facing-foreclosure/" },
  ]),
];
---

<Layout
  title="Facing Foreclosure? Sell Your House Fast in Kansas City"
  description="Facing foreclosure in Kansas City? Compare as-is cash sale, payoff-at-closing, subject-to discussions, and timeline options before deadlines tighten."
  canonicalPath="/solutions/facing-foreclosure/"
  jsonLd={jsonLd}
>
  <section class="section space-y-5">
    <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Foreclosure Solutions</p>
    <h1 class="text-4xl font-semibold text-primary">Facing Foreclosure in Kansas City? Compare Your Options</h1>
    <p class="max-w-3xl text-muted">
      When a lender is moving toward foreclosure, time matters. A direct sale may be one possible path if title can clear before a deadline, but it should be compared with lender workouts, housing counseling, legal advice, and any option that helps you keep the house if that is your goal.
    </p>
  </section>

  <section class="section">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="card space-y-3">
        <h2 class="text-2xl font-semibold text-primary">Fast Cash Sale</h2>
        <p class="text-muted">
          A cash sale may close quickly once title is ready and can use closing proceeds to pay the mortgage, arrears, taxes, and recorded liens. The timeline depends on title, lender payoff figures, all required signatures, and any court or auction date.
        </p>
        <ul class="list-disc list-inside text-sm text-muted space-y-1">
          <li>No repairs needed – sell as-is</li>
          <li>No real estate commissions</li>
          <li>We pay all closing costs</li>
          <li>Close on your timeline</li>
        </ul>
      </article>
      
      <article class="card space-y-3">
        <h2 class="text-2xl font-semibold text-primary">Subject-To Options</h2>
        <p class="text-muted">
          Subject-to may be discussed when keeping the existing loan in place could solve a payoff or timing problem. This structure carries real seller risk and should be reviewed with your own legal or financial advisor before signing.
        </p>
        <ul class="list-disc list-inside text-sm text-muted space-y-1">
          <li>Payment and arrears plan documented in writing</li>
          <li>Existing mortgage may stay in your name temporarily</li>
          <li>No new loan may be needed from the buyer</li>
          <li>Advisor review strongly encouraged</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="card bg-white/90 space-y-4">
      <h2 class="text-2xl font-semibold text-primary">How we review the timeline</h2>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="space-y-2">
          <h3 class="font-semibold text-primary">1. Notice review</h3>
          <p class="text-sm text-muted">Share the lender notices, payoff status, and any sale date so the timeline is not guessed.</p>
        </div>
        <div class="space-y-2">
          <h3 class="font-semibold text-primary">2. Title and payoff check</h3>
          <p class="text-sm text-muted">The title company confirms ownership, liens, payoff numbers, and what must be paid from proceeds.</p>
        </div>
        <div class="space-y-2">
          <h3 class="font-semibold text-primary">3. Written options</h3>
          <p class="text-sm text-muted">You can compare a sale, backup offer, or creative discussion with lender and advisor input.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section space-y-4">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Important Considerations</h2>
      <p class="text-muted">
        Every foreclosure situation is unique. While we can often provide solutions that stop the process, we cannot guarantee specific outcomes. We encourage you to:
      </p>
      <ul class="list-disc list-inside text-sm text-muted space-y-1">
        <li>Consult with a HUD-approved housing counselor or attorney</li>
        <li>Review all loan documents carefully</li>
        <li>Understand tax implications of any sale</li>
        <li>Consider all alternatives before deciding</li>
      </ul>
      <p class="text-sm text-muted">
        A neutral starting point is the <a href="/resources/behind-on-mortgage-options-kansas-city/" class="text-secondary underline">Kansas City behind-on-mortgage options guide</a>, which links to HUD and CFPB housing counseling resources.
      </p>
      <p class="text-sm text-muted">
        We provide clear, transparent options and help you understand the timeline and consequences of each approach.
      </p>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Take Action Today</h2>
    <p class="text-muted">
      The sooner you compare timelines, the more room you usually have to make a calm decision. Share the address, latest lender notice, and any known sale date so we can tell you whether a direct sale timeline is realistic.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/get-offer/" class="btn btn-primary text-base">Get Your Cash Offer</a>
      <a href={`tel:${SITE.phoneTel}`} class="btn btn-secondary text-base">Call Now: {SITE.phoneDisplay}</a>
      <a href="/solutions/" class="btn btn-outline text-base">See other solutions</a>
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Facing foreclosure FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.q}</summary>
          <p class="mt-2 text-sm text-muted">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
