---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import GoogleBusinessTrustLink from "../../../components/GoogleBusinessTrustLink.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import {
  buildBreadcrumbList,
  webSiteJsonLd,
  localBusinessJsonLd,
  faqJsonLd,
} from "../../../lib/seo";

const neighborhoodPatterns = [
  {
    title: "Downtown Shawnee and Johnson Drive homes",
    body: "Older homes near the historic core can have strong location appeal but still need roof, window, HVAC, electrical, foundation, or clean-out work before a normal listing feels realistic.",
  },
  {
    title: "Monticello and western Shawnee equity",
    body: "Long-time owners in western Shawnee may have equity but not the time, energy, or budget to prepare the house for retail buyers, inspection repairs, and repeated showings.",
  },
  {
    title: "Shawnee Mission Parkway and I-435 access",
    body: "Homes near commuter routes, parks, and established subdivisions can attract buyers, but timing still matters when the seller is relocating, settling an estate, or carrying a vacant property.",
  },
];

const situations = [
  "Inherited Shawnee houses where heirs need one clear written option",
  "As-is homes with roof, foundation, HVAC, window, or cosmetic repair needs",
  "Vacant properties where utilities, insurance, lawn care, or break-in risk are adding pressure",
  "Rental houses where tenant access, leases, deposits, or turnover create friction",
  "Divorce, relocation, or family timing where privacy and certainty matter",
  "Behind-on-payments, HOA, lien, or payoff questions that need title review before closing",
];

const shawneeFastSaleProof = [
  {
    title: "No repair bid required first",
    body: "We review the Shawnee house as-is, including deferred maintenance, contents left behind, outdated systems, and repairs that would normally slow down a public listing.",
  },
  {
    title: "A written net comparison",
    body: "You see the offer, estimated closing costs, repair assumptions, and timing so you can compare a direct sale against listing with an agent.",
  },
  {
    title: "Johnson County timing up front",
    body: "Payoffs, HOA items, title work, family signatures, possession timing, and seller authority are discussed before you decide, not at the last minute.",
  },
];

const steps = [
  {
    title: "Tell us what is happening",
    body: "Share the property address, repair concerns, payoff pressure, estate details, tenant situation, or timeline you are trying to solve.",
  },
  {
    title: "Walk the property as-is",
    body: "We can review the house in person or by video, including contents, access, repairs, utilities, and any Shawnee or Johnson County details that affect timing.",
  },
  {
    title: "Compare the written options",
    body: "You receive a direct offer and a plain explanation of what stays with us, what closing may look like, and whether listing may produce a better result.",
  },
];

const commonSellerGoals = [
  "Sell my house fast in Shawnee KS without repairs or open houses",
  "Talk with we-buy-houses Shawnee buyers before listing",
  "Compare cash home buyers in Shawnee with agent fees and repair bids",
  "Sell my house as-is in Shawnee before spending another month on upkeep",
  "Sell an inherited Shawnee property without every heir managing repairs",
  "Get a private offer before public photos, showings, and buyer inspection requests",
];

const shawneeSearchSignals = [
  {
    title: "We buy houses Shawnee KS",
    body: "ACE reviews Shawnee houses directly, including dated interiors, major repairs, vacant homes, inherited properties, and timelines that do not fit a public listing.",
  },
  {
    title: "Sell my house fast Shawnee KS",
    body: "A fast Shawnee sale usually comes down to title, payoff, repairs, clean-out, access, and whether the buyer can close without financing delays.",
  },
  {
    title: "Sell my house as-is Shawnee Kansas",
    body: "A useful as-is offer should explain price, closing costs, repair assumptions, title timing, and how the net compares with listing the house.",
  },
];

const listingComparison = [
  {
    title: "Listing may be better when",
    body: "The house is updated, easy to show, title is simple, you can wait for the right buyer, and you are comfortable handling inspections, repairs, commissions, and buyer concessions.",
  },
  {
    title: "A direct sale may be better when",
    body: "The house needs repairs, is vacant, has contents left inside, involves heirs or tenants, or you need a known closing path before spending more money.",
  },
  {
    title: "A flexible option may be better when",
    body: "There is little equity, payment pressure, or a loan that needs a creative review. We can talk through cash and creative options without forcing one answer.",
  },
];

const titleItems = [
  "Mortgage payoff and any second lien or line of credit",
  "HOA balances, resale documents, or subdivision transfer details",
  "Estate, trust, divorce, or power-of-attorney authority",
  "Property taxes, special assessments, utilities, and closing possession timing",
  "Repair assumptions, contents left behind, and whether the seller needs extra move-out time",
];

const internalGuides = [
  {
    label: "Johnson County cash home buyers guide",
    href: "/resources/johnson-county-cash-home-buyers/",
    body: "County-wide context for Shawnee, Olathe, Overland Park, Lenexa, and nearby Johnson County sellers.",
  },
  {
    label: "Major repairs vs selling as-is",
    href: "/resources/major-repairs-vs-selling-as-is-kansas-city/",
    body: "Compare roof, foundation, HVAC, window, and cosmetic repair costs before spending money.",
  },
  {
    label: "Inherited house checklist",
    href: "/resources/johnson-county-inherited-house-sale/",
    body: "Useful when siblings, heirs, estate paperwork, clean-out, or title authority are part of the Shawnee sale.",
  },
  {
    label: "Behind on payments in Johnson County",
    href: "/resources/johnson-county-behind-on-payments/",
    body: "Review payoff timing, HOA pressure, lender communication, and sale options before the situation gets tighter.",
  },
];

const faqs = [
  {
    question: "Do you buy houses in Shawnee as-is?",
    answer:
      "Yes. ACE Properties KC reviews Shawnee houses as-is, including properties with old systems, roof issues, foundation concerns, contents left behind, tenant access, or repairs the owner does not want to manage before selling.",
  },
  {
    question: "Can I sell my Shawnee house fast without making repairs?",
    answer:
      "Yes. If title is clear and the seller has authority to sign, a cash sale can often move much faster than a traditional listing. We explain the likely closing timeline, repair assumptions, and title items before you decide.",
  },
  {
    question: "How do cash home buyers in Shawnee handle closing costs?",
    answer:
      "The written offer explains what ACE is paying, what normal seller-side items may still apply, and how the net compares with listing costs such as commissions, repairs, concessions, holding costs, and another month of utilities or insurance.",
  },
  {
    question: "Should I list my Shawnee house or sell it direct?",
    answer:
      "Listing may be better if the house is updated, easy to show, and you can wait. A direct sale may be better if repairs, privacy, family timing, tenants, vacant-house risk, or clean-out work make a public listing harder.",
  },
  {
    question: "Do you buy inherited houses in Shawnee?",
    answer:
      "Yes. We can review inherited Shawnee houses where heirs need a written offer, clean-out help, repair assumptions, and a closing plan that works around estate, trust, or family paperwork.",
  },
  {
    question: "Can you buy a Shawnee rental or tenant-occupied house?",
    answer:
      "Yes. We can review tenant-occupied properties, vacant rentals, and small investment houses. Lease details, deposits, access, utilities, and closing possession are discussed before an offer is finalized.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Shawnee KS", item: "/areas/shawnee-ks/" },
  ]),
];
---

<Layout
  title="We Buy Houses Shawnee KS | Sell Fast As-Is"
  description="We buy houses Shawnee KS as-is. Compare a local cash offer before repairs, showings, clean-out, tenant issues, or Johnson County title timing slow you down."
  canonicalPath="/areas/shawnee-ks/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">We buy houses Shawnee KS</p>
      <h1 class="text-4xl font-semibold text-primary">
        Sell Your Shawnee House Fast, As-Is, With a Written Local Offer
      </h1>
      <p class="text-lg leading-8 text-muted">
        If you need to sell a Shawnee house fast, you should not have to guess
        whether repairs, clean-out, title, HOA items, tenants, or family timing
        will eat up your equity. ACE Properties KC reviews Shawnee homes as-is
        and gives you a written option you can compare against listing.
      </p>
      <p class="leading-7 text-muted">
        This page is for Shawnee owners who want a direct buyer before spending
        money on contractors, opening the house for showings, or waiting through
        buyer financing. If listing is likely better, we will say that too.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn btn-primary text-base"
          >Get a fast Shawnee offer</a
        >
        <a
          href="tel:+18167287548"
          class="btn btn-ghost text-base"
          data-phone-link="shawnee_hero">Call 816-728-7548</a
        >
      </div>
      <GoogleBusinessTrustLink class="max-w-xl" />
    </div>
    <OfferForm
      compact
      formId="shawnee-ks-offer-form"
      heading="Request a Shawnee offer"
      subheading="Start with the address and the best way to reach you."
      defaultSituation="Sell house fast"
      pageContext="shawnee-ks"
    />
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Quick answer</p>
      <h2 class="text-3xl font-semibold text-primary">
        Yes, you can compare a Shawnee cash offer before fixing the house.
      </h2>
      <p class="text-muted">
        The useful question is not just "what is the offer?" It is what you keep
        after repairs, commissions, concessions, holding costs, title timing,
        clean-out, and another month of ownership.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        shawneeFastSaleProof.map((item) => (
          <article class="card bg-white">
            <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        Shawnee seller intent
      </p>
      <h2 class="text-3xl font-semibold text-primary">
        If you searched "we buy houses Shawnee," compare the full selling path.
      </h2>
      <p class="text-muted">
        Many Shawnee sellers have a good property, but the normal listing
        process creates problems: repairs before photos, public showings, family
        clean-out, inspection requests, HOA paperwork, tenant access, or a
        closing date that is too far away.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        shawneeSearchSignals.map((item) => (
          <article class="card h-full">
            <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">What makes Shawnee different</p>
      <h2 class="text-3xl font-semibold text-primary">
        Shawnee has older central homes, western equity, and Johnson County
        details that matter.
      </h2>
      <p class="text-muted">
        Shawnee is not one simple market. A house near Johnson Drive, a
        long-held Monticello-area home, and a western Shawnee property can all
        need a different sale plan. We look at condition, equity, access, title,
        family timing, and what kind of buyer the house would attract if listed.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        neighborhoodPatterns.map((spot) => (
          <article
            class="card bg-white/90"
            aria-label={`Shawnee property pattern: ${spot.title}`}
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
              Local pattern
            </p>
            <h3 class="mt-2 text-xl font-semibold text-primary">
              {spot.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="card space-y-4">
      <h2 class="text-2xl font-semibold text-primary">
        Common Shawnee seller goals
      </h2>
      <div class="grid gap-3 md:grid-cols-2">
        {
          commonSellerGoals.map((goal) => (
            <div class="rounded-md border border-border bg-soft/60 p-3 text-sm text-primary">
              {goal}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        List or sell direct
      </p>
      <h2 class="text-3xl font-semibold text-primary">
        The best Shawnee sale is the one that protects your net and your
        timeline.
      </h2>
      <p class="text-muted">
        We are not trying to make every house a direct sale. Some Shawnee homes
        should be listed. Others need a buyer who can take on repairs, contents,
        tenant issues, or timing pressure without turning the sale into another
        project.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        listingComparison.map((item) => (
          <article class="card bg-white">
            <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <SellerSituationLinks
    city="Shawnee, KS"
    countyGuide={{
      label: "Johnson County behind-on-payments guide",
      href: "/resources/johnson-county-behind-on-payments/",
    }}
  />

  <AreaPropertyProof
    city="Shawnee, KS"
    county="Johnson County"
    propertyTypes={[
      {
        title: "Central Shawnee as-is homes",
        body: "Older homes with deferred maintenance, dated finishes, clean-out needs, or repairs that make MLS prep feel expensive.",
      },
      {
        title: "Johnson County inherited houses",
        body: "Family-owned houses where heirs need a written option, title clarity, repair assumptions, and a closing plan that respects everyone involved.",
      },
      {
        title: "Shawnee rentals and vacant houses",
        body: "Rental, tenant-occupied, vacant, or partially cleaned-out properties where access, leases, utilities, and carrying costs need a practical plan.",
      },
    ]}
  />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">
        What we review before making a Shawnee offer
      </h2>
      <p class="text-muted">
        A real offer should not be a vague number. We look at the house
        condition, likely resale path, title items, seller timeline, and what
        costs stay with us after closing.
      </p>
      <ul class="space-y-3 text-sm text-primary">
        {
          titleItems.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-2 w-2 rounded-full bg-secondary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">
        Why Shawnee sellers reach out
      </h2>
      <p class="text-muted">
        The house may be worth money, but the next step can still feel heavy.
        Repairs, family schedules, job moves, estate decisions, tenant
        coordination, and another month of carrying costs can make a clean
        written offer worth comparing.
      </p>
      <p class="text-muted">
        We keep the process direct: no pressure, no public listing requirement,
        no repair demand before the walkthrough, and no surprise expectation
        that the house must be empty before we review it.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">
        Common situations we solve in Shawnee
      </h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {
          situations.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-secondary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        Process
      </p>
      <h2 class="text-2xl font-semibold text-primary">
        How it works in Shawnee
      </h2>
      <p class="text-muted">
        From first conversation to closing, the goal is clarity. We document
        property condition, explain the offer assumptions, and help you
        understand whether a fast as-is sale or a traditional listing is the
        smarter next move.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <div class="card">
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
              Step {index + 1}
            </p>
            <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Helpful next reads</p>
      <h2 class="text-3xl font-semibold text-primary">
        Compare the Shawnee offer against the issue you are actually solving.
      </h2>
      <p class="text-muted">
        Most sellers are not just trying to sell a house. They are trying to get
        out of repair costs, protect credit, settle an estate, stop carrying a
        vacant property, or simplify a family decision.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {
        internalGuides.map((guide) => (
          <a
            href={guide.href}
            class="card block bg-white transition hover:border-secondary/60"
          >
            <h3 class="text-lg font-semibold text-primary">{guide.label}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{guide.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Shawnee FAQ</h2>
    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="card">
            <summary class="cursor-pointer text-base font-semibold text-primary">
              {faq.question}
            </summary>
            <p class="mt-2 text-sm text-muted">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base"
      >Start the Shawnee offer form</a
    >
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/areas/" class="btn btn-outline text-base">See all areas</a>
  </section>
</Layout>
