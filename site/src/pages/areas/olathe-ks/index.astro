---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import GoogleBusinessTrustLink from "../../../components/GoogleBusinessTrustLink.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import {
  buildBreadcrumbList,
  webSiteJsonLd,
  localBusinessJsonLd,
  faqJsonLd,
} from "../../../lib/seo";

const neighborhoodPatterns = [
  {
    title: "Old Olathe and long-held family homes",
    body: "Older homes near central Olathe can carry real equity, but updates, clean-out, estate decisions, and repair bids can make a normal listing feel heavy before it even starts.",
  },
  {
    title: "Western Olathe and newer subdivision timing",
    body: "Homes around western Olathe, K-7 access, and growing subdivision areas often involve HOA items, relocation timing, school-calendar moves, and sellers comparing speed against a retail listing.",
  },
  {
    title: "Rental, vacant, and move-driven Olathe sales",
    body: "Olathe sellers often reach out when a rental is no longer worth managing, a house is sitting vacant, or a job move requires a clean closing plan before the next purchase or relocation.",
  },
];

const situations = [
  "Inherited Olathe houses where family members need one written option",
  "As-is homes with foundation, roof, HVAC, window, deck, or cosmetic repair needs",
  "Relocation or job-change timing where the seller cannot wait through a long listing",
  "Vacant houses where utilities, insurance, lawn care, and security are becoming expensive",
  "Tenant-occupied rentals where access, lease timing, deposits, or turnover are creating friction",
  "Behind-on-payments, HOA balances, title questions, or payoff timing that needs a calm plan",
];

const olatheFastSaleProof = [
  {
    title: "Price the house before repair bids",
    body: "We review Olathe houses as-is, including dated interiors, foundation concerns, roof issues, clean-out needs, and repairs that would normally delay listing photos.",
  },
  {
    title: "Compare the actual net",
    body: "You see how a direct offer compares with commissions, repair checks, inspection concessions, seller-paid closing costs, utilities, insurance, and another month of holding the property.",
  },
  {
    title: "Plan around Johnson County details",
    body: "HOA documents, payoff statements, title work, possession timing, family signatures, and move-out dates are reviewed before you choose a closing path.",
  },
];

const steps = [
  {
    title: "Share the Olathe situation",
    body: "Tell us the address, what is pushing the timeline, and whether repairs, estate paperwork, tenants, HOA details, or a move are part of the decision.",
  },
  {
    title: "Review the house as-is",
    body: "We can walk the property in person or by video, noting condition, contents, utilities, access, title questions, and the likely resale or rental path.",
  },
  {
    title: "Compare the written options",
    body: "You get a direct offer, closing timeline, repair assumptions, and a plain comparison against listing so you can decide without pressure.",
  },
];

const commonSellerGoals = [
  "Sell my house fast in Olathe KS without repairs or showings",
  "Talk with cash home buyers in Olathe before spending money on contractors",
  "Compare we buy houses Olathe buyers with a traditional Johnson County listing",
  "Sell my house as-is in Olathe before cleaning everything out",
  "Get a written Olathe offer before a job move, estate deadline, or school-year transition",
  "Understand whether a cash offer or listing produces the better net after repairs and fees",
];

const olatheSearchSignals = [
  {
    title: "Sell my house fast Olathe",
    body: "A fast Olathe sale depends on title, payoff, condition, HOA items, access, seller authority, and whether the buyer can close without lender delays.",
  },
  {
    title: "We buy houses Olathe KS",
    body: "ACE reviews Olathe homes directly, including inherited houses, vacant properties, rentals, dated homes, and repair-heavy situations that do not fit a clean MLS launch.",
  },
  {
    title: "Sell my house as-is Olathe Kansas",
    body: "A useful as-is option explains the offer, what repairs stay with the buyer, what closing costs look like, and how the net compares with listing.",
  },
];

const listingComparison = [
  {
    title: "Listing may be better when",
    body: "The house is updated, easy to show, title is simple, you can wait for buyer financing, and you are comfortable handling inspection repairs, commissions, concessions, and showings.",
  },
  {
    title: "A direct sale may be better when",
    body: "The house needs repairs, has contents left inside, is vacant, involves heirs or tenants, or the seller needs a known closing date before spending more money.",
  },
  {
    title: "A flexible option may be better when",
    body: "There is little equity, payment pressure, a low-interest loan, or a situation where taking over payments may protect credit and still create a clean exit.",
  },
];

const netSheetItems = [
  "Agent commissions and buyer concessions on a traditional listing",
  "Foundation, roof, HVAC, flooring, paint, windows, deck, and clean-out costs",
  "HOA resale documents, payoff statements, taxes, utilities, and title work",
  "Another month of mortgage, insurance, utilities, lawn care, and vacant-house risk",
  "Possession timing, move-out needs, and whether the seller needs extra days after closing",
];

const internalGuides = [
  {
    label: "Johnson County cash home buyers guide",
    href: "/resources/johnson-county-cash-home-buyers/",
    body: "County-wide context for Olathe, Overland Park, Shawnee, Lenexa, and nearby Johnson County sellers.",
  },
  {
    label: "As-is sale net sheet template",
    href: "/resources/as-is-sale-net-sheet-template/",
    body: "A simple way to compare an Olathe cash offer against listing costs, repairs, concessions, and holding time.",
  },
  {
    label: "Johnson County inherited house sale",
    href: "/resources/johnson-county-inherited-house-sale/",
    body: "Useful when Olathe heirs need to compare clean-out, repairs, title authority, and a direct written offer.",
  },
  {
    label: "Major repairs vs selling as-is",
    href: "/resources/major-repairs-vs-selling-as-is-kansas-city/",
    body: "Compare the cost and delay of repairs before choosing whether to list or sell the house as-is.",
  },
];

const faqs = [
  {
    question: "Can I sell my Olathe house as-is?",
    answer:
      "Yes. ACE Properties KC reviews Olathe houses as-is, including homes with foundation issues, roof concerns, outdated systems, contents left behind, tenant access, or repairs the owner does not want to manage before selling.",
  },
  {
    question: "How fast can an Olathe cash offer close?",
    answer:
      "A cash sale can often close quickly once Johnson County title work, payoff statements, HOA items, and seller authority are clear. We explain the realistic timeline before you sign anything.",
  },
  {
    question: "Should I repair before listing in Olathe?",
    answer:
      "Sometimes, yes. If the house is easy to show and repairs are manageable, listing may produce a higher price. If repairs, clean-out, timing, tenants, or carrying costs are the problem, a direct as-is offer may be worth comparing first.",
  },
  {
    question: "Do you buy inherited houses in Olathe?",
    answer:
      "Yes. We can review inherited Olathe houses where heirs need a written offer, clean-out help, repair assumptions, and a closing plan that works around estate, trust, or family paperwork.",
  },
  {
    question: "Do you buy Olathe rentals or tenant-occupied houses?",
    answer:
      "Yes. We can review tenant-occupied rentals, vacant rentals, and small investment properties. Lease details, deposits, access, utilities, and closing possession are discussed before an offer is finalized.",
  },
  {
    question: "How do Olathe cash home buyers handle closing costs?",
    answer:
      "The written offer explains what ACE pays, what normal seller-side items may still apply, and how the net compares with listing costs such as commissions, repairs, concessions, and another month of carrying the house.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Olathe KS", item: "/areas/olathe-ks/" },
  ]),
];
---

<Layout
  title="Sell My House Fast Olathe KS | As-Is Cash Offer"
  description="Sell your Olathe KS house fast or as-is. Compare a local cash offer before repairs, clean-out, HOA items, tenants, relocation, or title work."
  canonicalPath="/areas/olathe-ks/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">Sell my house fast Olathe KS</p>
      <h1 class="text-3xl font-semibold text-primary sm:text-4xl">
        Sell Your Olathe House As-Is Before Repairs Slow You Down
      </h1>
      <p class="text-lg leading-8 text-muted">
        If your Olathe house needs repairs, clean-out, tenant coordination,
        estate decisions, or a fast relocation plan, you should be able to
        compare a real local offer before spending money on the house. ACE
        Properties KC reviews Olathe properties as-is and explains the cash
        offer, closing timeline, and Johnson County details in writing.
      </p>
      <p class="leading-7 text-muted">
        This page is for Olathe owners who want to know whether a direct sale, a
        traditional listing, or a flexible payment solution makes the most
        sense. If listing is likely better, we will tell you that too.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#olathe-ks-offer-form" class="btn btn-primary text-base"
          >Get a fast Olathe offer</a
        >
        <a
          href="tel:+18167287548"
          class="btn btn-ghost text-base"
          data-phone-link="olathe_hero">Call 816-728-7548</a
        >
      </div>
      <GoogleBusinessTrustLink class="max-w-xl" />
    </div>
    <OfferForm
      compact
      formId="olathe-ks-offer-form"
      heading="Request an Olathe offer"
      subheading="Start with the address and the best way to reach you."
      defaultSituation="Sell house fast"
      pageContext="olathe-ks"
    />
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Quick answer</p>
      <h2 class="text-3xl font-semibold text-primary">
        Yes, you can ask for an Olathe cash offer before fixing the house.
      </h2>
      <p class="text-muted">
        The real question is what you keep after repairs, commissions, buyer
        concessions, HOA items, title timing, utilities, insurance, lawn care,
        and another month of ownership.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        olatheFastSaleProof.map((item) => (
          <article class="card bg-white">
            <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        Olathe seller intent
      </p>
      <h2 class="text-3xl font-semibold text-primary">
        If you searched "sell my house fast Olathe," compare speed, certainty,
        and net.
      </h2>
      <p class="text-muted">
        Many Olathe sellers are not just chasing speed. They are trying to avoid
        repair bids, public showings, inspection surprises, tenant friction,
        estate delays, or the cost of carrying a vacant property while waiting
        for a retail buyer.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        olatheSearchSignals.map((item) => (
          <article class="card h-full">
            <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">What makes Olathe different</p>
      <h2 class="text-3xl font-semibold text-primary">
        Olathe sellers often have equity, but timing and prep work can still
        become the problem.
      </h2>
      <p class="text-muted">
        Olathe is not one simple market. A long-held Old Olathe home, a western
        Olathe subdivision property, and a rental near commuter routes can all
        need a different sale plan. We look at condition, HOA items, title,
        payoff, seller timeline, and what kind of buyer the house would attract
        if listed.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        neighborhoodPatterns.map((spot) => (
          <article
            class="card bg-white/90"
            aria-label={`Olathe property pattern: ${spot.title}`}
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
              Local pattern
            </p>
            <h3 class="mt-2 text-xl font-semibold text-primary">
              {spot.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="card space-y-4">
      <h2 class="text-2xl font-semibold text-primary">
        Common Olathe seller goals
      </h2>
      <div class="grid gap-3 md:grid-cols-2">
        {
          commonSellerGoals.map((goal) => (
            <div class="rounded-md border border-border bg-soft/60 p-3 text-sm text-primary">
              {goal}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        List or sell direct
      </p>
      <h2 class="text-3xl font-semibold text-primary">
        The best Olathe sale is the one that protects your net after repairs,
        time, and fees.
      </h2>
      <p class="text-muted">
        We are not trying to make every Olathe house a direct sale. Some should
        be listed. Others need a buyer who can take on repairs, clean-out,
        tenant issues, estate coordination, or timing pressure without turning
        the sale into another project.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        listingComparison.map((item) => (
          <article class="card bg-white">
            <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <SellerSituationLinks
    city="Olathe, KS"
    countyGuide={{
      label: "Johnson County behind-on-payments guide",
      href: "/resources/johnson-county-behind-on-payments/",
    }}
  />

  <AreaPropertyProof
    city="Olathe, KS"
    county="Johnson County"
    propertyTypes={[
      {
        title: "Old Olathe as-is houses",
        body: "Older homes with dated finishes, foundation concerns, old systems, clean-out needs, or repairs that make MLS prep expensive.",
      },
      {
        title: "Johnson County inherited homes",
        body: "Family-owned houses where heirs need title clarity, repair assumptions, clean-out help, and a closing plan that respects everyone involved.",
      },
      {
        title: "Olathe rentals and vacant houses",
        body: "Rental, tenant-occupied, vacant, or partially cleaned-out properties where access, leases, utilities, and carrying costs need a practical plan.",
      },
    ]}
  />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">
        What we review before making an Olathe offer
      </h2>
      <p class="text-muted">
        A real offer should not be a vague number. We look at condition, likely
        resale path, title items, HOA or payoff details, the seller timeline,
        and what costs stay with us after closing.
      </p>
      <ul class="space-y-3 text-sm text-primary">
        {
          netSheetItems.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-2 w-2 rounded-full bg-secondary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">
        Why Olathe sellers reach out
      </h2>
      <p class="text-muted">
        The house may be valuable, but the next step can still feel heavy.
        Repairs, family schedules, job moves, estate decisions, tenant
        coordination, and another month of holding costs can make a clean
        written offer worth comparing.
      </p>
      <p class="text-muted">
        We keep the process direct: no pressure, no public listing requirement,
        no repair demand before the walkthrough, and no surprise expectation
        that the house must be empty before we review it.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">
        Common situations we solve in Olathe
      </h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {
          situations.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-secondary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        Process
      </p>
      <h2 class="text-2xl font-semibold text-primary">
        How it works in Olathe
      </h2>
      <p class="text-muted">
        From first conversation to closing, the goal is clarity. We document
        property condition, explain the offer assumptions, and help you
        understand whether a fast as-is sale or a traditional listing is the
        smarter next move.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <div class="card">
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
              Step {index + 1}
            </p>
            <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Helpful next reads</p>
      <h2 class="text-3xl font-semibold text-primary">
        Compare the Olathe offer against the problem you are actually solving.
      </h2>
      <p class="text-muted">
        Most sellers are not just trying to sell a house. They are trying to
        avoid repair costs, protect credit, settle an estate, simplify a move,
        stop carrying a vacant property, or get clarity before the next
        deadline.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {
        internalGuides.map((guide) => (
          <a
            href={guide.href}
            class="card block bg-white transition hover:border-secondary/60"
          >
            <h3 class="text-lg font-semibold text-primary">{guide.label}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{guide.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Olathe FAQ</h2>
    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="card">
            <summary class="cursor-pointer text-base font-semibold text-primary">
              {faq.question}
            </summary>
            <p class="mt-2 text-sm text-muted">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="#olathe-ks-offer-form" class="btn btn-primary text-base"
      >Start the Olathe offer form</a
    >
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/areas/" class="btn btn-outline text-base">See all areas</a>
  </section>
</Layout>
