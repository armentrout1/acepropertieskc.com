---
import Layout from "../../../layouts/Layout.astro";
import OfferForm from "../../../components/OfferForm.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const neighborhoods = [
  {
    title: "Old Olathe",
    body: "Historic neighborhoods with mature trees and established homes. Many properties need updates or have been in families for generations.",
  },
  {
    title: "Cedar Creek",
    body: "Family-friendly subdivisions near Olathe Medical Center. Popular with relocating families who need quick closing timelines.",
  },
  {
    title: "Stonebridge & Western Olathe",
    body: "Newer developments and suburban homes where job transfers or growing families create timing pressure.",
  },
];

const situations = [
  "Inherited homes that have been in Olathe families for decades",
  "Homes needing major repairs—roofs, foundations, or outdated systems",
  "Corporate relocations requiring quick, dependable closings",
  "Divorce settlements that need neutral, written agreements",
  "Rental properties where tenant coordination adds complexity",
];

const steps = [
  {
    title: "Share your timeline",
    body: "Tell us about your Olathe property, what repairs are needed, and any timing pressures from work moves or family decisions.",
  },
  {
    title: "Property walkthrough",
    body: "We schedule a quick visit (or video) to note repairs, access needs, and any Olathe-specific considerations like HOA requirements.",
  },
  {
    title: "Choose your path",
    body: "Receive a written comparison of a straightforward cash offer and any creative options that work with your timeline and goals.",
  },
];

const commonSellerGoals = [
  "Sell my house fast in Olathe KS without repairs or showings",
  "Compare an Olathe cash offer with listing on the MLS",
  "Work around Johnson County title, HOA, school, or relocation timing",
  "Sell an inherited, vacant, tenant-occupied, or repair-heavy Olathe house",
];

const faqs = [
  {
    question: "Do you work with Olathe HOAs?",
    answer: "Yes. We review HOA resale packets, transfer requirements, and any outstanding dues. Everything is documented in your settlement statement.",
  },
  {
    question: "How do Olathe school year timelines affect closing?",
    answer: "Many Olathe families prefer closing during summer breaks to avoid school disruptions. We can schedule around the Olathe School District calendar or structure post-closing occupancy if needed."
  },
  {
    question: "Will you buy homes needing major repairs in Olathe?",
    answer: "Absolutely. Olathe's established neighborhoods often have older homes needing significant updates. We evaluate properties as-is and factor repair costs into our offer, including foundation work common in some areas."
  },
  {
    question: "Can you handle quick corporate relocations from Olathe?",
    answer: "Yes. We work with many Olathe families relocating for jobs at Garmin, Olathe Medical Center, or nearby corporate campuses. Cash offers can close in as little as two weeks once title is clear."
  },
  {
    question: "What about Johnson County requirements?",
    answer: "We're familiar with Johnson County processes, from transfer taxes to required disclosures. No surprises during closing.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Olathe KS", item: "/areas/olathe-ks/" },
  ]),
];
---

<Layout
  title="Sell My House Fast Olathe KS | We Buy Houses"
  description="Sell your Olathe KS house fast for cash or compare as-is options. No repairs, showings, or fees. Local help with HOA, school, and relocation timing."
  canonicalPath="/areas/olathe-ks/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">Olathe, Kansas</p>
      <h1 class="text-4xl font-semibold text-primary">Sell My House Fast in Olathe, KS</h1>
      <p class="text-muted">
        Olathe homeowners value clear communication and predictable outcomes. Whether you're managing an inherited family home in Old Olathe, coordinating a corporate relocation from Cedar Creek, or facing repairs that feel overwhelming, we provide straightforward cash and creative options without pressure. Our local team understands Johnson County requirements and keeps every step transparent.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn btn-primary text-base">Get an Olathe offer</a>
        <a href="/solutions/sell-house-fast/" class="btn btn-ghost text-base">Compare fast-sale options</a>
      </div>
    </div>
    <OfferForm
      compact
      formId="olathe-ks-offer-form"
      heading="Request an Olathe offer"
      subheading="Start with the address and the best way to reach you."
    />
  </section>

  <section class="section">
    <div class="card space-y-4">
      <h2 class="text-2xl font-semibold text-primary">Common Olathe seller goals</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {commonSellerGoals.map((goal) => (
          <div class="rounded-md border border-border bg-soft/60 p-3 text-sm text-primary">{goal}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Why Olathe sellers reach out</h2>
      <p class="text-muted">
        Most Olathe homeowners we work with are juggling more than just a property sale—family relocations, inherited estates, or repair costs that keep adding up. We keep the process simple, provide same-day updates, and respect the timeline you need.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">A local, service-first approach</h2>
      <p class="text-muted">
        Our team meets you in person when possible, collaborates with trusted Johnson County title partners, and outlines both cash and creative pathways. No aggressive pitches—just clear answers about value, timelines, and paperwork.
      </p>
    </article>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Olathe market context</h2>
      <p class="text-muted">
        From established Old Olathe neighborhoods to newer Stonebridge developments, each area moves differently. We track local market activity, school district timing, and contractor availability so you understand how your property fits into the current Olathe market.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Community-focused communication</h2>
      <p class="text-muted">
        Selling a family home in Olathe often involves coordinating with schools, employers, and extended family. We provide clear documentation for all parties and keep everyone informed so decisions can be made confidently.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">Common situations we solve</h2>
      <ul class="mt-4 space-y-3 text-sm text-primary">
        {situations.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-6 md:grid-cols-3">
      {neighborhoods.map((spot) => (
        <div class="card bg-white/90" aria-label={`Neighborhood focus: ${spot.title}`}>
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Neighborhood focus</p>
          <h3 class="text-xl font-semibold text-primary">{spot.title}</h3>
          <p class="mt-2 text-sm text-muted">{spot.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">How it works in Olathe</h2>
      <p class="text-muted">
        From first call to closing, you set the pace. We document property condition, confirm Johnson County requirements, and walk through creative alternatives when that protects your equity. Expect regular updates so you're never guessing what comes next.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Documents and timelines</h2>
      <p class="text-muted">
        Johnson County title companies typically need payoff statements, utility confirmations, and any HOA documentation. We gather that list for you, coordinate with your attorney if needed, and make sure every signature is timestamped so there are no surprises the week of closing.
      </p>
      <p class="text-muted">
        If you need extra time due to school calendars or work schedules, we can structure a post-closing occupancy agreement or schedule closing to align with your next move. Those options are detailed in writing alongside your cash offer.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Stay connected with local support</h2>
      <p class="text-muted">
        Need to compare selling now versus holding as a rental? Visit our <a href="/solutions/inherited-house/" class="text-secondary underline">inherited property guide</a> or <a href="/solutions/needs-repairs/" class="text-secondary underline">repairs scenario</a> for detailed breakdowns. Explore other Johnson County areas on the <a href="/areas/" class="text-secondary underline">areas page</a> or review <a href="/solutions/divorce/" class="text-secondary underline">divorce settlement options</a>.
      </p>
      <p class="text-muted">
        When questions pop up about your Olathe property, call, text, or <a href="/contact/" class="text-secondary underline">contact us online</a>. Same-day responses are standard because we only work a handful of files at a time.
      </p>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Olathe FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/areas/" class="btn btn-outline text-base">See all areas</a>
  </section>
</Layout>
