---
import Layout from "../../layouts/Layout.astro";
import SellerSituationLinks from "../../components/SellerSituationLinks.astro";
import { expansionAreas } from "../../data/areaExpansion";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../lib/seo";

const areaLinks = [
  {
    title: "ZIP 64131",
    body: "South Kansas City blocks from Waldo to Blue Ridge Boulevard.",
    href: "/areas/64131/",
  },
  {
    title: "Kansas City, MO",
    body: "In-town bungalows, Midtown fourplexes, and south side rentals.",
    href: "/areas/kansas-city-mo/",
  },
  {
    title: "Overland Park, KS",
    body: "Johnson County homes that need flexible timelines or repairs.",
    href: "/areas/overland-park-ks/",
  },
  {
    title: "Olathe, KS",
    body: "Johnson County's largest suburb with family relocations and inherited homes.",
    href: "/areas/olathe-ks/",
  },
  {
    title: "Independence, MO",
    body: "Historic homes and inherited properties in Jackson County's second-largest city.",
    href: "/areas/independence-mo/",
  },
  {
    title: "Lee's Summit, MO",
    body: "Growing Jackson County suburb with lakefront properties and family relocations.",
    href: "/areas/lees-summit-mo/",
  },
  {
    title: "Shawnee, KS",
    body: "Established Johnson County suburb with historic downtown and golf course communities.",
    href: "/areas/shawnee-ks/",
  },
  {
    title: "Lenexa, KS",
    body: "Planned community with historic district and modern developments. Popular with relocating families.",
    href: "/areas/lenexa-ks/",
  },
  ...expansionAreas.map((area) => ({
    title: `${area.city}, ${area.state}`,
    body: area.description,
    href: `/areas/${area.slug}/`,
  })),
];

const placeholderCards: string[] = [
];

const faqs = [
  {
    question: "How far outside Kansas City will you look at a property?",
    answer:
      "Most homes within roughly 30 miles of downtown Kansas City are on our radar. If you are a bit farther out, still reach out—we will confirm what travel or partner support looks like before promising anything.",
  },
  {
    question: "Do you focus on certain price points or property types?",
    answer:
      "We buy single-family homes, duplexes, and small multifamily buildings. Condition and timeline matter more than list price, and we are upfront when a traditional listing may serve you better.",
  },
  {
    question: "What if my neighborhood is not listed yet?",
    answer:
      "This hub is growing. Share the address, and we will let you know if it fits our service area or refer you to a trusted partner nearby.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs.map((faq) => ({ question: faq.question, answer: faq.answer }))),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
  ]),
];
---

<Layout
  title="Kansas City Metro Areas We Buy Houses - MO & KS"
  description="Cash home buyers serving Kansas City, Overland Park, Olathe, Independence, Lee's Summit, Kansas City KS, Blue Springs, Raytown, and nearby metro areas."
  canonicalPath="/areas/"
  jsonLd={jsonLd}
>
  <section class="section space-y-5">
    <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Service area</p>
    <h1 class="text-4xl font-semibold text-primary">Areas We Buy in the Kansas City Metro</h1>
    <p class="max-w-3xl text-muted">
      We keep things local so walkthroughs, title work, and closings stay simple. If you are within
      about 30 miles of downtown Kansas City—on either side of the state line—we are happy to review the
      property, outline next steps, and share whether a cash or flexible offer makes the most sense. Whether you need to <a href="/solutions/sell-house-fast/" class="text-secondary underline">sell fast</a>, handle an <a href="/solutions/inherited-house/" class="text-secondary underline">inherited property</a>, or deal with <a href="/solutions/needs-repairs/" class="text-secondary underline">major repairs</a>, we provide area-specific guidance.
    </p>
  </section>

  <SellerSituationLinks
    city="the Kansas City metro"
    heading="Find the right selling path for your Kansas City area"
    intro="Use the area pages for local context, then match your situation to the guide that fits the deadline, repair issue, mortgage pressure, or family timeline you are dealing with."
  />

  <section class="section">
    <div class="grid gap-6 md:grid-cols-3">
      {areaLinks.map((area) => (
        <a href={area.href} class="card h-full transition-all hover:-translate-y-1 hover:shadow-lg">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Featured area</p>
          <h2 class="text-2xl font-semibold text-primary">{area.title}</h2>
          <p class="mt-2 text-sm text-muted">{area.body}</p>
          <span class="mt-4 inline-flex items-center text-sm font-semibold text-secondary">
            Explore details →
          </span>
        </a>
      ))}

      {placeholderCards.map((name) => (
        <div class="card h-full border border-dashed border-border/80 bg-soft/60 text-muted" aria-disabled="true">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Coming soon</p>
          <h2 class="text-2xl font-semibold text-primary/70">{name}</h2>
          <p class="mt-2 text-sm">
            We are compiling recent purchases and insights for this area. Reach out if you need information sooner.
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-alt space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">How we approach each neighborhood</h2>
      <p class="text-muted">
        Every block has different permitting rules, HOA nuances, and buyer expectations. We document what we learn so
        you get clear answers about walkthrough access, closing timelines, and whether we can keep tenants or family
        members in place for a period after closing. Common situations include <a href="/solutions/probate-house/" class="text-secondary underline">probate sales</a>, <a href="/solutions/vacant-house/" class="text-secondary underline">vacant properties</a>, and <a href="/solutions/relocating/" class="text-secondary underline">job relocations</a>.
      </p>
    </div>
    <ul class="grid gap-4 md:grid-cols-3">
      <li class="card bg-white/90">
        <h3 class="text-lg font-semibold text-primary">Straight answers</h3>
        <p class="mt-2 text-sm text-muted">Know when title can clear, what repairs matter, and what paperwork is needed.</p>
      </li>
      <li class="card bg-white/90">
        <h3 class="text-lg font-semibold text-primary">Flexible timelines</h3>
        <p class="mt-2 text-sm text-muted">Close quickly for vacant homes or pace things to line up with your next move.</p>
      </li>
      <li class="card bg-white/90">
        <h3 class="text-lg font-semibold text-primary">Flexible options</h3>
        <p class="mt-2 text-sm text-muted">Compare cash, payment takeover, or other written terms when a straight sale is not the only fit.</p>
      </li>
    </ul>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Area FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with the team</a>
  </section>
</Layout>
