---
import Layout from "../../layouts/Layout.astro";
import SellerSituationLinks from "../../components/SellerSituationLinks.astro";
import { expansionAreas } from "../../data/areaExpansion";
import { SITE } from "../../lib/siteConfig";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../lib/seo";

const areaLinks = [
  {
    title: "ZIP 64131",
    body: "South Kansas City, Red Bridge, Minor Park, Waldo-adjacent blocks, and older houses near Blue River Road.",
    href: "/areas/64131/",
  },
  {
    title: "ZIP 66109",
    body: "Western Kansas City, KS and Piper-area homes with Wyandotte County title, taxes, repairs, or acreage questions.",
    href: "/areas/66109/",
  },
  {
    title: "Kansas City, MO",
    body: "In-town bungalows, Midtown fourplexes, and south side rentals.",
    href: "/areas/kansas-city-mo/",
  },
  {
    title: "Overland Park, KS",
    body: "Johnson County homes that need flexible timelines or repairs.",
    href: "/areas/overland-park-ks/",
  },
  {
    title: "Olathe, KS",
    body: "Johnson County's largest suburb with family relocations and inherited homes.",
    href: "/areas/olathe-ks/",
  },
  {
    title: "Independence, MO",
    body: "Historic homes and inherited properties in Jackson County's second-largest city.",
    href: "/areas/independence-mo/",
  },
  {
    title: "Lee's Summit, MO",
    body: "Growing Jackson County suburb with lakefront properties and family relocations.",
    href: "/areas/lees-summit-mo/",
  },
  {
    title: "Shawnee, KS",
    body: "Established Johnson County suburb with historic downtown and golf course communities.",
    href: "/areas/shawnee-ks/",
  },
  {
    title: "Lenexa, KS",
    body: "Planned community with historic district and modern developments.",
    href: "/areas/lenexa-ks/",
  },
  ...expansionAreas.map((area) => ({
    title: `${area.city}, ${area.state}`,
    body: area.description,
    href: `/areas/${area.slug}/`,
  })),
];

const featuredAreaLinks = areaLinks.slice(0, 8);
const nearbyAreaLinks = areaLinks.slice(8);
const nearbyAreaGroups = [
  {
    heading: "Missouri cities",
    items: nearbyAreaLinks.filter((area) => area.title.endsWith(", MO")),
  },
  {
    heading: "Kansas cities",
    items: nearbyAreaLinks.filter((area) => area.title.endsWith(", KS")),
  },
].filter((group) => group.items.length > 0);

const areaClusterLinks = [
  {
    eyebrow: "As-is sale ZIPs",
    title: "As-is seller ZIPs",
    body: "Older housing, repair-heavy homes, vacancy, taxes, liens, code items, tenants, inherited property, and urgent as-is sale needs.",
    href: "/resources/kansas-city-as-is-seller-zip-codes/",
    zips: ["64124", "64128", "64127", "64130", "64132", "66102", "66104", "66106"],
  },
  {
    eyebrow: "Higher-equity ZIPs",
    title: "Higher-equity ZIPs",
    body: "Fewer leads, but better upside: Brookside, Waldo, South KC, older Overland Park, Prairie Village, Leawood, Mission, Fairway, and Westwood style opportunities.",
    href: "/resources/kansas-city-higher-equity-home-sale-options/",
    zips: ["64113", "64114", "64145", "66204", "66205", "66206", "66212"],
  },
];

const faqs = [
  {
    question: "How far outside Kansas City will you look at a property?",
    answer:
      "Most homes within roughly 30 miles of downtown Kansas City are on our radar. If you are farther out, still reach out and we will confirm fit before promising anything.",
  },
  {
    question: "Do you focus on certain price points or property types?",
    answer:
      "We buy single-family homes, duplexes, and small multifamily buildings. Condition and timeline matter more than list price, and we are upfront when a traditional listing may serve you better.",
  },
  {
    question: "What if my neighborhood is not listed yet?",
    answer:
      "This hub is growing. Share the address, and we will let you know if it fits our service area or refer you to a trusted partner nearby.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs.map((faq) => ({ question: faq.question, answer: faq.answer }))),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
  ]),
];
---

<Layout
  title="Kansas City Metro Areas We Buy Houses - MO & KS"
  description="Cash home buyers serving Kansas City, Overland Park, Olathe, Independence, Lee's Summit, Kansas City KS, Blue Springs, Raytown, and nearby metro areas."
  canonicalPath="/areas/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell grid gap-8 py-12 md:py-16 lg:grid-cols-[1fr_0.8fr] lg:items-end">
      <div class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Kansas City metro</span>
          <span class="v3-pill">MO and KS</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="max-w-4xl space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.12em] text-accent">Service area</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">Areas We Buy in the Kansas City Metro</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            Start with the city or ZIP. If the property is within about 30 miles of downtown Kansas City, we can review it as-is and explain whether a cash or flexible offer makes sense.
          </p>
        </div>
      </div>

      <div class="rounded-[2rem] border border-white/12 bg-white p-5 text-primary shadow-2xl md:p-6">
        <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Not sure if we buy there?</p>
        <h2 class="mt-3 text-2xl font-black text-primary">Send the address and we will confirm.</h2>
        <p class="mt-2 text-sm leading-6 text-muted">
          You do not need to know the county, condition, or exact next step before reaching out.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          <a href="/get-offer/" class="btn btn-primary justify-center text-base">Check my address</a>
          <a href={`tel:${SITE.phoneTel}`} class="btn btn-ghost justify-center text-base" data-phone-link="areas_hero">Call {SITE.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section space-y-8">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Find your area</p>
      <h2 class="text-3xl font-black text-primary md:text-4xl">Start with the core Kansas City metro</h2>
      <p class="text-muted">
        These are the first local pages most sellers need. Choose the closest city or ZIP, then send the address if you want us to confirm fit.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {featuredAreaLinks.map((area) => (
        <a href={area.href} class="rounded-[1.5rem] border border-border/70 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:border-secondary/50 hover:shadow-lg">
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Featured area</p>
          <h2 class="mt-2 text-2xl font-black text-primary">{area.title}</h2>
          <p class="mt-2 text-sm leading-6 text-muted">{area.body}</p>
          <span class="mt-4 inline-flex items-center text-sm font-bold text-secondary">
            Explore details
          </span>
        </a>
      ))}
    </div>

    {nearbyAreaLinks.length > 0 && (
      <div class="grid gap-5 lg:grid-cols-2">
        {nearbyAreaGroups.map((group) => (
          <div class="rounded-[2rem] border border-border/70 bg-soft/70 p-6 shadow-sm">
            <div class="space-y-2">
              <h2 class="text-2xl font-black text-primary">{group.heading}</h2>
              <p class="text-sm leading-6 text-muted">
                More nearby pages for sellers comparing an as-is sale, inherited house, repairs, tenants, or payment pressure.
              </p>
            </div>
            <div class="mt-5 flex flex-wrap gap-3">
              {group.items.map((area) => (
                <a
                  href={area.href}
                  class="rounded-full border border-border bg-white px-4 py-2 text-sm font-bold text-primary transition hover:border-secondary/60 hover:text-secondary"
                >
                  {area.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="rounded-[2rem] border border-secondary/25 bg-primary p-6 text-white shadow-xl md:p-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div class="max-w-3xl space-y-2">
          <p class="text-sm font-black uppercase tracking-[0.12em] text-accent">Address check</p>
          <h2 class="text-3xl font-black text-white">Do not see your city?</h2>
          <p class="text-white/78">
            Send the property address anyway. We will tell you plainly whether ACE can review it or whether a different local path makes more sense.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/get-offer/" class="btn bg-white text-primary hover:bg-white/90">Send the address</a>
          <a href="/contact/" class="btn border border-white/40 text-white hover:bg-white/10">Ask a question</a>
        </div>
      </div>
    </div>
  </section>

  <SellerSituationLinks
    city="the Kansas City metro"
    heading="Have the location? Now match the situation."
    intro="Once you know the area fits, compare the seller problem: repairs, late payments, inherited property, tenants, vacancy, timing, or title questions."
  />

  <section class="section section-alt space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-black text-primary">How we approach each neighborhood</h2>
      <p class="max-w-3xl text-muted">
        Every block has different permitting rules, HOA expectations, title items, and buyer expectations. We keep the local conversation practical: what can close, what may slow things down, and what needs to be handled before money changes hands.
      </p>
    </div>
    <ul class="grid gap-4 md:grid-cols-3">
      <li class="card bg-white/90">
        <h3 class="text-lg font-black text-primary">Straight answers</h3>
        <p class="mt-2 text-sm text-muted">Know when title can clear, what repairs matter, and what paperwork is needed.</p>
      </li>
      <li class="card bg-white/90">
        <h3 class="text-lg font-black text-primary">Flexible timelines</h3>
        <p class="mt-2 text-sm text-muted">Close quickly for vacant homes or pace things to line up with your next move.</p>
      </li>
      <li class="card bg-white/90">
        <h3 class="text-lg font-black text-primary">Flexible options</h3>
        <p class="mt-2 text-sm text-muted">Compare cash, payment takeover, or other written terms when a straight sale is not the only fit.</p>
      </li>
    </ul>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-black text-primary">Area FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with the team</a>
  </section>
</Layout>

