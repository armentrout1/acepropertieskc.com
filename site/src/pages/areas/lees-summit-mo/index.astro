---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const neighborhoods = [
  {
    title: "Downtown Lee's Summit",
    body: "Older homes, inherited properties, dated interiors, and walkable-area houses where families may need a clean as-is option before listing.",
  },
  {
    title: "Longview and south Lee's Summit",
    body: "Established neighborhoods near Longview Lake where roof age, mechanical updates, basements, or large clean-outs can affect a retail sale.",
  },
  {
    title: "Raintree Lake and newer subdivisions",
    body: "Relocation, HOA timing, family moves, and larger homes where a written cash offer can help compare certainty against listing prep.",
  },
];

const situations = [
  "Sell my house fast Lee's Summit searches where timing is the main pressure",
  "Inherited homes that have been in Lee's Summit families for years",
  "Homes needing major repairs like roofs, foundations, or outdated systems",
  "Divorce or family settlements requiring neutral written numbers",
  "Corporate relocations or move deadlines that need a dependable closing",
  "Rental properties with long-term tenants requiring a careful transition",
];

const countyDetails = [
  {
    title: "Jackson County title work",
    body:
      "Payoffs, liens, taxes, estate documents, and owner signatures need to be clear before a closing date is real. We help identify those items early.",
  },
  {
    title: "As-is repair decisions",
    body:
      "A direct offer can account for updates, clean-out, roof age, foundation concerns, or tenant coordination without asking you to spend money first.",
  },
  {
    title: "Timing that respects your move",
    body:
      "Fast does not have to mean rushed. We can compare a quick cash closing with a later date, school-calendar move, or family transition plan.",
  },
];

const steps = [
  {
    title: "Share your Lee's Summit story",
    body: "Tell us about the property, repair concerns, occupancy, title questions, and the timing pressure you are trying to solve.",
  },
  {
    title: "Review the house and county details",
    body: "We schedule a walkthrough or video review, then look at repairs, access issues, payoffs, taxes, and Jackson County requirements.",
  },
  {
    title: "Choose your solution",
    body: "You receive a written comparison of a straightforward cash offer and any flexible options that match your timeline and financial goals.",
  },
];

const faqs = [
  {
    question: "Do you buy houses fast in Lee's Summit?",
    answer: "Yes. ACE Properties KC reviews Lee's Summit houses for as-is cash offers and flexible options. A fast closing depends on title, payoffs, occupancy, and seller readiness.",
  },
  {
    question: "Do you buy homes near Longview Lake?",
    answer: "Yes. We review Lee's Summit properties near Longview, Raintree Lake, Downtown Lee's Summit, and nearby Jackson County neighborhoods.",
  },
  {
    question: "How quickly can you close on Lee's Summit properties?",
    answer: "Cash offers can close in as little as two weeks once Jackson County title work is complete. We can also accommodate longer timelines for family transitions.",
  },
  {
    question: "Will you buy houses needing major renovations?",
    answer: "Yes. We evaluate properties as-is and factor renovation costs into our offer, including common issues like outdated kitchens, bathrooms, roofs, basements, and mechanical systems.",
  },
  {
    question: "Can you help with divorce or family settlements?",
    answer: "Yes. We can provide neutral, written numbers that attorneys, spouses, heirs, or family decision-makers can review before anyone signs.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Lee's Summit MO", item: "/areas/lees-summit-mo/" },
  ]),
];
---

<Layout
  title="Sell My House Fast Lee's Summit MO | Cash Offer"
  description="Sell my house fast in Lee's Summit MO. Local as-is cash offers for repairs, inherited homes, relocation, tenants, and Jackson County title timing."
  canonicalPath="/areas/lees-summit-mo/"
  jsonLd={jsonLd}
>
  <section class="section space-y-4">
    <p class="badge">Lee's Summit, Missouri</p>
    <h1 class="text-4xl font-black text-primary md:text-5xl">Sell My House Fast in Lee's Summit, MO</h1>
    <p class="max-w-3xl text-lg leading-8 text-muted">
      Lee's Summit sellers usually need more than a quick number. They need to know whether repairs, Jackson County title work, tenants, relocation timing, or family decisions can be handled without a drawn-out listing process.
    </p>
    <p class="max-w-3xl text-muted">
      ACE reviews Lee's Summit houses as-is and gives you written cash and flexible options so you can compare certainty, timing, and net proceeds before deciding.
    </p>
  </section>

  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Need a Lee's Summit offer?</h2>
      <p class="text-muted">
        Send the address and the situation. We will review condition, timing, Jackson County title items, and whether a direct as-is sale is worth comparing.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/resources/jackson-county-cash-home-buyers/" class="btn btn-outline text-base">Jackson County cash buyer guide</a>
        <a href="/resources/sell-house-fast-kansas-city-guide/" class="btn btn-ghost text-base">Fast-sale guide</a>
      </div>
    </div>
    <OfferForm
      compact
      formId="lees-summit-mo-offer-form"
      heading="Request a Lee's Summit offer"
      subheading="Start with the address and the best way to reach you."
      defaultSituation="sell house fast"
      pageContext="lees-summit-mo"
    />
  </section>

  <SellerSituationLinks
    city="Lee's Summit, MO"
    countyGuide={{ label: "Jackson County foreclosure options", href: "/resources/jackson-county-foreclosure-options/" }}
  />

  <AreaPropertyProof city="Lee's Summit, MO" county="Jackson County" />

  <section class="section grid gap-5 md:grid-cols-3">
    {countyDetails.map((item) => (
      <article class="card space-y-3">
        <h2 class="text-xl font-black text-primary">{item.title}</h2>
        <p class="text-sm leading-6 text-muted">{item.body}</p>
      </article>
    ))}
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Why Lee's Summit sellers reach out</h2>
      <p class="text-muted">
        Most Lee's Summit homeowners we work with are managing more than price: family relocations, inherited estates, divorce settlements, tenants, or repair costs that keep growing.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">A local, service-first approach</h2>
      <p class="text-muted">
        We meet in person when possible, coordinate with trusted Jackson County title partners, and outline both cash and flexible pathways. No aggressive tactics - just honest answers about value, timelines, and paperwork.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-black text-primary">Common situations we solve</h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {situations.map((item) => (
          <li class="flex items-start gap-3 rounded-[1rem] border border-border/70 bg-soft/60 p-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-6 md:grid-cols-3">
      {neighborhoods.map((spot) => (
        <div class="card bg-white/90" aria-label={`Neighborhood focus: ${spot.title}`}>
          <p class="text-sm font-black uppercase tracking-[0.1em] text-secondary">Neighborhood focus</p>
          <h3 class="text-xl font-black text-primary">{spot.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-3">
      <h2 class="text-2xl font-black text-primary">How it works in Lee's Summit</h2>
      <p class="text-muted">
        From first conversation to closing, you control the timeline. We document property condition, navigate Jackson County requirements, and review flexible options when they better serve your situation.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-sm font-black uppercase tracking-[0.1em] text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-black text-primary">{step.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Documents and timelines</h2>
      <p class="text-muted">
        Jackson County title companies typically need payoff statements, utility clearances, owner signatures, and any settlement documentation. We gather that list early so the closing date is based on facts.
      </p>
      <p class="text-muted">
        If you need extra time due to school calendars or family coordination, we can structure flexible closing dates or post-closing arrangements in writing.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Stay connected with local support</h2>
      <p class="text-muted">
        Need to compare selling now versus holding as a rental? Visit our <a href="/solutions/inherited-house/" class="text-secondary underline">inherited property guide</a> or <a href="/solutions/needs-repairs/" class="text-secondary underline">major repairs scenario</a> for detailed breakdowns.
      </p>
      <p class="text-muted">
        If the sale is tied to late payments, lender notices, or payoff deadlines, compare the <a href="/resources/jackson-county-foreclosure-options/" class="text-secondary underline">Jackson County foreclosure options guide</a> and the <a href="/resources/jackson-county-cash-home-buyers/" class="text-secondary underline">Jackson County cash home buyers guide</a>.
      </p>
    </article>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-black text-primary">Lee's Summit FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/areas/" class="btn btn-outline text-base">See all areas</a>
  </section>
</Layout>