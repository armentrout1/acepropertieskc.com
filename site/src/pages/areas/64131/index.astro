---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const faqs = [
  {
    question: "Will you still buy if major repairs are needed?",
    answer: "Yes. Properties in 64131 often have older roofs, foundations, or HVAC systems, and we buy them as-is."
  },
  {
    question: "What if the house is inherited?",
    answer: "We coordinate with heirs, probate attorneys, or personal representatives to keep everyone aligned before closing."
  },
  {
    question: "Can I sell with tenants in place?",
    answer: "Absolutely. We communicate with tenants respectfully and can keep leases in place until you prefer to vacate."
  },
  {
    question: "How soon do I get paid?",
    answer: "Once title is clear, cash closings can happen in about two weeks. Flexible structures follow whatever schedule we agree on."
  }
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "64131", item: "/areas/64131/" },
  ]),
];
---

<Layout
  title="Sell Your 64131 House As-Is | Red Bridge & Minor Park"
  description="Local Kansas City home buyers focused on 64131, Red Bridge, Minor Park, and South KC. Sell as-is for cash or compare flexible options."
  canonicalPath="/areas/64131/"
  jsonLd={jsonLd}
>
  <section class="section space-y-4">
    <p class="badge">Kansas City, MO</p>
    <h1 class="text-4xl font-semibold text-primary">Sell Your House As-Is in 64131, Red Bridge, and Minor Park</h1>
    <p class="text-muted">
      From Waldo-adjacent blocks and Armour Hills to Red Bridge, Minor Park, Blue River Road, and the south Kansas City neighborhoods around ZIP 64131, we help homeowners solve repairs, inherited estates, vacant-house costs, payment pressure, or rental challenges without listing first. Our Kansas City metro team keeps communication clear and timelines flexible.
    </p>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">South Kansas City focus</p>
      <h2 class="text-3xl font-semibold text-primary">Cash home buyers in 64131 should understand Red Bridge and Minor Park property issues.</h2>
      <p class="text-muted">
        Older ranch homes, long-held family houses, rentals, vacant properties, and repair-heavy homes in this pocket can all have different title, clean-out, and repair questions. We compare the as-is offer against listing prep before you decide.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <article class="card bg-white">
        <h3 class="text-lg font-semibold text-primary">Red Bridge and Minor Park homes</h3>
        <p class="mt-2 text-sm text-muted">Useful when the house needs updates, the yard or exterior has become hard to manage, or timing matters more than a full retail prep plan.</p>
      </article>
      <article class="card bg-white">
        <h3 class="text-lg font-semibold text-primary">Inherited or long-held houses</h3>
        <p class="mt-2 text-sm text-muted">Family-owned homes may need title review, clean-out, belongings handled, repairs estimated, and one clear option for heirs to compare.</p>
      </article>
      <article class="card bg-white">
        <h3 class="text-lg font-semibold text-primary">Vacant or repair-heavy property</h3>
        <p class="mt-2 text-sm text-muted">Utilities, insurance, lawn care, security, and deferred repairs can stack up. We can compare those costs with an as-is sale path.</p>
      </article>
    </div>
  </section>

  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Selling in 64131?</h2>
      <p class="text-muted">
        Share the address and timeline. We can review nearby repairs, title considerations, and whether a quick as-is offer fits.
      </p>
    </div>
    <OfferForm
      compact
      formId="64131-offer-form"
      heading="Request a 64131 offer"
      subheading="Start with the property address and contact info."
    />
  </section>

  <SellerSituationLinks
    city="64131 in Kansas City, MO"
    countyGuide={{ label: "Jackson County foreclosure options", href: "/resources/jackson-county-foreclosure-options/" }}
    heading="Match your 64131 situation to the right selling path"
  />

  <AreaPropertyProof city="ZIP 64131" county="Jackson County" />

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">Common scenarios we handle</h2>
      <ul class="mt-4 space-y-3 text-sm text-primary">
        <li>Major repairs or unfinished projects you don't want to fund.</li>
        <li>Inherited homes that need coordination with siblings or probate.</li>
        <li>Tenant-occupied rentals where you prefer a quiet transition.</li>
        <li>Payments behind or looming deadlines that require quick clarity. Start with the <a href="/resources/jackson-county-foreclosure-options/" class="text-secondary underline">Jackson County foreclosure options guide</a> if lender timing is part of the decision.</li>
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="card bg-white/90">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step 1</p>
        <h3 class="text-xl font-semibold text-primary">Tell us about the house</h3>
        <p class="text-sm text-muted">Share the address, timeline, and anything unique about the property.</p>
      </div>
      <div class="card bg-white/90">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step 2</p>
        <h3 class="text-xl font-semibold text-primary">Walkthrough</h3>
        <p class="text-sm text-muted">We schedule a quick visit or video call to confirm repairs, tenants, or access needs.</p>
      </div>
      <div class="card bg-white/90">
        <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step 3</p>
        <h3 class="text-xl font-semibold text-primary">Pick your option</h3>
        <p class="text-sm text-muted">Choose between a cash sale or a flexible agreement built around your goals.</p>
      </div>
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">64131 FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">
      Start the offer form
    </a>
    <a href="/contact/" class="btn btn-ghost text-base">
      Contact us
    </a>
  </section>
</Layout>
