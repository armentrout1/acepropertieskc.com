---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const neighborhoods = [
  {
    title: "Midtown & Brookside",
    body:
      "Older homes, long-held family properties, and projects that may need clean-out, repair planning, or heir coordination.",
  },
  {
    title: "South KC & 64131",
    body:
      "Ranches and split-levels where roofs, mechanicals, trees, foundations, or contents can make a listing harder.",
  },
  {
    title: "East Side & Historic Districts",
    body:
      "Unique layouts, rental licenses, historic requirements, and title questions that need a buyer who can slow down and review details.",
  },
];

const situations = [
  "Inherited houses that still have furniture, files, or belongings inside",
  "Repair or code items that make a traditional buyer nervous",
  "Tenants on month-to-month leases where notice needs to be handled carefully",
  "Late payments, taxes, or payoff pressure that require a calm plan",
  "Relocation timelines where you need a dependable buyer before listing",
];

const steps = [
  {
    title: "Share the story",
    body:
      "Tell us what is happening with the house, who needs to be involved, and what timeline would actually help.",
  },
  {
    title: "Confirm details",
    body:
      "We review condition, title items, payoffs, and whether a cash or flexible option fits better.",
  },
  {
    title: "Choose your path",
    body:
      "You receive written numbers, timelines, and next steps before deciding what to do.",
  },
];

const faqs = [
  {
    question: "Do I need to clear everything out first?",
    answer:
      "No. Many Kansas City homes we buy still have furniture, files, tools, or belongings inside. Clean-out can be handled after closing when agreed to in writing.",
  },
  {
    question: "Will you still buy if there are city violations?",
    answer:
      "Yes. We review the notices, coordinate with title when needed, and explain how the required repairs or escrow affect the offer.",
  },
  {
    question: "Can you work with my attorney or advisor?",
    answer:
      "Absolutely. We encourage you to involve attorneys, CPAs, financial planners, or family advisors so everyone sees the same documents and closing timeline.",
  },
  {
    question: "How soon could we close?",
    answer:
      "Cash deals often close in about two weeks after title is clear. Flexible agreements depend on the structure, and we outline milestones in writing.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Kansas City MO", item: "/areas/kansas-city-mo/" },
  ]),
];
---

<Layout
  title="We Buy Houses Kansas City MO - Cash Offers in 24 Hours"
  description="Kansas City home buyers. Fair cash offers for Midtown, Brookside, and South KC properties. Close in 2 weeks or on your timeline. No repairs needed."
  canonicalPath="/areas/kansas-city-mo/"
  jsonLd={jsonLd}
>
  <section class="section space-y-4">
    <p class="badge">Kansas City, Missouri</p>
    <h1 class="text-4xl font-black text-primary md:text-5xl">Sell Your House As-Is in Kansas City</h1>
    <p class="max-w-3xl text-lg leading-8 text-muted">
      Whether the property is inherited, dated, tenant-occupied, behind on payments, or simply too much to repair, ACE can review the address and explain a direct cash or flexible option without asking you to remodel first.
    </p>
  </section>

  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Want a Kansas City offer?</h2>
      <p class="text-muted">
        Send the address and what you are trying to solve. We will review condition, timing, title items, and whether an as-is sale makes sense.
      </p>
    </div>
    <OfferForm
      compact
      formId="kansas-city-mo-offer-form"
      heading="Get a local KC offer"
      subheading="A short form is enough to start the conversation."
    />
  </section>

  <SellerSituationLinks
    city="Kansas City, MO"
    countyGuide={{ label: "Jackson County foreclosure options", href: "/resources/jackson-county-foreclosure-options/" }}
  />

  <AreaPropertyProof city="Kansas City, MO" county="Jackson County" />

  <section class="section grid gap-6 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Why sellers reach out</h2>
      <p class="text-muted">
        Most people we meet are solving more than a sale: family decisions, estate paperwork, repairs, tenants, payoffs, or a deadline. We keep the conversation simple and put the options in writing.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">When listing may still be better</h2>
      <p class="text-muted">
        If the house is updated, vacant, and you have time for showings, a traditional listing may net more. We will say that plainly and can still help you compare the as-is numbers.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-black text-primary">Common situations we solve</h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {situations.map((item) => (
          <li class="flex items-start gap-3 rounded-[1rem] border border-border/70 bg-soft/60 p-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-5 md:grid-cols-3">
      {neighborhoods.map((spot) => (
        <div class="card bg-white/90" aria-label={`Neighborhood focus: ${spot.title}`}>
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Neighborhood focus</p>
          <h3 class="mt-2 text-xl font-black text-primary">{spot.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-3">
      <h2 class="text-2xl font-black text-primary">How it works in Kansas City</h2>
      <p class="text-muted">
        You choose the pace. We document condition, confirm title and payoff items, and compare practical options before you make a decision.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Step {index + 1}</p>
          <h3 class="mt-2 text-lg font-black text-primary">{step.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-black text-primary">Kansas City FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/options/" class="btn btn-outline text-base">Compare options</a>
  </section>
</Layout>
