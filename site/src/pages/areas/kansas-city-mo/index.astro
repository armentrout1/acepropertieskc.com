---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const neighborhoods = [
  {
    title: "Midtown, Brookside, and Waldo",
    body:
      "Older homes, long-held family properties, and dated houses where repairs, clean-out, and timing can matter more than open houses.",
  },
  {
    title: "South KC, Red Bridge, and 64131",
    body:
      "Ranches and split-levels where roofs, mechanicals, trees, foundations, or contents can make a traditional listing harder.",
  },
  {
    title: "East Side and historic neighborhoods",
    body:
      "Unique layouts, rental history, code items, and title questions that need a buyer who can slow down and review details.",
  },
  {
    title: "Jackson County timing",
    body:
      "Payoffs, taxes, liens, probate authority, tenant access, and city notices can all affect how quickly a clean closing can happen.",
  },
];

const situations = [
  "You searched for sell my house fast Kansas City MO and need a direct local answer",
  "Inherited houses that still have furniture, files, or belongings inside",
  "Repair or code items that make a traditional buyer nervous",
  "Tenants on month-to-month leases where notice needs to be handled carefully",
  "Late payments, back taxes, or payoff pressure that require a calm plan",
  "Relocation timelines where you need a dependable buyer before listing",
];

const buyerQuestions = [
  {
    title: "Can a cash buyer close quickly?",
    body:
      "Often, yes, but only after title, payoff, ownership, and occupancy details are clear. A real cash buyer should explain what can close fast and what could slow it down.",
  },
  {
    title: "Do I need repairs first?",
    body:
      "No. A direct as-is offer can account for roof age, foundation concerns, outdated interiors, clean-out, code items, and other repair costs before closing.",
  },
  {
    title: "What if listing might pay more?",
    body:
      "If the house is updated and you have time, listing may be better. We help compare the direct offer against repairs, commissions, holding costs, and delay risk.",
  },
];

const steps = [
  {
    title: "Share the address",
    body:
      "Tell us what is happening with the house, who needs to be involved, and what timeline would actually help.",
  },
  {
    title: "Review the facts",
    body:
      "We look at condition, title items, payoffs, occupancy, taxes, and whether a cash or flexible option fits better.",
  },
  {
    title: "Compare the path",
    body:
      "You receive written numbers, a realistic timeline, and next steps before deciding whether to sell directly or list.",
  },
];

const faqs = [
  {
    question: "Do you buy houses fast in Kansas City, MO?",
    answer:
      "Yes. ACE Properties KC reviews Kansas City, Missouri houses for direct as-is cash offers and flexible options. A fast closing depends on clear title, payoffs, occupancy, and seller readiness.",
  },
  {
    question: "Do I need to clear everything out first?",
    answer:
      "No. Many Kansas City homes we buy still have furniture, files, tools, or belongings inside. Clean-out can be handled after closing when agreed to in writing.",
  },
  {
    question: "Will you still buy if there are city violations?",
    answer:
      "Yes. We review the notices, coordinate with title when needed, and explain how the required repairs or escrow affect the offer.",
  },
  {
    question: "Can you work with my attorney or advisor?",
    answer:
      "Absolutely. We encourage you to involve attorneys, CPAs, financial planners, or family advisors so everyone sees the same documents and closing timeline.",
  },
  {
    question: "How soon could we close?",
    answer:
      "Cash deals often close in about two weeks after title is clear. Flexible agreements depend on the structure, and we outline milestones in writing.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Kansas City MO", item: "/areas/kansas-city-mo/" },
  ]),
];
---

<Layout
  title="Sell My House Fast Kansas City MO | Cash Home Buyers"
  description="Sell my house fast in Kansas City MO. Local cash home buyers for as-is houses, repairs, tenants, inherited property, back taxes, and quick closings."
  canonicalPath="/areas/kansas-city-mo/"
  jsonLd={jsonLd}
>
  <section class="section space-y-4">
    <p class="badge">Kansas City, Missouri</p>
    <h1 class="text-4xl font-black text-primary md:text-5xl">Sell My House Fast in Kansas City, MO</h1>
    <p class="max-w-3xl text-lg leading-8 text-muted">
      If you need to sell a Kansas City house quickly, the real question is not just price. It is whether the buyer can solve repairs, title items, taxes, clean-out, tenants, and timing without making the situation harder.
    </p>
    <p class="max-w-3xl text-muted">
      ACE reviews Kansas City, Missouri houses as-is and explains direct cash offers, flexible payment options, and when listing may still be the better path.
    </p>
  </section>

  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Want a Kansas City offer?</h2>
      <p class="text-muted">
        Send the address and what you are trying to solve. We will review condition, timing, Jackson County title items, and whether an as-is sale makes sense.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/resources/jackson-county-cash-home-buyers/" class="btn btn-outline text-base">Jackson County cash buyer guide</a>
        <a href="/resources/sell-house-fast-kansas-city-guide/" class="btn btn-ghost text-base">Fast-sale guide</a>
      </div>
    </div>
    <OfferForm
      compact
      formId="kansas-city-mo-offer-form"
      heading="Get a local KC offer"
      subheading="A short form is enough to start the conversation."
      defaultSituation="sell house fast"
      pageContext="kansas-city-mo"
    />
  </section>

  <SellerSituationLinks
    city="Kansas City, MO"
    countyGuide={{ label: "Jackson County foreclosure options", href: "/resources/jackson-county-foreclosure-options/" }}
  />

  <AreaPropertyProof city="Kansas City, MO" county="Jackson County" />

  <section class="section grid gap-5 md:grid-cols-3">
    {buyerQuestions.map((item) => (
      <article class="card space-y-3">
        <h2 class="text-xl font-black text-primary">{item.title}</h2>
        <p class="text-sm leading-6 text-muted">{item.body}</p>
      </article>
    ))}
  </section>

  <section class="section grid gap-6 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Why Kansas City sellers reach out</h2>
      <p class="text-muted">
        Most people we meet are solving more than a sale: family decisions, estate paperwork, repairs, tenants, payoffs, taxes, or a deadline. We keep the conversation simple and put the options in writing.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">When listing may still be better</h2>
      <p class="text-muted">
        If the house is updated, easy to show, and you have time for retail buyers, a traditional listing may net more. We will say that plainly and can still help you compare the as-is numbers.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-black text-primary">Common situations we solve</h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {situations.map((item) => (
          <li class="flex items-start gap-3 rounded-[1rem] border border-border/70 bg-soft/60 p-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {neighborhoods.map((spot) => (
        <div class="card bg-white/90" aria-label={`Neighborhood focus: ${spot.title}`}>
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Local focus</p>
          <h3 class="mt-2 text-xl font-black text-primary">{spot.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-3">
      <h2 class="text-2xl font-black text-primary">How it works in Kansas City</h2>
      <p class="text-muted">
        You choose the pace. We document condition, confirm title and payoff items, and compare practical options before you make a decision.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Step {index + 1}</p>
          <h3 class="mt-2 text-lg font-black text-primary">{step.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-black text-primary">Kansas City FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/options/" class="btn btn-outline text-base">Compare options</a>
  </section>
</Layout>