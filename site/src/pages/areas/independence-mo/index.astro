---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const neighborhoods = [
  {
    title: "Independence Square",
    body: "Historic homes, older systems, estate properties, and repair questions near the downtown core.",
  },
  {
    title: "Western Independence",
    body: "Mid-century homes where inherited property, dated finishes, roofs, and foundations often drive the decision.",
  },
  {
    title: "Little Blue Valley",
    body: "Ranches, newer pockets, and family relocations where timing matters as much as the sale price.",
  },
];

const situations = [
  "Inherited homes that have been in the family for years",
  "Major repair items such as foundations, roofs, plumbing, or electrical",
  "Pre-foreclosure or payoff pressure requiring a reliable buyer",
  "Senior downsizing when upkeep has become too much",
  "Rental properties with tenants that need a respectful transition",
];

const steps = [
  {
    title: "Share the situation",
    body: "Tell us what is happening with the property, repairs, title, tenants, or family timeline.",
  },
  {
    title: "Review the house",
    body: "We walk through in person or by video, then check Jackson County title and payoff items.",
  },
  {
    title: "Compare written options",
    body: "You receive a cash path and any flexible option that may fit your timeline better.",
  },
];

const commonSellerGoals = [
  "Sell without repairs or cleanup",
  "Get cash before listing",
  "Handle inherited property, code issues, back taxes, or urgent timing",
  "Compare an as-is offer with agent fees, repairs, and holding costs",
];

const faqs = [
  {
    question: "Do you buy homes in Independence's historic districts?",
    answer:
      "Yes. We can review historic-district requirements and still make an as-is offer when the numbers and title work make sense.",
  },
  {
    question: "How quickly can you close on Independence properties?",
    answer:
      "Cash offers can often close in about two weeks once Jackson County title work is complete. We can also accommodate longer timelines.",
  },
  {
    question: "Will you buy houses with major code violations?",
    answer:
      "Yes. We review notices, repairs, and compliance costs before putting the offer in writing.",
  },
  {
    question: "Can you help with inherited estate properties?",
    answer:
      "Yes. We coordinate with heirs, probate attorneys, and title partners so the family can make a decision from the same written information.",
  },
  {
    question: "What about Jackson County property taxes?",
    answer:
      "Outstanding taxes and liens are handled through the settlement statement so you can see the net proceeds before closing.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Independence MO", item: "/areas/independence-mo/" },
  ]),
];
---

<Layout
  title="Sell My House Fast Independence MO | Cash Offer"
  description="Sell your Independence MO house fast for cash or compare as-is options. Help with historic homes, estates, code issues, repairs, and Jackson County title."
  canonicalPath="/areas/independence-mo/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">Independence, Missouri</p>
      <h1 class="text-4xl font-black text-primary md:text-5xl">Sell My House Fast in Independence, MO</h1>
      <p class="max-w-3xl text-lg leading-8 text-muted">
        If the house is inherited, dated, tenant-occupied, behind on payments, or too much to repair, ACE can review the address and compare a direct cash purchase with flexible options.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn btn-primary text-base">Get an Independence offer</a>
        <a href="/options/" class="btn btn-ghost text-base">Compare options</a>
      </div>
    </div>
    <OfferForm
      compact
      formId="independence-mo-offer-form"
      heading="Request an Independence offer"
      subheading="Start with the address and the best way to reach you."
    />
  </section>

  <section class="section">
    <div class="card space-y-4">
      <h2 class="text-2xl font-black text-primary">Common Independence seller goals</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {commonSellerGoals.map((goal) => (
          <div class="rounded-[1rem] border border-border bg-soft/60 p-3 text-sm font-semibold text-primary">{goal}</div>
        ))}
      </div>
    </div>
  </section>

  <SellerSituationLinks
    city="Independence, MO"
    countyGuide={{ label: "Jackson County foreclosure options", href: "/resources/jackson-county-foreclosure-options/" }}
  />

  <AreaPropertyProof city="Independence, MO" county="Jackson County" />

  <section class="section grid gap-6 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">Why Independence sellers reach out</h2>
      <p class="text-muted">
        Most sellers are dealing with repair costs, estate questions, late payments, tenants, or a timing problem that does not fit a normal listing.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-black text-primary">A local, service-first approach</h2>
      <p class="text-muted">
        We coordinate with Jackson County title partners, put the numbers in writing, and explain when listing may be better than selling directly.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-black text-primary">Common situations we solve</h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {situations.map((item) => (
          <li class="flex items-start gap-3 rounded-[1rem] border border-border/70 bg-soft/60 p-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-5 md:grid-cols-3">
      {neighborhoods.map((spot) => (
        <div class="card bg-white/90" aria-label={`Neighborhood focus: ${spot.title}`}>
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Neighborhood focus</p>
          <h3 class="mt-2 text-xl font-black text-primary">{spot.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="max-w-3xl space-y-3">
      <h2 class="text-2xl font-black text-primary">How it works in Independence</h2>
      <p class="text-muted">
        From first conversation to closing, you control the pace. We document condition, review Jackson County requirements, and show the practical paths in writing.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-xs font-black uppercase tracking-[0.1em] text-secondary">Step {index + 1}</p>
          <h3 class="mt-2 text-lg font-black text-primary">{step.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-black text-primary">Independence FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-black text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/areas/" class="btn btn-outline text-base">See all areas</a>
  </section>
</Layout>
