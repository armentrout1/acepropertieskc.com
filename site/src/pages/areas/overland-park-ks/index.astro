---
import Layout from "../../../layouts/Layout.astro";
import AreaPropertyProof from "../../../components/AreaPropertyProof.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import { buildBreadcrumbList, webSiteJsonLd, localBusinessJsonLd, faqJsonLd } from "../../../lib/seo";

const neighborhoods = [
  {
    title: "Central Overland Park",
    body:
      "Classic Johnson County split-levels and ranch homes near historic downtown. Many need cosmetic updates or better accessibility. We handle both.",
  },
  {
    title: "Blue Valley & South OP",
    body:
      "Larger homes where timing is tied to work relocations, school calendars, or coordinating a new build. We tailor closing dates to your next move.",
  },
  {
    title: "North OP & I-35 Corridor",
    body:
      "Townhomes and rentals with HOA considerations plus tenants who need respectful communication. We keep notices documented and clear.",
  },
];

const situations = [
  "Inherited homes that sat while families coordinated across states",
  "Deferred maintenance - roofs, foundations, or HVAC needing cash to fix",
  "Rental portfolios with long-term tenants you would like to transition smoothly",
  "Payment pressure from job changes or medical expenses",
  "Divorce settlements that need neutral, written timelines",
];

const overlandParkFastSaleProof = [
  {
    title: "No prep work first",
    body:
      "We review Overland Park homes as-is, including dated interiors, accessibility issues, foundation work, roof concerns, and clean-out needs.",
  },
  {
    title: "HOA and title clarity",
    body:
      "We discuss resale packets, dues, payoff timing, tenant status, and Johnson County title items before you decide.",
  },
  {
    title: "Written net comparison",
    body:
      "Compare a direct offer with listing prep, commissions, inspection concessions, buyer financing delays, and another month of ownership.",
  },
];

const overlandParkCashBuyerSignals = [
  {
    title: "Cash offer before repairs",
    body:
      "Useful when the house needs roof, foundation, HVAC, cosmetic, accessibility, or clean-out work before a retail buyer would feel comfortable.",
  },
  {
    title: "Johnson County title and HOA timing",
    body:
      "Overland Park closings can involve HOA resale packets, payoff timing, title review, and possession plans. We flag those early so the cash offer is tied to a real path.",
  },
  {
    title: "Compare cash buyer vs listing",
    body:
      "If the house is market-ready, listing may deserve a look. If speed, privacy, no showings, or no repairs matter more, a direct buyer can be the cleaner option.",
  },
];

const overlandParkIntentBlocks = [
  {
    title: "Sell my house fast Overland Park",
    body:
      "A direct offer can make sense when speed, privacy, repairs, HOA documents, or possession timing matter more than running a full public listing process.",
  },
  {
    title: "Cash home buyers in Overland Park",
    body:
      "The offer should explain repair assumptions, payoff timing, HOA resale items, closing costs, and what you net after the title company balances the file.",
  },
  {
    title: "Sell my house as-is Overland Park Kansas",
    body:
      "You can ask for an as-is review before replacing systems, updating finishes, clearing everything out, or coordinating repeated showings.",
  },
];
const steps = [
  {
    title: "Set expectations",
    body:
      "We discuss your timeline, decision-makers, HOA requirements, and whether cash or flexible terms sound best.",
  },
  {
    title: "On-site walkthrough",
    body:
      "A short visit (or video) to note repairs, tenant status, and any documents title will need. We keep it respectful and efficient.",
  },
  {
    title: "Written offer choices",
    body:
      "You receive a side-by-side summary of a straightforward cash offer plus any flexible structure that protects equity or income.",
  },
];

const commonSellerGoals = [
  "Sell my house fast in Overland Park without repairs or showings",
  "Talk with cash home buyers in Overland Park before listing",
  "Compare a direct offer with agent commissions, HOA items, and holding costs",
  "Coordinate an inherited, vacant, tenant-occupied, or repair-heavy Johnson County sale",
];

const faqs = [
  {
    question: "Are your offers competitive with listing on the MLS?",
    answer:
      "We provide a net sheet comparing a quick, certainty-based sale with the timeline and costs of listing. Many homeowners choose us to avoid repairs, concessions, and double moves, but we will tell you if listing could put more in your pocket.",
  },
  {
    question: "Do you work with HOAs?",
    answer:
      "Yes. We review HOA resale packets, dues, and transfer requirements early so nothing delays closing. Any outstanding balances are addressed in the settlement statement.",
  },
  {
    question: "Can you accommodate school-year timelines?",
    answer:
      "Absolutely. Families often want to remain in place through the semester. We can schedule closing after a specific date or lease the home back to you temporarily.",
  },
  {
    question: "Will I pay for repairs or commissions?",
    answer:
      "No repairs or commissions are required. Standard closing costs are outlined before you sign, and we cover what we commit to in writing.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Overland Park KS", item: "/areas/overland-park-ks/" },
  ]),
];
---

<Layout
  title="Cash Home Buyers Overland Park KS | Sell Fast"
  description="Cash home buyers in Overland Park KS. Sell your Overland Park house fast as-is with no repairs, no showings, HOA/title help, and flexible closing."
  canonicalPath="/areas/overland-park-ks/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">Cash home buyers in Overland Park KS</p>
      <h1 class="text-4xl font-semibold text-primary">Cash Home Buyers Overland Park KS - Sell Fast As-Is</h1>
      <p class="text-lg leading-8 text-muted">
        If you need to sell an Overland Park house fast, you should not have to start with repairs, staging, public showings, or months of uncertainty. We review the property as-is, explain Johnson County title and HOA details, and give you a written cash or flexible option you can compare against listing.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/get-offer/" class="btn btn-primary text-base">Get a fast Overland Park offer</a>
        <a href="tel:+18167287548" class="btn btn-ghost text-base" data-phone-link="overland_park_hero">Call 816-728-7548</a>
      </div>
    </div>
    <OfferForm
      compact
      formId="overland-park-ks-offer-form"
      heading="Request an Overland Park offer"
      subheading="Start with the address and the best way to reach you."
    />
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Quick answer</p>
      <h2 class="text-3xl font-semibold text-primary">Yes, you can ask for an Overland Park cash offer before prepping the house.</h2>
      <p class="text-muted">
        A direct sale helps when repairs, HOA details, tenants, estate decisions, or relocation timing make a traditional listing hard to manage. We give you the numbers and the timeline in writing so you can make a practical decision.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {overlandParkFastSaleProof.map((item) => (
        <article class="card bg-white">
          <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Overland Park cash buyer review</p>
      <h2 class="text-3xl font-semibold text-primary">Cash Home Buyers in Overland Park, KS</h2>
      <p class="text-muted">
        If you are comparing cash home buyers in Overland Park, the right question is not just who can close fast. It is who can explain repairs, HOA details, Johnson County title timing, closing costs, and your net without pushing you into a decision.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {overlandParkCashBuyerSignals.map((item) => (
        <article class="card h-full">
          <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
          <p class="mt-2 text-sm text-muted">{item.body}</p>
        </article>
      ))}
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/resources/johnson-county-cash-home-buyers/" class="btn btn-ghost text-base">Johnson County cash buyer guide</a>
      <a href="/resources/cash-buyer-vs-real-estate-agent-kansas-city/" class="btn btn-outline text-base">Cash buyer vs agent</a>
    </div>
  </section>

  <section class="section">
    <div class="card space-y-4">
      <h2 class="text-2xl font-semibold text-primary">Common Overland Park seller goals</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {commonSellerGoals.map((goal) => (
          <div class="rounded-md border border-border bg-soft/60 p-3 text-sm text-primary">{goal}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Overland Park seller intent</p>
      <h2 class="text-3xl font-semibold text-primary">If you searched "cash home buyers in Overland Park," compare certainty, title timing, and net proceeds.</h2>
      <p class="text-muted">
        Overland Park sellers often have equity, but that does not mean they want months of repairs, showings, inspection asks, or HOA surprises. We put the direct-sale math in writing so you can compare it with the MLS path.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {overlandParkIntentBlocks.map((item) => (
        <article class="card bg-white h-full">
          <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </section>
  <SellerSituationLinks
    city="Overland Park, KS"
    countyGuide={{ label: "Johnson County behind-on-payments guide", href: "/resources/johnson-county-behind-on-payments/" }}
  />

  <AreaPropertyProof city="Overland Park, KS" county="Johnson County" />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Balanced offers, not pressure</h2>
      <p class="text-muted">
        Expect a calm phone call, respect for your schedule, and written estimates that spell out closing costs, payoff amounts, and any post-closing arrangements. Whether you need to <a href="/solutions/sell-house-fast/" class="text-secondary underline">sell your Overland Park house fast</a>, handle an <a href="/solutions/inherited-house/" class="text-secondary underline">inherited property</a>, or deal with a <a href="/solutions/needs-repairs/" class="text-secondary underline">house needing major repairs</a>, you will never be rushed to sign paperwork.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Focused on Johnson County logistics</h2>
      <p class="text-muted">
        From county inspections to HOA transfer certificates, Overland Park sales have specific steps. We coordinate those details, provide checklists, and keep everyone updated so you are not surprised during escrow. If you are also comparing nearby sellers and smaller Johnson County cities, see our pages for <a href="/areas/leawood-ks/" class="text-secondary underline">Leawood</a>, <a href="/areas/mission-ks/" class="text-secondary underline">Mission</a>, <a href="/areas/fairway-ks/" class="text-secondary underline">Fairway</a>, and <a href="/areas/westwood-ks/" class="text-secondary underline">Westwood</a>.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">Common situations we help with</h2>
      <ul class="mt-4 space-y-3 text-sm text-primary">
        {situations.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="grid gap-6 md:grid-cols-3">
      {neighborhoods.map((spot) => (
        <div class="card bg-white/90">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Neighborhood focus</p>
          <h3 class="text-xl font-semibold text-primary">{spot.title}</h3>
          <p class="mt-2 text-sm text-muted">{spot.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold text-primary">How a sale works in Overland Park</h2>
      <p class="text-muted">
        You decide whether we move quickly or take time to coordinate with tenants, families, or lenders. Our process is transparent: one point of contact, written updates, and a closing team that understands Johnson County requirements.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class="card">
          <p class="text-sm font-semibold uppercase tracking-wide text-secondary">Step {index + 1}</p>
          <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section space-y-4">
    <h2 class="text-2xl font-semibold text-primary">Overland Park FAQ</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Common Overland Park situations</h2>
      <p class="text-muted">
        Many Overland Park homeowners we work with are managing <a href="/solutions/relocating/" class="text-secondary underline">job relocations</a>, <a href="/solutions/inherited-house/" class="text-secondary underline">inherited estates</a>, or <a href="/solutions/vacant-house/" class="text-secondary underline">vacant properties</a> with ongoing carrying costs. We also help with <a href="/solutions/probate-house/" class="text-secondary underline">probate sales</a> requiring court coordination.
      </p>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">Explore nearby areas</h2>
      <p class="text-muted">
        Also buying in <a href="/areas/olathe-ks/" class="text-secondary underline">Olathe</a>, <a href="/areas/lenexa-ks/" class="text-secondary underline">Lenexa</a>, <a href="/areas/shawnee-ks/" class="text-secondary underline">Shawnee</a>, and throughout Johnson County. Visit our <a href="/areas/" class="text-secondary underline">areas page</a> for complete coverage.
      </p>
      <p class="text-muted">
        For a broader local checklist, read the <a href="/resources/johnson-county-cash-home-buyers/" class="text-secondary underline">Johnson County cash home buyers guide</a>.
      </p>
      <p class="text-muted">
        If late payments, HOA balances, or lender deadlines are part of the decision, start with the <a href="/resources/johnson-county-behind-on-payments/" class="text-secondary underline">Johnson County behind-on-payments guide</a>.
      </p>
    </article>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/solutions/" class="btn btn-outline text-base">See all solutions</a>
  </section>
</Layout>
