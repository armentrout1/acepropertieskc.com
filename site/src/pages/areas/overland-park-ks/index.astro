---
import Layout from "../../../layouts/Layout.astro";
import CitySellerExperience from "../../../components/CitySellerExperience.astro";
import GoogleBusinessTrustLink from "../../../components/GoogleBusinessTrustLink.astro";
import OfferForm from "../../../components/OfferForm.astro";
import SellerSituationLinks from "../../../components/SellerSituationLinks.astro";
import {
  buildBreadcrumbList,
  webSiteJsonLd,
  localBusinessJsonLd,
  faqJsonLd,
} from "../../../lib/seo";

const neighborhoodPatterns = [
  {
    title: "Northern Overland Park and older Johnson County homes",
    body: "Homes near downtown Overland Park, Milburn, Nall, Antioch, and the I-35 corridor can have strong location value while still needing updates, foundation work, old-system repairs, accessibility changes, or clean-out help.",
  },
  {
    title: "Central Overland Park ranches, split-levels, and long-held homes",
    body: "Many central Overland Park sellers have equity but do not want to manage contractors, inspection repairs, public showings, or the pressure of getting every room photo-ready before selling.",
  },
  {
    title: "South Overland Park and Blue Valley timing",
    body: "Larger homes farther south often involve relocation, school-year timing, HOA documents, move-up purchases, estate decisions, or sellers comparing a clean direct offer against a higher but slower retail listing.",
  },
];

const situations = [
  "Inherited Overland Park houses where heirs need one clear written option",
  "Older Johnson County homes with roof, foundation, HVAC, window, sewer, deck, or cosmetic repair needs",
  "Relocation, job-change, or school-calendar timing where a known closing date matters",
  "Vacant houses where utilities, insurance, lawn care, security, or another mortgage payment are adding pressure",
  "Tenant-occupied rentals where access, lease timing, deposits, or turnover make listing harder",
  "HOA balances, title questions, payoff timing, divorce terms, trust documents, or estate authority that need calm review",
];

const overlandParkFastSaleProof = [
  {
    title: "Do I need to make repairs first?",
    body: "You can request an offer with the house as it is. Tell us about the roof, foundation, plumbing, or other work you know it needs; we account for the condition when reviewing the offer.",
  },
  {
    title: "Does the house have to be empty?",
    body: "Tell Aaron what you plan to take and what you would like to leave. Agree on the contents and clean-out arrangements in writing before closing.",
  },
  {
    title: "What will I actually receive?",
    body: "Compare the offer after your mortgage payoff and agreed selling costs. Ask for the price, closing costs, and possession arrangements in writing so you can compare your options.",
  },
];

const steps = [
  {
    title: "Tell us what is driving the sale",
    body: "Share the address, timeline, repair concerns, estate details, tenant situation, HOA questions, payoff pressure, or move date you are trying to solve around.",
  },
  {
    title: "Review the house as-is",
    body: "We can walk the property in person or by video, noting condition, contents, utilities, access, title questions, and the likely resale or rental path.",
  },
  {
    title: "Compare the written options",
    body: "You get a direct offer, closing timeline, repair assumptions, and a plain comparison against listing so you can decide without pressure.",
  },
];

const netSheetItems = [
  "Agent commissions, buyer concessions, and seller-paid closing costs on a traditional listing",
  "Foundation, roof, HVAC, sewer, flooring, paint, windows, deck, and clean-out costs",
  "HOA resale documents, payoff statements, taxes, utilities, title work, and possession timing",
  "Another month of mortgage, insurance, utilities, lawn care, and vacant-house risk",
  "Move-out needs, seller leaseback timing, and whether contents or unwanted items can stay",
];

const internalGuides = [
  {
    label: "Johnson County cash home buyers guide",
    href: "/resources/johnson-county-cash-home-buyers/",
    body: "County-wide context for Overland Park, Olathe, Shawnee, Lenexa, Leawood, and nearby Johnson County sellers.",
  },
  {
    label: "As-is sale net sheet template",
    href: "/resources/as-is-sale-net-sheet-template/",
    body: "A simple way to compare an Overland Park cash offer against listing costs, repairs, concessions, and holding time.",
  },
  {
    label: "Overland Park and Olathe probate guide",
    href: "/resources/selling-house-in-probate-overland-park-olathe/",
    body: "Useful when Overland Park heirs need to compare clean-out, repairs, title authority, and a direct written offer.",
  },
  {
    label: "Major repairs vs selling as-is",
    href: "/resources/major-repairs-vs-selling-as-is-kansas-city/",
    body: "Compare the cost and delay of repairs before choosing whether to list or sell the house as-is.",
  },
];

const faqs = [
  {
    question: "What should I have ready before I contact you?",
    answer:
      "Start with the property address and a phone number or email. If you know the repairs needed, whether anyone lives there, and your preferred move date, those details help. You can gather other documents as the conversation progresses.",
  },
  {
    question: "Can I start if I live outside Overland Park?",
    answer:
      "Yes. Tell Aaron where the house is and who can provide access. We can discuss a property review and coordinate next steps around your location and availability.",
  },
  {
    question: "Can I sell my Overland Park house as-is?",
    answer:
      "Yes. ACE Properties KC reviews Overland Park houses as-is, including homes with foundation issues, roof concerns, outdated systems, HOA items, contents left behind, tenant access, or repairs the owner does not want to manage before selling.",
  },
  {
    question: "How fast can an Overland Park cash offer close?",
    answer:
      "A cash sale can often close quickly once Johnson County title work, payoff statements, HOA items, and seller authority are clear. We explain the realistic timeline before you sign anything.",
  },
  {
    question: "Should I repair before listing in Overland Park?",
    answer:
      "Sometimes, yes. If the house is updated, easy to show, and repairs are manageable, listing may produce a higher price. If repairs, clean-out, privacy, timing, tenants, or carrying costs are the problem, a direct as-is offer may be worth comparing first.",
  },
  {
    question: "Do you buy inherited houses in Overland Park?",
    answer:
      "Yes. We can review inherited Overland Park houses where heirs need a written offer, clean-out help, repair assumptions, and a closing plan that works around estate, trust, or family paperwork.",
  },
  {
    question: "Do you buy Overland Park rentals or tenant-occupied houses?",
    answer:
      "Yes. We can review tenant-occupied rentals, vacant rentals, and small investment properties. Lease details, deposits, access, utilities, and closing possession are discussed before an offer is finalized.",
  },
  {
    question: "How do Overland Park cash home buyers handle closing costs?",
    answer:
      "The written offer explains what ACE pays, what normal seller-side items may still apply, and how the net compares with listing costs such as commissions, repairs, concessions, HOA items, and another month of carrying the house.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  faqJsonLd(faqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Areas", item: "/areas/" },
    { name: "Overland Park KS", item: "/areas/overland-park-ks/" },
  ]),
];
---

<Layout
  title="Sell Your Overland Park House As-Is | ACE Properties KC"
  description="Sell your Overland Park, KS house as-is. Get a local cash offer before repairs, clean-out, or showings. Talk with Aaron and compare your options."
  canonicalPath="/areas/overland-park-ks/"
  jsonLd={jsonLd}
>
  <section class="section grid gap-8 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div class="space-y-4">
      <p class="badge">Overland Park, Kansas · Local cash buyer</p>
      <h1 class="text-3xl font-semibold text-primary sm:text-4xl">
        Sell Your Overland Park House As-Is
      </h1>
      <p class="text-lg leading-8 text-muted">
        Get a written cash offer before paying for repairs, clearing out the
        house, or scheduling showings. Compare what you would keep from a direct
        sale with the costs and work of listing your Overland Park home.
      </p>
      <p class="leading-7 text-muted">
        Talk directly with Aaron about your move, inherited property, rental, or
        unfinished repairs. You can review the numbers and ask questions before
        deciding.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#overland-park-ks-offer-form" class="btn btn-primary text-base"
          >Get my as-is offer</a
        >
        <a
          href="tel:+18167287548"
          class="btn btn-ghost text-base"
          data-phone-link="overland-park-ks_hero">Call 816-728-7548</a
        >
        <a
          href="sms:+18167287548"
          class="btn btn-outline text-base"
          data-sms-link="overland-park-ks_hero">Text Aaron</a
        >
      </div>
      <GoogleBusinessTrustLink class="max-w-xl" />
    </div>
    <OfferForm
      compact
      addressFirst
      formId="overland-park-ks-offer-form"
      heading="Get an as-is offer in Overland Park"
      subheading="Start with the address. Add your phone or email on the next step."
      buttonLabel="See my as-is options"
      defaultSituation="as-is cash"
      pageContext="overland-park-ks"
    />
  </section>
  <nav
    aria-label="On this page"
    class="flex flex-wrap gap-x-6 gap-y-3 rounded-2xl border border-border bg-white p-4 text-sm font-semibold text-secondary"
  >
    <a href="#as-is-questions" class="underline">Repairs and clean-out</a>
    <a href="#seller-experience" class="underline">Seller experience</a>
    <a href="#sale-options" class="underline">Cash offer vs. listing</a>
    <a href="#local-details" class="underline">Overland Park details</a>
    <a href="#seller-faq" class="underline">Questions</a>
  </nav>

  <section
    id="as-is-questions"
    class="section section-alt scroll-mt-32 space-y-5"
  >
    <div class="max-w-3xl space-y-3">
      <p class="badge">Before you spend money on the house</p>
      <h2 class="text-3xl font-semibold text-primary">
        What selling as-is means for your Overland Park house
      </h2>
      <p class="text-muted">
        Start with the details you already know. You do not need contractor bids
        or a finished clean-out to begin the conversation.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        overlandParkFastSaleProof.map((item) => (
          <article class="card bg-white">
            <>
              <h3 class="text-lg font-semibold text-primary">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.body}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <CitySellerExperience />

  <section
    id="local-details"
    class="section section-alt scroll-mt-32 space-y-5"
  >
    <div class="max-w-3xl space-y-3">
      <p class="badge">What makes Overland Park different</p>
      <h2 class="text-3xl font-semibold text-primary">
        Overland Park has high-demand locations, older homes, HOA details, and
        seller timelines that do not always fit the MLS path.
      </h2>
      <p class="text-muted">
        A northern Overland Park ranch, a central OP split-level, and a South OP
        family home can each need a different sale plan. We look at condition,
        equity, title, HOA items, payoff, seller timeline, and what kind of
        buyer the house would attract if listed.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        neighborhoodPatterns.map((spot) => (
          <article
            class="card bg-white/90"
            aria-label={`Overland Park property pattern: ${spot.title}`}
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
              Local pattern
            </p>
            <h3 class="mt-2 text-xl font-semibold text-primary">
              {spot.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-muted">{spot.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="sale-options" class="section section-alt scroll-mt-32 space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Compare your options</p>
      <h2 class="text-3xl font-semibold text-primary">
        An as-is cash offer or an Overland Park listing?
      </h2>
      <p class="text-muted">
        Put the expected costs and work beside each price. If the house is ready
        to show and your schedule is flexible, a listing is worth comparing with
        the direct offer.
      </p>
    </div>
    <div class="overflow-x-auto rounded-2xl border border-border bg-white">
      <table class="w-full text-left text-sm">
        <caption class="sr-only"
          >Questions to compare a direct cash sale with listing your Overland
          Park house</caption
        >
        <thead class="bg-primary text-white"
          ><tr
            ><th scope="col" class="p-4">Compare</th><th scope="col" class="p-4"
              >ACE cash offer</th
            ><th scope="col" class="p-4">Listing</th></tr
          ></thead
        >
        <tbody class="divide-y divide-border">
          <tr
            ><th scope="row" class="p-4 align-top">Repairs and clean-out</th><td
              class="p-4 align-top"
              >Agree on the condition and belongings included in the sale.</td
            ><td class="p-4 align-top"
              >Decide which repairs, preparation, and clean-out you would pay
              for.</td
            ></tr
          >
          <tr
            ><th scope="row" class="p-4 align-top">Price and costs</th><td
              class="p-4 align-top"
              >Review the written offer, payoff, and any seller costs.</td
            ><td class="p-4 align-top"
              >Estimate the accepted price, agent fees, concessions, and
              preparation costs.</td
            ></tr
          >
          <tr
            ><th scope="row" class="p-4 align-top">Access and showings</th><td
              class="p-4 align-top"
              >Arrange access for ACE's property review.</td
            ><td class="p-4 align-top"
              >Plan for listing photos, buyer showings, and inspections.</td
            ></tr
          >
          <tr
            ><th scope="row" class="p-4 align-top">Closing and move-out</th><td
              class="p-4 align-top"
              >Agree on dates after reviewing title, payoff, and possession
              needs.</td
            ><td class="p-4 align-top"
              >Compare the buyer's financing, contingencies, and proposed dates.</td
            ></tr
          >
        </tbody>
      </table>
    </div>
    <p class="text-muted">
      Use the <a
        href="/resources/as-is-sale-net-sheet-template/"
        class="font-semibold text-secondary underline">sale net sheet</a
      > to compare your own numbers, then <a
        href="#overland-park-ks-offer-form"
        class="font-semibold text-secondary underline"
        >request an offer for your address</a
      >.
    </p>
  </section>

  <SellerSituationLinks
    city="Overland Park, KS"
    countyGuide={{
      label: "Johnson County behind-on-payments guide",
      href: "/resources/johnson-county-behind-on-payments/",
    }}
  />

  <section class="section grid gap-8 md:grid-cols-2">
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">
        What we review before making an Overland Park offer
      </h2>
      <p class="text-muted">
        A real offer should not be a vague number. We look at condition, likely
        resale path, title items, HOA or payoff details, the seller timeline,
        and what costs stay with us after closing.
      </p>
      <ul class="space-y-3 text-sm text-primary">
        {
          netSheetItems.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-2 w-2 rounded-full bg-secondary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>
    <article class="card space-y-3">
      <h2 class="text-2xl font-semibold text-primary">
        Why Overland Park sellers reach out
      </h2>
      <p class="text-muted">
        The house may be valuable, but the next step can still feel heavy.
        Repairs, family schedules, job moves, estate decisions, tenant
        coordination, HOA items, and another month of holding costs can make a
        clean written offer worth comparing.
      </p>
      <p class="text-muted">
        We keep the process direct: no pressure, no public listing requirement,
        no repair demand before the walkthrough, and no surprise expectation
        that the house must be empty before we review it.
      </p>
    </article>
  </section>

  <section class="section">
    <div class="card">
      <h2 class="text-2xl font-semibold text-primary">
        Common situations we solve in Overland Park
      </h2>
      <ul class="mt-4 grid gap-3 text-sm text-primary md:grid-cols-2">
        {
          situations.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-secondary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section space-y-6">
    <div class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
        Process
      </p>
      <h2 class="text-2xl font-semibold text-primary">
        How it works in Overland Park
      </h2>
      <p class="text-muted">
        From first conversation to closing, the goal is clarity. We document
        property condition, explain the offer assumptions, and help you
        understand whether a fast as-is sale or a traditional listing is the
        smarter next move.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <div class="card">
            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">
              Step {index + 1}
            </p>
            <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section-alt space-y-5">
    <div class="max-w-3xl space-y-3">
      <p class="badge">Helpful next reads</p>
      <h2 class="text-3xl font-semibold text-primary">
        Compare the Overland Park offer against the issue you are actually
        solving.
      </h2>
      <p class="text-muted">
        Most sellers are not just trying to sell a house. They are trying to
        avoid repair costs, protect credit, settle an estate, simplify a move,
        stop carrying a vacant property, or get clarity before the next
        deadline.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {
        internalGuides.map((guide) => (
          <a
            href={guide.href}
            class="card block bg-white transition hover:border-secondary/60"
          >
            <h3 class="text-lg font-semibold text-primary">{guide.label}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{guide.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section space-y-4">
    <h2
      id="seller-faq"
      class="scroll-mt-32 text-2xl font-semibold text-primary"
    >
      Overland Park seller questions
    </h2>
    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="card">
            <summary class="cursor-pointer text-base font-semibold text-primary">
              {faq.question}
            </summary>
            <p class="mt-2 text-sm text-muted">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section flex flex-wrap gap-4">
    <a href="#overland-park-ks-offer-form" class="btn btn-primary text-base"
      >Start the Overland Park offer form</a
    >
    <a href="/contact/" class="btn btn-ghost text-base">Talk with us</a>
    <a href="/areas/" class="btn btn-outline text-base">See all areas</a>
  </section>
</Layout>
