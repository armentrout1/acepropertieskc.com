---
import Layout from "../../layouts/Layout.astro";
import OfferConfidencePanel from "../../components/OfferConfidencePanel.astro";
import OfferForm from "../../components/OfferForm.astro";
import { SITE } from "../../lib/siteConfig";
import { buildBreadcrumbList, buildFaqPageJsonLd, localBusinessJsonLd, webSiteJsonLd } from "../../lib/seo";

const contactFaqs = [
  {
    question: "Can I ask questions before sharing everything about the house?",
    answer:
      "Yes. You can start with the basics, ask how the process works, and decide what details you are comfortable sharing after the first conversation.",
  },
  {
    question: "Is calling better than the form?",
    answer:
      "Either works. Call or text when timing is urgent, and use the form when you want to send the property address, situation, and preferred follow-up all at once.",
  },
  {
    question: "Will you pressure me to sign right away?",
    answer:
      "No. We explain the options, timeline, and offer terms so you can compare them calmly. A direct sale should only move forward when it fits your situation.",
  },
];

const jsonLd = [
  webSiteJsonLd(),
  localBusinessJsonLd(),
  buildFaqPageJsonLd(contactFaqs),
  buildBreadcrumbList([
    { name: "Home", item: "/" },
    { name: "Contact", item: "/contact/" },
  ]),
];
---

<Layout
  title="Contact ACE Properties KC"
  description="Talk with the ACE Properties KC team about selling your Kansas City house as-is for cash or payment takeover options."
  canonicalPath="/contact/"
  jsonLd={jsonLd}
>
  <section class="full-bleed bg-primary text-white">
    <div class="container-shell py-14 md:py-20">
      <div class="max-w-5xl space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="v3-pill">Talk with a real person</span>
          <span class="v3-pill">Call, text, or email</span>
          <span class="v3-pill">Buying direct since {SITE.buyerSince}</span>
        </div>
        <div class="space-y-4">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-accent">Contact ACE Properties KC</p>
          <h1 class="text-4xl font-black leading-tight text-white md:text-6xl">Ask questions before you decide</h1>
          <p class="max-w-3xl text-lg leading-8 text-white/82">
            Share your goals, timeline, or concerns. We can walk through cash sale, payoff-at-closing, and payment-takeover questions without pushing you to sign before the path makes sense.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={`tel:${SITE.phoneTel}`} class="btn bg-white text-primary hover:bg-white/90" data-phone-link="contact_hero">
            Call {SITE.phoneDisplay}
          </a>
          <a href={`sms:${SITE.smsTel}`} class="btn border border-white/40 text-white hover:bg-white/10" data-sms-link="contact_hero">
            Text ACE
          </a>
          <a href={`mailto:${SITE.email}`} class="btn border border-white/40 text-white hover:bg-white/10" data-email-link="contact_hero">
            Email ACE
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-[2rem] bg-white p-6 shadow-sm md:p-8">
        <h2 class="text-2xl font-semibold text-primary">Reach us</h2>
        <div class="space-y-3 text-sm text-primary">
          <div class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <div>
              <p class="font-semibold">Call or text</p>
              <a href={`tel:${SITE.phoneTel}`} class="text-secondary hover:underline" data-phone-link="contact_page">{SITE.phoneDisplay}</a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <div>
              <p class="font-semibold">Email</p>
              <a href={`mailto:${SITE.email}`} class="text-secondary hover:underline" data-email-link="contact_page">{SITE.email}</a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 rounded-full bg-secondary"></span>
            <div>
              <p class="font-semibold">Service area</p>
              <p>Kansas City metro, including ZIP 64131.</p>
            </div>
          </div>
        </div>
        <p class="text-sm text-muted">We respond during standard business hours and check messages after-hours for urgent updates.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/get-offer/" class="btn btn-primary text-base">Start the offer form</a>
          <a href="/options/" class="btn btn-ghost text-base">Compare options</a>
          <a href={`tel:${SITE.phoneTel}`} class="btn btn-ghost text-base" data-phone-link="contact_page_cta">Call us now</a>
        </div>
      </div>
      <OfferForm
        heading="Request a call or walkthrough"
        subheading="Share the address and how you'd like us to follow up."
        formId="contact-offer-form"
        pageContext="contact page"
      />
    </div>
  </section>

  <OfferConfidencePanel
    heading="Ask first, then decide what makes sense"
    intro="Some sellers are ready for a written offer. Others need to talk through timing, payment pressure, family questions, or repairs first. Either path is fine."
  />

  <section class="section space-y-4">
    <h2 class="text-3xl font-semibold text-primary">Contact FAQ</h2>
    <div class="space-y-3">
      {contactFaqs.map((faq) => (
        <details class="card">
          <summary class="cursor-pointer text-base font-semibold text-primary">{faq.question}</summary>
          <p class="mt-2 text-sm text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
